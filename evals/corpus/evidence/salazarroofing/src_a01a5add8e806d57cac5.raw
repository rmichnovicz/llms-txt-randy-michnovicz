    margin-bottom: 0.5rem;
    font-weight: bold;
    letter-spacing: 3px;
    font-size: 1rem;
    line-height: 1.2;
  }
  
  .rich-text-block h3 em {
    font-size: 1rem;
    font-style: unset;
    line-height: 1.2;
  }
  
  .rich-text-block blockquote {
  	color: var(--firebrick, #c13b33);
    font-size: 1rem;
    line-height: 1.4;    
    border: none;
    padding: 0;
  }
  
