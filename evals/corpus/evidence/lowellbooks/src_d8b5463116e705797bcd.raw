<main>
    
<div class="container">
    <h1>Computer programming / software engineering</h1>

    
<div class="container-fluid">
    <div class="row">
        <!-- Filtro -->
        <div class="col-12 col-md-2 mb-3 mb-md-0 ps-0">
            <div class="card p-3">
                <h5 class="card-title">Filter</h5>
                <form method="GET" action="">
                    <!-- Preserve existing search query -->
                    
                    
                    <!-- Product Type Filter -->
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <div class="form-check">
                            <input type="checkbox" name="type" id="typeBook" value="book"
                                   
                                   class="form-check-input">
                            <label class="form-check-label" for="typeBook">Book</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" name="type" id="typeNonBook" value="non-book"
                                   
                            class="form-check-input">
                            <label class="form-check-label" for="typeNonBook">Non-Book</label>
                        </div>
                    </div>
                    
                    <!-- Stock Filter -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="stock_only" id="stockOnly"
                                   >
                            <label class="form-check-label" for="stockOnly">Only products in stock</label>
                        </div>
                    </div>
                    
                    <!-- NEW: Format Filter (for books) -->
                    <div class="mb-3 book-filter">
                        <label class="form-label">Format</label>
                        <div class="form-check">
                            <input type="checkbox" name="format" id="formatPaperback" value="paperback"
                                   
                                   class="form-check-input">
                            <label class="form-check-label" for="formatPaperback">Paperback</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" name="format" id="formatHardcover" value="hardcover"
                                   
                                   class="form-check-input">
                            <label class="form-check-label" for="formatHardcover">Hardcover</label>
