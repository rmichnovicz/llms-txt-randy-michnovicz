<script>
    // Toggle book-specific filters based on product type selection
    document.addEventListener('DOMContentLoaded', function() {
        const typeBookCheckbox = document.getElementById('typeBook');
        const typeNonBookCheckbox = document.getElementById('typeNonBook');
        const bookFilters = document.querySelectorAll('.book-filter');
        
        function updateBookFilters() {
            const showBookFilters = typeBookCheckbox.checked && !typeNonBookCheckbox.checked;
            bookFilters.forEach(filter => {
                filter.style.display = showBookFilters ? 'block' : 'none';
            });
        }
        
        typeBookCheckbox.addEventListener('change', updateBookFilters);
        typeNonBookCheckbox.addEventListener('change', updateBookFilters);
        
        // Initial state
        updateBookFilters();
    });
</script>


