<section class="uams-module no-padding side-by-side uams-side-by-side-block alignfull image-on-left image-background-center bg-gray" id="side-by-side-image-side-block_3be5780084f2dfb64a21d1b7647f5736" aria-label="Family Doctors Near You">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-md-6 image-container" aria-label="Smiling family of three, a father, mother, and young daughter, embracing and laughing together on a porch." role="img">

                                <style>
                    #side-by-side-image-side-block_3be5780084f2dfb64a21d1b7647f5736 .image-container {
