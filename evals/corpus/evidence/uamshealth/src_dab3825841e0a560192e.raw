<!-- UAMS Analytics: Click Event Listeners -->
<script>
(function() {
    'use strict';

    var DL = window.dataLayer = window.dataLayer || [];
    var debug = false;
    var pageType = 'homepage';

    function push(data) {
        DL.push(data);
        if (debug) console.log('[UAMS DL Click]', data);
    }

    // ── Helper: extract text content, trimmed ──
    function textOf(el, maxLen) {
        var t = (el.textContent || el.innerText || '').replace(/\s+/g, ' ').trim();
        if (maxLen && t.length > maxLen) t = t.substring(0, maxLen) + '...';
        return t;
    }

    // ── Helper: find closest ancestor with data attribute ──
    function closestData(el, attr) {
        while (el && el !== document.body) {
            if (el.getAttribute && el.getAttribute(attr)) return el.getAttribute(attr);
            el = el.parentElement;
        }
        return '';
    }

    // ── Helper: get NPI from page context if on provider page ──
    function getProviderNPI() {
        for (var i = 0; i < DL.length; i++) {
            if (DL[i].provider_npi) return DL[i].provider_npi;
        }
        return '';
    }

    function getProviderName() {
        for (var i = 0; i < DL.length; i++) {
            if (DL[i].provider_name) return DL[i].provider_name;
        }
        return '';
    }

    function getProviderSpecialty() {
        for (var i = 0; i < DL.length; i++) {
            if (DL[i].provider_specialty) return DL[i].provider_specialty;
        }
        return '';
    }

    function getLocationName() {
        for (var i = 0; i < DL.length; i++) {
            if (DL[i].location_name) return DL[i].location_name;
        }
        return '';
    }

    // ═══════════════════════════════════════════════════════════
    //  1. PHONE CALL CLICKS (tel: links)
    // ═══════════════════════════════════════════════════════════

    document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href^="tel:"]');
        if (!link) return;

        var phone = link.getAttribute('href').replace('tel:', '').trim();

        push({
            'event': 'phone_call_click',
            'phone_number': phone,
            'page_type': pageType,
            'location_name': getLocationName(),
            'provider_npi': getProviderNPI(),
            'provider_name': getProviderName(),
            'click_text': textOf(link, 100)
        });
    }, true);

    // ═══════════════════════════════════════════════════════════
    //  2. APPOINTMENT / SCHEDULING CLICKS
    // ═══════════════════════════════════════════════════════════

    // Match links containing appointment-related keywords
    var appointmentPatterns = [
        'make-an-appointment',
        'request-appointment',
        'schedule',
        'booking',
        'mychart'
    ];

    document.addEventListener('click', function(e) {
        var link = e.target.closest('a');
        if (!link) return;

        var href = (link.getAttribute('href') || '').toLowerCase();
        var text = textOf(link, 200).toLowerCase();

        // Check if it's an appointment-related link
        var isAppointment = false;
        var eventName = '';

        for (var i = 0; i < appointmentPatterns.length; i++) {
            if (href.indexOf(appointmentPatterns[i]) > -1 || text.indexOf(appointmentPatterns[i]) > -1) {
                isAppointment = true;
                break;
            }
        }

        // Also catch common button text
        if (!isAppointment) {
            var apptTexts = ['make an appointment', 'request an appointment', 'book appointment', 'schedule a visit', 'schedule an appointment'];
            for (var j = 0; j < apptTexts.length; j++) {
                if (text.indexOf(apptTexts[j]) > -1) {
                    isAppointment = true;
                    break;
                }
            }
        }

        if (!isAppointment) return;

        // Determine if it's MyChart/online scheduling vs general appointment
        if (href.indexOf('mychart') > -1 || href.indexOf('schedule') > -1) {
            eventName = 'online_scheduling_click';
        } else {
            eventName = 'appointment_click';
        }

        push({
            'event': eventName,
            'page_type': pageType,
            'provider_npi': getProviderNPI(),
            'provider_name': getProviderName(),
            'provider_specialty': getProviderSpecialty(),
            'location_name': getLocationName(),
            'click_text': textOf(link, 100),
            'destination_url': href
        });
    }, true);

    // ═══════════════════════════════════════════════════════════
    //  3. DIRECTION / MAP CLICKS
    // ═══════════════════════════════════════════════════════════

    document.addEventListener('click', function(e) {
        var link = e.target.closest('a');
        if (!link) return;

        var href = (link.getAttribute('href') || '').toLowerCase();
        var text = textOf(link, 200).toLowerCase();

        var isDirections = (
            href.indexOf('maps.google') > -1 ||
            href.indexOf('google.com/maps') > -1 ||
            href.indexOf('maps.apple') > -1 ||
            href.indexOf('waze.com') > -1 ||
            href.indexOf('goo.gl/maps') > -1 ||
            text.indexOf('get directions') > -1 ||
            text.indexOf('directions') > -1 && text.indexOf('map') > -1
        );

        if (!isDirections) return;

        push({
            'event': 'location_directions_click',
            'page_type': pageType,
            'location_name': getLocationName(),
            'click_text': textOf(link, 100)
        });
    }, true);

    // ═══════════════════════════════════════════════════════════
    //  4. PROVIDER LINK CLICKS (from condition/treatment pages)
    // ═══════════════════════════════════════════════════════════

    if (pageType === 'condition' || pageType === 'treatment') {
        document.addEventListener('click', function(e) {
            var link = e.target.closest('a[href*="/provider/"]');
            if (!link) return;

            var href = link.getAttribute('href') || '';
            // Extract provider slug from URL
            var match = href.match(/\/provider\/([^\/\?#]+)/);
            var providerSlug = match ? match[1] : '';

            var eventName = pageType === 'condition'
                ? 'condition_to_provider'
                : 'treatment_to_provider';

            var contentName = '';
            for (var i = 0; i < DL.length; i++) {
                if (DL[i].condition_name) { contentName = DL[i].condition_name; break; }
                if (DL[i].treatment_name) { contentName = DL[i].treatment_name; break; }
            }

            push({
                'event': eventName,
                'page_type': pageType,
                'content_name': contentName,
                'provider_slug': providerSlug,
                'click_text': textOf(link, 100)
            });
        }, true);
    }

    // ═══════════════════════════════════════════════════════════
    //  5. PDF DOWNLOADS
    // ═══════════════════════════════════════════════════════════

    document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href$=".pdf"], a[href*=".pdf?"]');
        if (!link) return;

        var href = link.getAttribute('href') || '';
        var fileName = href.split('/').pop().split('?')[0];

        push({
            'event': 'pdf_download',
            'page_type': pageType,
            'file_name': fileName,
            'file_url': href,
            'click_text': textOf(link, 100)
        });
    }, true);

    // ═══════════════════════════════════════════════════════════
    //  6. MEDICAL RECORDS LINK CLICKS
    // ═══════════════════════════════════════════════════════════

    document.addEventListener('click', function(e) {
        var link = e.target.closest('a');
        if (!link) return;

        var href = (link.getAttribute('href') || '').toLowerCase();
        var text = textOf(link, 200).toLowerCase();

        if (href.indexOf('medical-records') > -1 || text.indexOf('medical records') > -1) {
            push({
                'event': 'medical_records_click',
                'page_type': pageType,
                'click_text': textOf(link, 100)
            });
        }
    }, true);

    // ═══════════════════════════════════════════════════════════
    //  7. EXTERNAL LINK CLICKS (outbound)
    // ═══════════════════════════════════════════════════════════

    document.addEventListener('click', function(e) {
        var link = e.target.closest('a');
        if (!link) return;

        var href = link.getAttribute('href') || '';
        if (!href.match(/^https?:\/\//)) return;

        // Skip if same domain
        try {
            var linkHost = new URL(href).hostname;
            if (linkHost.indexOf('uamshealth.com') > -1 || linkHost.indexOf('uams.edu') > -1) return;
        } catch(ex) {
            return;
        }

        push({
            'event': 'outbound_link_click',
            'page_type': pageType,
            'outbound_url': href,
            'outbound_domain': linkHost,
            'click_text': textOf(link, 100)
        });
    }, true);

    // ═══════════════════════════════════════════════════════════
    //  8. FAQ ACCORDION INTERACTIONS
    // ═══════════════════════════════════════════════════════════

    // Match common accordion/toggle patterns
    document.addEventListener('click', function(e) {
        var toggle = e.target.closest('.accordion-header, .faq-question, [data-toggle="collapse"], .wp-block-heading + .wp-block-group, summary, [role="button"][aria-expanded]');
        if (!toggle) return;

        push({
            'event': 'faq_interaction',
            'page_type': pageType,
            'question_text': textOf(toggle, 150),
            'page_path': window.location.pathname
        });
    }, true);

    // ═══════════════════════════════════════════════════════════
    //  9. PROVIDER SEARCH FILTERS (FacetWP)
    // ═══════════════════════════════════════════════════════════

    if (pageType === 'provider_archive' || pageType === 'location_archive') {
        // FacetWP fires a custom event after filtering
        document.addEventListener('facetwp-loaded', function() {
            // Get active filters from FacetWP
            if (typeof FWP === 'undefined') return;

            var activeFilters = [];
            for (var facetName in FWP.facets) {
                if (FWP.facets.hasOwnProperty(facetName)) {
                    var vals = FWP.facets[facetName];
                    if (vals && vals.length > 0) {
                        activeFilters.push({
                            filter: facetName,
                            values: vals
                        });
                    }
                }
            }

            var eventType = '';

            var eventName = pageType === 'provider_archive'
                ? 'provider_search'
                : 'location_search';

            if (activeFilters.length === 0) return;

            push({
                'event': eventName,
                'page_type': pageType,
                'filter_count': activeFilters.length,
                // 'filters': Object.entries(FWP.facets),
                'filters_keys': activeFilters.map(filter => filter.filter),
                'filters_values': activeFilters.map(filter => filter.values),
                'results_count': FWP.settings.pager ? FWP.settings.pager.total_rows : 0
            });
        });
    }

})();
</script>
    
