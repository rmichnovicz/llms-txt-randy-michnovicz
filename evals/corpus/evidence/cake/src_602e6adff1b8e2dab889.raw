fy;\"\u003e\u0026nbsp;\u003c/p\u003e\u003ch3 style=\"margin-left:0px;text-align:justify;\"\u003e\u003cspan style=\"color:rgb(255,56,165);font-size:19px;\"\u003e\u003cstrong\u003eSản phẩm áp dụng\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\u003cp style=\"margin-left:0px;text-align:justify;\"\u003eTính năng Thanh toán bằng mã QR với Tổ chức Quốc tế (VietQRGlobal) thông qua ứng dụng CAKE BANK.\u003c/p\u003e\u003cp style=\"margin-left:0px;text-align:justify;\"\u003e\u0026nbsp;\u003c/p\u003e\u003ch3 style=\"margin-left:0px;text-align:justify;\"\u003e\u003cspan style=\"color:rgb(255,56,165);font-size:19px;\"\u003e\u003cstrong\u003eThể lệ chi tiết\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"color:hsl(0,0%,0%);\"\u003eTrong thời gian diễn ra Chương trình, Khách hàng thực hiện thành công giao dịch thanh toán bằng mã QR quốc tế thông qua Ứng dụng CAKE sẽ được nhận ưu đãi hoàn tiền, cụ thể như sau:\u003c/span\u003e\u003cbr\u003e\u003cspan style=\"color:hsl(0,0%,0%);\"\u003e-\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;Giá trị giao dịch tối thiểu: Từ  100K trở lên.\u0026nbsp;\u003c/span\u003e\u003cbr\u003e\u003cspan style=\"color:hsl(0,0%,0%);\"\u003e-\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;Mức ưu đãi: \u003c/span\u003e\u003cspan style=\"color:hsl(240,80%,41%);\"\u003e\u003cstrong\u003eHoàn 20%\u003c/strong\u003e\u003c/span\u003e\u003cspan style=\"color:hsl(0,0%,0%);\"\u003e  cho 2 giao dịch đầu tiên hợp lệ (hoàn tối đa 200K/khách hàng trong cả chương trình).\u003c/span\u003e\u003c/p\u003e\u003ch3 style=\"text-align:justify;\"\u003e\u0026nbsp;\u003c/h3\u003e\u003ch3 style=\"text-align:justify;\"\u003e\u003cspan style=\"color:rgb(255,56,165);font-size:19px;\"\u003e\u003cstrong\u003eHướng dẫn tham gia\u003c/strong\u003e\u003c/span\u003e\u003c/h3\u003e\u003cp\u003e\u003cimg src=\"https://storage.googleapis.com/cake-prd-website/homepage/Thiet_ke_chua_co_ten_d6ee67c710/Thiet_ke_chua_co_ten_d6ee67c710.png\" alt=\"Thiết kế chưa có tên.png\"\u003e\u003cbr\u003e\u0026nbsp;\u003c/p\u003e\u003cp style=\"text-align:justify;\"\u003e\u003cspan style=\"color:rgb(0,0,0);\"\u003eThể lệ chi tiết xem\u003c/span\u003e\u003ca href=\"https://storage.googleapis.com/cake-prd-website/homepage/202606_CAKE_The_le_Thanh_toan_QR_1_a2724ecdc2/202606_CAKE_The_le_Thanh_toan_QR_1_a2724ecdc2.pdf\"\u003e\u003cspan style=\"color:rgb(77,77,230);\"\u003e \u003cstrong\u003e\u003cu\u003eTẠI ĐÂY\u003c/u\u003e\u003c/strong\u003e\u003c/span\u003e.\u003c/a\u003e\u003c/p\u003e"])</script><script type="a663c25eb99e9a2d704fe35b-text/javascript">self.__next_f.push([1,"33:[\"$\",\"$L38\",\"3\",{\"resData\":{\"data\":{\"id\":1,\"__component\":\"home-v2.promotions\",\"title\":\"Ưu đãi nóng từ Cake!\",\"view_all_url\":\"/uu-dai\",\"promotions\":{\"data\":[{\"id\":878,\"attributes\":{\"day_post\":\"2026-09-22\",\"title\":\"Tháng 09 \u0026 10 - Bạn mới tiết kiệm, tặng thêm lãi suất +2.2%/năm\",\"day_expired\":\"2026-10-31\",\"type_promotion\":\"uu-dai-noi-bat\",\"service\":\"tiet-kiem\",\"promotion_box\":\"cake-uu-dai\",\"register_link\":null,\"desc\":null,\"slug\":\"thang-9-2026-ban-moi-tiet-kiem-tang-them-lai-suat-9-6\",\"createdAt\":\"2026-09-21T11:01:33.010Z\",\"updatedAt\":\"2026-09-21T11:02:35.314Z\",\"publishedAt\":\"2026-09-21T11:01:35.067Z\",\"service_name\":[\"tiet-kiem\"],\"locale\":\"en\",\"author\":\"Gato\",\"content\":[{\"id\":894,\"title\":null,\"content\":\"\u003cp\u003e\u003ca href=\\\"https://storage.googleapis.com/cake-prd-website/homepage/20260918_The_le_chuong_trinh_New_TD_10_2026_92d0fbad34/20260918_The_le_chuong_trinh_New_TD_10_2026_92d0fbad34.pdf\\\"\u003e\u003cimg src=\\\"https://storage.googleapis.com/cake-prd-website/homepage/the_le_new_TD_1_eeefa8b04b/the_le_new_TD_1_eeefa8b04b.jpg\\\" alt=\\\"thể lệ new TD (1).jpg\\\"\u003e\u003c/a\u003e\u003c/p\u003e\",\"is_nested_image_deeplink\":false}],\"thumbnail\":{\"data\":{\"id\":10909,\"attributes\":{\"name\":\"1200 1200 (14).png\",\"alternativ