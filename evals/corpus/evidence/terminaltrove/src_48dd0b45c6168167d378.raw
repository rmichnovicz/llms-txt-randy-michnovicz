</script><script>
	(function () {
		if (window.__ttSponsorTracker) return;
		window.__ttSponsorTracker = true;

		var HOVER_THRESHOLD_MS = 1000;
		var VIEW_RATIO = 0.5;
		var VIEW_DWELL_MS = 1000;

		var viewIds = new WeakMap();

		function slotViewId(ad) {
			var id = viewIds.get(ad);
			if (id) return id;
			try {
				id = crypto.randomUUID();
			} catch (e) {
				id = String(Date.now()) + "-" + Math.random().toString(36).slice(2, 10);
			}
			viewIds.set(ad, id);
			return id;
		}

		function post(name, props) {
			try {
				fetch("/assets", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ event: name, properties: props }),
					keepalive: true
				});
			} catch (e) {}
		}

		function fire(name, props) {
			post(name, props);
			try {
				if (typeof window.plausible === "function") {
					window.plausible(name, { props: props });
				}
			} catch (e) {}
		}

		function adFrom(node) {
			while (node && node !== document) {
				if (node.nodeType === 1 && node.hasAttribute && node.hasAttribute("data-sponsor-ad")) {
					return node;
				}
				node = node.parentNode;
			}
			return null;
		}

		function destinationFor(start, ad) {
			var node = start;
			while (node && node !== document) {
				if (node.tagName && node.tagName.toLowerCase() === "a" && node.href) return node.href;
				if (node === ad) break;
				node = node.parentNode;
			}
			var a = ad.querySelector ? ad.querySelector("a[href]") : null;
			return a ? a.href : "";
		}

		function variantProps(ad) {
			var v = ad.getAttribute("data-cta-variant");
			if (!v) return {};
			return { variant: v, "$feature/sponsor-slot-cta": v };
		}

		function withVariant(ad, props) {
			var extra = variantProps(ad);
			for (var k in extra) props[k] = extra[k];
			props.slot_view_id = slotViewId(ad);
			return props;
		}

		function onClick(e) {
			var ad = adFrom(e.target);
			if (!ad) return;
			fire("Sponsor Click", withVariant(ad, {
				sponsor: ad.getAttribute("data-sponsor") || "",
				placement: location.pathname,
				destination: destinationFor(e.target, ad),
				slot: ad.getAttribute("data-sponsor-slot") || ""
			}));
		}

		document.addEventListener("click", onClick, true);
		document.addEventListener("auxclick", onClick, true);

		var shown = new WeakSet();

		function fireImpression(ad) {
			if (shown.has(ad)) return;
			shown.add(ad);
			post("Sponsor Slot Shown", withVariant(ad, {
				sponsor: ad.getAttribute("data-sponsor") || "",
				placement: location.pathname,
				slot: ad.getAttribute("data-sponsor-slot") || ""
			}));
		}

		var allAds = document.querySelectorAll("[data-sponsor-ad]");

		if (typeof IntersectionObserver === "function") {
			var timers = new WeakMap();
			var observer = new IntersectionObserver(function (entries) {
				for (var j = 0; j < entries.length; j++) {
					var el = entries[j].target;
					if (entries[j].isIntersecting) {
						if (timers.has(el)) continue;
						timers.set(el, setTimeout(function (target) {
							return function () {
								timers.delete(target);
								fireImpression(target);
								observer.unobserve(target);
							};
						}(el), VIEW_DWELL_MS));
					} else {
						var t = timers.get(el);
						if (t !== undefined) {
							clearTimeout(t);
							timers.delete(el);
						}
					}
				}
			}, { threshold: VIEW_RATIO });
			for (var k = 0; k < allAds.length; k++) observer.observe(allAds[k]);
		} else {
			for (var m = 0; m < allAds.length; m++) fireImpression(allAds[m]);
		}

		var enteredAt = new WeakMap();

		document.addEventListener("mouseenter", function (e) {
			var ad = adFrom(e.target);
			if (!ad || enteredAt.has(ad)) return;
			enteredAt.set(ad, Date.now());
		}, true);

		document.addEventListener("mouseleave", function (e) {
			var ad = adFrom(e.target);
			if (!ad) return;
			if (e.relatedTarget && ad.contains(e.relatedTarget)) return;
			var start = enteredAt.get(ad);
			if (start === undefined) return;
			enteredAt.delete(ad);
			var duration = Date.now() - start;
			if (duration < HOVER_THRESHOLD_MS) return;
			fire("Sponsor Hover", withVariant(ad, {
				sponsor: ad.getAttribute("data-sponsor") || "",
				placement: location.pathname,
				hover_duration_ms: duration,
				slot: ad.getAttribute("data-sponsor-slot") || ""
			}));
		}, true);
	})();
