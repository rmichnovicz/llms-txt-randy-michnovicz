e-card-footer"> <div class="tfree-avatar"> <div class="sp-testimonial-client-image"><img width="227" height="235" src="https://healthcare.lk/wp-content/uploads/2025/10/Screenshot-2025-10-07-133544.png" class="tfree-client-image wp-post-image" alt="" /></div> </div> <div class="tfree-meta"> <h4 class="sp-testimonial-client-name">Dr. Lakshman Anna</h4> <div class="sp-testimonial-client-designation">General Practitioner, Dehiwala</div> </div></div></div> </div> <style>/* ===== LAYOUT (grid when not using slider) ===== */.sp-testimonial-grid,.sp-testimonial-wrapper,.sp-testimonial-section { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px;}/* ===== CARD ===== */.sp-testimonial-item { background: #fff; border-radius: 12px; box-shadow: 0 10px 20px rgba(0,0,0,.06);}.sp-testimonial-item .sp-testimonial-free { position: relative; padding: 28px;}/* Decorative opening quote */.sp-testimonial-item .sp-testimonial-free::before { content: "“"; position: absolute; top: 14px; left: 18px; font-size: 64px; line-height: 1; color: #E9ECF2; pointer-events: none; user-select: none;}/* ===== COPY (testimonial text) ===== */.sp-testimonial-item .sp-testimonial-content,.sp-testimonial-item .sp-testimonial-text,.sp-testimonial-item .tfree-client-testimonial,.sp-testimonial-item .sp-testimonial-free > p { color: #1F2937; /* neutral-800 */ font-size: 18px; line-height: 1.65; margin: 18px 0 0 0;}/* ===== HIDE bits you don't want (matches screenshot) ===== */.sp-testimonial-item .sp-testimonial-title,.sp-testimonial-item .sp-testimonial-rating { display: none !important;}/* ===== FOOTER: avatar + name + role ===== */.sp-testimonial-item .sp-testimonial-image,.sp-testimonial-item .tfree-client-image { display: inline-block; vertical-align: middle; margin: 20px 12px 0 0;}.sp-testimonial-item .sp-testimonial-image img,.sp-testimonial-item .tfree-client-image img,.sp-testimonial-item img.wp-post-image { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; displ