/* START JOB PAGE POST */
/* Light theme + wider layout for DOCPP job page  */
/* ——————————————————  */
/* Palette refresh (lighter backgrounds, darker text) */
.docpp-job{
  --bg:#f7f9fc;
  --panel:#ffffff;
  --text:#0b1220;
  --muted:#5b6b85;
  --brand:#3a66ff;
  --accent:#0aa36e;
  --border:#dbe4f3;
  --danger:#d92d20;
}

/* Base */
.docpp-job *{box-sizing:border-box}

/* Wider container + subtle light gradient */
.docpp-wrap{
  max-width:1380px;
/*   width:min(96vw,1280px);        /* allow a bit more width on large screens */ */
  margin:0 auto;
  padding:24px;
  color:var(--text);
  background:linear-gradient(180deg,#f7f9fc 0%, #f2f6ff 100%);
	 display:block;   
}

/* Light hero with soft spotlight */
.docpp-hero{
  background:
    radial-gradient(1200px 400px at 10% -20%, #e9f0ff 0%, transparent 60%),
    radial-gradient(1200px 400px at 90% -20%, #e8fff4 0%, transparent 60%),
    var(--panel);
  border:1px solid var(--border);
  border-radius:20px;
  padding:28px;
  margin-bottom:24px;
  box-shadow:0 8px 24px rgba(16,24,40,.06);
}
.docpp-hero h1{
  margin:0 0 8px;
  font-size:clamp(28px,4vw,40px);
  letter-spacing:.2px;
  color:var(--text);
}

/* Chips / badges on light */
.docpp-pill{
  display:inline-flex;gap:10px;padding:8px 12px;
  border:1px solid var(--border);
  border-radius:999px;font-size:14px;
  color:var(--muted);
  background:#ffffffcc;          /* was translucent dark */
  backdrop-filter:blur(6px);
}
.docpp-badge{
  font-size:12px;padding:4px 8px;
  border:1px solid var(--border);
  border-radius:999px;color:var(--muted);margin-left:10px;
  background:#fff;
}

/* Meta row */
.docpp-meta{
  display:flex;flex-wrap:wrap;gap:10px;margin:10px 0 0;
  color:var(--muted);font-size:14px;
}

/* CTAs */
.docpp-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:14px}
.docpp-btn{
  appearance:none;border:none;border-radius:12px;padding:12px 16px;cursor:pointer;font-weight:600;
  background:var(--brand);color:#fff;text-decoration:none;display:inline-flex;align-items:center;gap:8px;
  box-shadow:0 6px 20px rgba(58,102,255,.25);
}
.docpp-secondary{
  background:#fff;color:var(--text);border:1px solid var(--border);
  box-shadow:0 2px 8px rgba(16,24,40,.06);
}

/* Grid keeps same proportions */
.docpp-grid{display:grid;gap:18px}
@media(min-width:900px){.docpp-grid{grid-template-columns:1.2fr .8fr}}

/* Cards: white panels with light shadow */
.docpp-card{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:16px;padding:22px;
  box-shadow:0 6px 18px rgba(16,24,40,.06);
}
.docpp-card h2{margin:0 0 12px;font-size:22px;color:var(--text)}
.docpp-card h3{margin:18px 0 10px;font-size:18px;color:var(--muted)}
.docpp-card ul{padding-left:18px;margin:10px 0}
.docpp-card li{margin:6px 0}

/* Callout: soft tinted info box */
.docpp-callout{
  border:1px solid var(--border);
  background:#f4f8ff;
  border-radius:14px;padding:14px;margin:12px 0;color:var(--text);
}

/* Table on light */
.docpp-table{width:100%;border-collapse:collapse;font-size:15px;margin-top:8px;color:var(--text)}
.docpp-table th,.docpp-table td{border:1px solid var(--border);padding:10px;text-align:left}
.docpp-table th{background:#f0f5ff;color:#334155}

/* Small text + emphasis colors */
.docpp-small{font-size:13px;color:var(--muted)}
.docpp-salary-note{color:var(--accent);font-weight:600}
.docpp-warning{color:var(--danger);font-weight:600}

/* Footer note */
.docpp-footer{color:var(--muted);font-size:1
}
/* --- Center the job ad relative to the viewport, regardless of theme columns --- */

/* Make the outer wrapper span the full viewport width (full-bleed) */
#docpp-telemarketing-agent.docpp-job {
  margin-left: auto !important;
  margin-right: auto !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
  max-width: 100% !important;
}

#docpp-telemarketing-agent .docpp-wrap {
  max-width: 1280px;          /* your desired width */
  width: 100%;
  margin-left: auto !important;
  margin-right: auto !important;
	padding: 0px !important;
	background:transparent !important;
}
.postid-4411 .article-wrap {
    max-width: 100% !important;
    margin: 0 auto 50px;
    padding: 0 16px;
}

.footer-16 {
  background: #0a80dc !important;
	color: #ffffff;
}
.footer-16 .brand-section .logo .sitename, .footer-16 .brand-section .brand-description, .footer-16 .nav-column h6 , .footer-16 .nav-column .footer-nav a {
		color: #ffffff;
}
#respond {
	display: none;
}

/* Optional: if you notice a horizontal scrollbar on some themes */
@media (min-width: 900px){
  body { overflow-x: hidden; }
}

/* END JOB PAGE POST */
@media (max-width: 767px) {
	#header .branding .custom-logo {
		width: 84% !important;
	}
}
.rmp-container .rmp-menu-title .rmp-menu-title-image {
	padding: 0px !important;
	width: 240px !important;
	padding-bottom: 20px !important;
}

		</style>
