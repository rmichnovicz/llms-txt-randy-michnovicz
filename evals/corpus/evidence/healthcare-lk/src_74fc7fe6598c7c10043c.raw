                </div><!-- End Surgery Tab -->

                <div class="tab-pane fade" id="departments-tabs-dental" role="tabpanel" aria-labelledby="dental-tab">
                  <div class="row department-layout">
                    <div class="col-lg-4 order-lg-2">
                      <div class="department-image">
                        <img src="https://healthcare.lk/wp-content/uploads/2025/08/image3.png" alt="Dental Care Department" class="img-fluid">
                      </div>
                    </div>
                    <div class="col-lg-8 order-lg-1">
                      <div class="department-info">
                        <h2 class="department-title">Doctor (Level II) Features</h2>

                        <div class="row mt-4">
                          <div class="expertise-list">
							  
							<div class="expertise-item">
								<span class="feature-icon">💡</span>
								<span><strong>Artificial Intelligent (AI) Patient Overview</strong> – will analyze patient past medical history and come up with suggestions, recommendation and management plans.</span>
						 	 </div>

						  <div class="expertise-item">
							<span class="feature-icon">🔍</span>
							<span><strong>Smart Patient Search</strong> – Instantly find patients via barcode scan or name.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">🧾</span>
							<span><strong>Queue Management</strong> – Pick patients from the queue and start a new visit.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">📝</span>
							<span><strong>Visit Records</strong> – Enter or modify First Visit and This Visit details.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">💡</span>
							<span><strong>Doctor’s Hint List</strong> – Save common complaints & diagnoses as quick HINTs.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">📜</span>
							<span><strong>Medical History Access</strong> – View complete past medical history at any time.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">🩺</span>
							<span><strong>Certificates & Bills</strong> – Issue and print medical certificates or short bills.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">💊</span>
							<span><strong>Smart Prescriptions</strong> – Prescribe drugs and print under your own letterhead.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">💵</span>
							<span><strong>Direct Payments</strong> – Record patient-related payments instantly.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">📑</span>
							<span><strong>Detailed Billing</strong> – Generate itemised bills with prescribed drugs.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">🧪</span>
							<span><strong>Lab Results Integration</strong> – Add outside lab reports and compare past results.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">📄</span>
							<span><strong>Referral Letters</strong> – Print & issue referrals for outside consultations.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">📚</span>
							<span><strong>ICD-10 Reference</strong> – Access international coding for diagnoses.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">👨‍⚕️</span>
							<span><strong>Drug Management</strong> – Add new drug names and track stock levels.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">⚠️</span>
							<span><strong>Stock Alerts</strong> – View drugs below reorder level and those expiring soon.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">🗑️</span>
							<span><strong>Data Management</strong> – Remove unwanted complaints, diagnoses, or hints.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">🧪</span>
							<span><strong>Custom Lab Lists</strong> – Manage tailored lists of lab investigations.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">👨‍⚕️</span>
							<span><strong>Referral Consultant Lists</strong> – Maintain customised outside consultant directories.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">📊</span>
							<span><strong>Dashboards & Analytics</strong> – Real-time dashboards for key insights.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">🖨️</span>
							<span><strong>Comprehensive Reports</strong> – Print summary reports (A4) of all past visits, prescriptions, and treatments.</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">📋</span>
							<span><strong>Patient Insights</strong> – Generate filtered reports (e.g., patients by diagnosis within a set period).</span>
						  </div>

						  <div class="expertise-item">
							<span class="feature-icon">🔒</span>
							<span><strong>Patient Record Control</strong> – Option to delete records when required.</span>
						  </div>

						</div>

                        </div>
                      </div>
                    </div>
                  </div>
                </div><!-- End Dental Tab -->

