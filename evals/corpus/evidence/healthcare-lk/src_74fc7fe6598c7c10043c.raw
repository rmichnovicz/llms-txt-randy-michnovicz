			<div id="sp-testimonial-free-wrapper-113" class="sp-testimonial-free-wrapper"><div id="sp-testimonial-free-113" class="sp-testimonial-free-section tfree-style-theme-one" dir="ltr" data-preloader="" data-swiper='{&quot;dots&quot;: 1,&quot;pagination_type&quot;: &quot;dots&quot;, &quot;spaceBetween&quot;: 20, &quot;adaptiveHeight&quot;: false, &quot;pauseOnHover&quot;: true, &quot;slidesToShow&quot;: 3, &quot;speed&quot;: 600, &quot;arrows&quot;: &quot;1&quot;, &quot;autoplay&quot;: true, &quot;autoplaySpeed&quot;: 3000, &quot;swipe&quot;: true, &quot;swipeToSlide&quot;: false, &quot;draggable&quot;: true, &quot;freeMode&quot;: false, &quot;rtl&quot;: false, &quot;infinite&quot;: true,&quot;slidesPerView&quot;: {&quot;lg_desktop&quot;:3 , &quot;desktop&quot;: 3, &quot;laptop&quot;:2 , &quot;tablet&quot;: 1, &quot;mobile&quot;: 1},&quot;navigation_mobile&quot;: true, &quot;pagination_mobile&quot;:true, &quot;autoplay_mobile&quot;:true}' ><div class="swiper-wrapper"><style>/* ===== LAYOUT (grid when not using slider) ===== */.sp-testimonial-grid,.sp-testimonial-wrapper,.sp-testimonial-section { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px;}/* ===== CARD ===== */.sp-testimonial-item { background: #fff; border-radius: 12px; box-shadow: 0 10px 20px rgba(0,0,0,.06);}.sp-testimonial-item .sp-testimonial-free { position: relative; padding: 28px;}/* Decorative opening quote */.sp-testimonial-item .sp-testimonial-free::before { content: "“"; position: absolute; top: 14px; left: 18px; font-size: 64px; line-height: 1; color: #E9ECF2; pointer-events: none; user-select: none;}/* ===== COPY (testimonial text) ===== */.sp-testimonial-item .sp-testimonial-content,.sp-testimonial-item .sp-testimonial-text,.sp-testimonial-item .tfree-client-testimonial,.sp-testimonial-item .sp-testimonial-free > p { color: #1F2937; /* neutral-800 */ font-size: 18px; line-height: 1.65; margin: 18px 0 0 0;}/* ===== HIDE bits you don't want (matches screenshot) ===== */.sp-testimonial-item .sp-testimonial-title,.sp-testimonial-item .sp-testimonial-rating { display: none !important;}/* ===== FOOTER: avatar + name + role ===== */.sp-testimonial-item .sp-testimonial-image,.sp-testimonial-item .tfree-client-image { display: inline-block; vertical-align: middle; margin: 20px 12px 0 0;}.sp-testimonial-item .sp-testimonial-image img,.sp-testimonial-item .tfree-client-image img,.sp-testimonial-item img.wp-post-image { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; display: block;}/* Name + role next to avatar */.sp-testimonial-item .sp-testimonial-client-name,.sp-testimonial-item .sp-testimonial-name,.sp-testimonial-item .tfree-client-name { display: inline-block; vertical-align: middle; margin: 20px 0 0 0; font-weight: 600; color: #111827; /* neutral-900 */}.sp-testimonial-item .sp-testimonial-designation,.sp-testimonial-item .sp-testimonial-client-designation,.sp-testimonial-item .tfree-client-designation { display: block; color: #6B7280; /* neutral-500 */ font-size: 14px; margin-top: 2px;}/* ===== RESPONSIVE ===== */@media (max-width: 1024px) { .sp-testimonial-grid, .sp-testimonial-wrapper, .sp-testimonial-section { grid-template-columns: repeat(2, minmax(0, 1fr)); }}@media (max-width: 640px) { .sp-testimonial-grid, .sp-testimonial-wrapper, .sp-testimonial-section { grid-template-columns: 1fr; }}/* ===== Testimonial footer (bottom area) ===== */.tfree-card-footer{ margin-top: 22px; padding-top: 18px; border-top: 1px solid rgba(17,24,39,.08); /* subtle divider */ display: flex; align-items: center; gap: 14px;}/* Avatar container from plugin or fallback */.tfree-avatar .sp-testimonial-client-image,.tfree-avatar .tfree-client-image{ display: block;}/* Normalize avatar image */.tfree-avatar img{ width: 56px !important; height: 56px !important; border-radius: 50%; object-fit: cover; display: block; box-shadow: 0 2px 8px rgba(0,0,0,.08);}/* Text stack (name, role, rating) */.tfree-meta{ display: grid; grid-auto-rows: min-conte