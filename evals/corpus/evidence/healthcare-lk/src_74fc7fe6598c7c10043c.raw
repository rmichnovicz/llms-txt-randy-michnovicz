                <div class="tab-pane fade" id="departments-tabs-surgery" role="tabpanel" aria-labelledby="surgery-tab">
                  <div class="row department-layout">
                    <div class="col-lg-4 order-lg-2">
                      <div class="department-image">
                        <img src="https://healthcare.lk/wp-content/uploads/2025/08/image1.png" alt="Surgery Department" class="img-fluid">
                      </div>
                    </div>
                    <div class="col-lg-8 order-lg-1">
                      <div class="department-info">
                        <h2 class="department-title">Patient Management Features</h2>
						  
						  <div class="row mt-4">
							<div class="expertise-list">
							  <div class="expertise-item">
								<span class="feature-icon">🆕</span>
								<span><strong>New Patient Registration</strong> – Quick and simple onboarding process.</span>
							  </div>

							  <div class="expertise-item">
								<span class="feature-icon">✏️</span>
								<span><strong>Modify Patient Data</strong> – Update records anytime with ease.</span>
							  </div>

							  <div class="expertise-item">
								<span class="feature-icon">🏷️</span>
								<span><strong>Barcode-Enabled Patient IDs</strong> – Instant ID generation with barcode support.</span>
							  </div>

							  <div class="expertise-item">
								<span class="feature-icon">📅</span>
								<span><strong>OPD Appointment Booking</strong> – Hassle-free scheduling in just a few clicks.</span>
							  </div>

							  <div class="expertise-item">
								<span class="feature-icon">👨‍⚕️</span>
								<span><strong>Multi-Doctor Reservations</strong> – Patients can book with multiple doctors at once.</span>
							  </div>

							  <div class="expertise-item">
								<span class="feature-icon">🧪</span>
								<span><strong>Pre-Consultation Data Entry</strong> – Add investigation results before the doctor meets the patient.</span>
							  </div>

							  <div class="expertise-item">
								<span class="feature-icon">🎟️</span>
								<span><strong>Token Printing & Issuing</strong> – Generate queue tokens for smooth patient flow.</span>
