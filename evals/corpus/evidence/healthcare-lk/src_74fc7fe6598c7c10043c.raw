<style>
.expertise-list {
  display: grid;
  gap: 12px; /* spacing between items */
  margin: 0;
  padding: 0;
}

.expertise-item {
  display: flex;
  align-items: center;
  font-size: 16px;
  color: #333;
  line-height: 1.6;
}

.expertise-item .feature-icon {
  margin-right: 10px;
  font-size: 18px;
  line-height: 1;
  color: #0d6efd; /* blue highlight like your screenshot */
  flex-shrink: 0;
}
.departments-tabs .department-image img
 {
    height: 100%;
    object-fit: contain !important;
    transition: transform 0.3s ease;
}
.section-title h2 {
    font-weight: 700 !important;
}
.expertise-subitem {
    padding-left: 50px;
}
.departments-tabs .department-title {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 0rem;
}
.departments-tabs .department-info {
    justify-content: flex-start;
}
.home-about .about-content p {
    margin-bottom: 0.5rem;
}
	

.pricing { text-align:center; padding:50px 20px; font-family:system-ui, Arial, sans-serif; }
.toggle-billing { display:inline-flex; gap:8px; padding:6px; border:1px solid #e5e7eb; border-radius:999px; background:#fff; margin-bottom:30px; }
.billing-tab { border:0; background:transparent; padding:10px 18px; border-radius:999px; cursor:pointer; font-weight:600; }
.billing-tab.active { background:#0b5cff; color:#fff; }
.pricing-container { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:22px; max-width:1120px; margin:0 auto; }
.pricing-card { border:1px solid #e5e7eb; border-radius:14px; padding:24px; background:#fff; box-shadow:0 6px 20px rgba(0,0,0,.04); position:relative; transition:transform .25s ease; }
.pricing-card:hover { transform:translateY(-4px); }
.popular { border:2px solid #0b5cff; }
.badge { position:absolute; top:-12px; right:16px; background:#0b5cff; color:#fff; font-size:12px; padding:6px 10px; border-radius:999px; }
.price-wrap { display:flex; align-items:baseline; justify-content:center; gap:4px; margin:8px 0 10px; }
.currency { font-size:28px; font-weight:700; }
.price { font-size:44px; font-weight:800; letter-spacing:-.02em; }
.price-unit { font-size:14px; color:#6b7280; margin-left:6px; }
.pricing-card p { color:#6b7280; margin-bottom:18px; }
.btn { display:inline-block; background:#f6f7f9; border:1px solid #e5e7eb; padding:10px 18px; border-radius:10px; margin-bottom:16px; cursor:pointer; font-weight:600; }
.btn.primary { background:#0b5cff; color:#fff; border-color:#0b5cff; }
