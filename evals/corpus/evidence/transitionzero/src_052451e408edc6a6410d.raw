ript><script>self.__next_f.push([1,"#navbar {\n  border-bottom: 0.5px solid #1f283d;\n}\n\n#sidebar {\n  border-right: 0.5px solid #1f283d;\n}\n\nbody {\n  letter-spacing: -.42px;\n}\n\n/* ------------------------------------------------------------------ */\n/* Sidebar section headers (Platform, Methodology, Country Models...)  */\n/* Larger, bold, accent-coloured, with a separator line above each.    */\n/* Real markup: \u003ch3 class=\"sidebar-title\"\u003e\u003cspan\u003ePlatform\u003c/span\u003e\u003c/h3\u003e.  */\n/* The span inherits font/size via Tailwind, so set on h3 + reinforce  */\n/* on the span; !important beats the theme default + inherit utilities.*/\n/* ------------------------------------------------------------------ */\n.sidebar-title {\n  font-size: 0.95rem !important;   /* larger than default */\n  font-weight: 700 !important;     /* bold */\n  color: #ffb405 !important;       /* TZ accent (yellow) */\n  letter-spacing: -0.2px;\n  text-transform: none;\n  margin-top: 1.25rem;\n  padding-top: 1rem;\n  border-top: 1px solid #1f283d;   /* horizontal separator between sections */\n}\n\n.sidebar-title span {\n  font-weight: 700 !important;\n  color: #ffb405 !important;\n}\n\n/* Group icons are masked SVGs filled via `bg-current` (currentColor), */\n/* so recolour them with background-color, not color/fill.             */\n.sidebar-group-icon {\n  background-color: #ffb405 !important;\n}\n\n/* Don't draw a separator above the very first section */\n#sidebar-content .sidebar-title:first-of-type {\n  border-top: none;\n  margin-top: 0;\n  padding-top: 0;\n}\n\n/* ------------------------------------------------------------------ */\n/* Card banner images: force a uniform height so cards line up         */\n/* regardless of each source image's aspect ratio. Mintlify tags card  */\n/* images with data-component-part=\"card-image\". The image already has */\n/* object-cover; it just lacks a height, so we set one.                */\n/* ------------------------------------------------------------------ */\n[data-component-part=\"card-image\"] {\n  height: 160px !important;\n  width: 100%;\n  object-fit: cover;\n}\n\n"])</script><script>self.__next_f.push([1,"53:[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"styles.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$59\"}}]]\n54:[\"$\",\"$L5a\",null,{\"customJsDisabled\":false,\"jsFiles\":[]}]\n5d:Tfb3,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,li:`li`,p:`p`,ul:`ul`,..._provideComponents(),...props.components},{Frame,Heading,OptimizedImage}=_components;if(!Frame)_missingMdxReference(`Frame`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!OptimizedImage)_missingMdxReference(`OptimizedImage`,true);return _jsxs(_Fragment,{children:[_jsx(_components.p,{children:`Scenario Builder is a no-code modelling tool for power system analysts and modellers. It lets users build, run, and analyse results from long-term capacity expansion and hourly dispatch models quickly, transparently, and at scale. Designed for analysts and modellers working at or alongside governments, it simplifies the modelling process while maintaining analytical depth.`}),`\n`,_jsx(Frame,{children:_jsx(OptimizedImage,{src:`https://mintcdn.com/transitionzero/HSEawz0vTgacZg8o/images/SB3.0-Inputs-1.png?fit=max\u0026auto=format\u0026n=HSEawz0vTgacZg8o\u0026q=85\u0026s=df4c14a3ad96e8197486ab09782ab723`,alt:`SB3 0 Inputs 1`,\"data-og-width\":`1408`,width:`1408`,\"data-og-height\":`880`,height:`880`,\"data-path\":`images/SB3.0-Inputs-1.png`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/transitionzero/HSEawz0vTgacZg8o/images/SB3.0-Inputs-1.png?w=280\u0026fit=max\u0026auto=format\u0026n=HSEawz0vTgacZg8o\u0026q=85\u0026s=9e6d613ca025873d9bdd7c13e4493bdd 280w, https://min