ase-studies\"},{\"anchor\":\"Contact Us\",\"icon\":\"headset\",\"href\":\"https://www.transitionzero.org/contact\"}]},\"pages\":[]}},\"docsNavWithMetadata\":\"$undefined\",\"anonymizedNav\":\"$undefined\",\"hasFullNav\":false},\"children\":\"$L31\"}]}]}]}]]}]]}]]\n"])</script><script>self.__next_f.push([1,"19:[\"$\",\"$L32\",null,{\"scopedNav\":{\"global\":{\"anchors\":[{\"anchor\":\"About Us\",\"icon\":\"users\",\"href\":\"https://www.transitionzero.org/about-us\"},{\"anchor\":\"Case Studies\",\"icon\":\"books\",\"href\":\"https://www.transitionzero.org/case-studies\"},{\"anchor\":\"Contact Us\",\"icon\":\"headset\",\"href\":\"https://www.transitionzero.org/contact\"}]},\"groups\":[{\"group\":\"Platform\",\"icon\":\"gauge-high\",\"pages\":[{\"title\":\"What is Scenario Builder?\",\"description\":\"A brief introduction to Scenario Builder, our free, no-code energy system modelling platform for the power sector.\",\"sidebarTitle\":\"What is Scenario Builder?\",\"href\":\"/platform/scenario-builder\"},{\"title\":\"Getting Started\",\"description\":\"Watch a full walkthrough of Scenario Builder, then follow the core workflow to build and run your first model.\",\"href\":\"/platform/get-started\"},{\"title\":\"Creating a Scenario\",\"description\":\"How to create a project and configure a new scenario: geography, model type, timeline, and temporal resolution.\",\"href\":\"/platform/creating-a-scenario\"},{\"title\":\"Editing Scenarios\",\"description\":\"How to duplicate scenarios, customise model inputs, and use CSV templates.\",\"href\":\"/platform/editing-scenarios\"},{\"title\":\"Viewing Results\",\"description\":\"How to read your scenario results: headline metrics, charts, filtering by geography, and downloading the data.\",\"href\":\"/platform/viewing-results\"},{\"title\":\"Research Question Catalogue\",\"description\":\"A catalogue of research questions that can be answered using Scenario Builder. Includes implementation details for each question.\",\"href\":\"/platform/research-question-catalogue\"},{\"title\":\"Input Data Types\",\"description\":\"A directory of Scenario Builder’s input data types\",\"href\":\"/platform/input-types\"},{\"title\":\"Technologies\",\"description\":\"A directory of the generation, storage, and network technologies Scenario Builder models\",\"href\":\"/platform/technologies\"},{\"title\":\"Interconnectors\",\"description\":\"What interconnectors are in a Scenario Builder model, how the calibrated set is chosen, and what happens when you exclude one or limit it to a single direction\",\"href\":\"/platform/interconnectors\"},{\"title\":\"Data Privacy FAQs\",\"description\":\"Frequently asked questions about how TransitionZero handles, processes, and stores your data\",\"href\":\"/platform/data-privacy-faqs\"},{\"title\":\"Understanding Infeasibilities\",\"description\":\"What are infeasible models? How can you prevent them? How can you resolve them?\",\"href\":\"/platform/infeasibilities\"},{\"title\":\"AMP AI Assistant\",\"description\":\"AMP is an AI assistant designed to help you build, debug, and analyse energy system models directly within Scenario Builder.\",\"href\":\"/platform/amp-ai-assistant\"},{\"title\":\"Run Statuses\",\"description\":\"This page describes the different statuses that appear when running scenarios in Scenario Builder\",\"href\":\"/platform/run-statuses\"}]},{\"group\":\"Methodology\",\"icon\":\"flask\",\"pages\":[{\"title\":\"Model methodology\",\"description\":\"This section outlines the modelling methodology behind Scenario Builder. Our goal is to make energy system modelling accessible by being transparent about the data, assumptions, and calculations we use - even for those without a technical background. This document is a key part of your learning journey. It's a living resource, updated as the platform evolves and shaped by valuable user feedback.\",\"sidebarTitle\":\"Model methodology\",\"href\":\"/methodology/model-methodology\"},{\"title\":\"Model frameworks\",\"description\":\"This page outlines TransitionZero's model frameworks used for modelling on Scenario Builder\",\"href\":\"/methodology/model-frameworks\"},{\"title\":\"Model resolution\",\"description\":\"This page explains how spatial (geographic) and temporal (time) resolution impacts modelling results. \",\"href\":\"/methodology/model-resolution\"},{\"title\":\"Existing assets\",\"description\":\"This page discusses how Scenario Builder uses existing asset data, an essential starting input for energy system modelling.\",\"href\":\"/methodology/existing-assets\"},{\"title\":\"Future assets\",\"description\":\"This page describes input data for future assets, or what could be built in the future.\",\"href\":\"/methodology/future-assets\"},{\"title\":\"Techno-economic inputs\",\"description\":\"This page discusses the different types of tecno-economic input data used in energy system modelling\",\"href\":\"/methodology/techno-economic-inputs\"},{\"title\":\"Commodity (fuel) prices\",\"description\":\"This page discusses commodity prices, an essential data input for energy system models.\",\"href\":\"/methodology/commodity-prices\"},{\"title\":\"Financial inputs\",\"description\":\"This page discusses how financial data inputs influence a model\",\"href\":\"/methodology/financial-inputs\"},{\"title\":\"Renewable energy potentials\",\"description\":\"What are RE potentials and how do they impact modelling results?\",\"href\":\"/methodology/renewable-potentials\"},{\"title\":\"Renewable energy profiles\",\"description\":\"What are RE profiles, and how do they impact modelling results?\",\"href\":\"/methodology/renewable-profiles\"},{\"title\":\"Demand\",\"description\":\"This section outlines the methodology and input data used to develop demand projections within Scenario Builder.\",\"href\":\"/methodology/demand-projections\"},{\"title\":\"Demand profiles\",\"description\":\"What are electricity demand profiles, and how do they impact model results?\",\"href\":\"/methodology/demand-profiles\"},{\"title\":\"Model calibration\",\"description\":\"This page outlines TransitionZero's model calibration standard met by all models on Scenario Builder\",\"href\":\"/methodology/model-calibration\"},{\"title\":\"Backstop technology\",\"description\":\"What backstop is, why it exists, and how to interpret it in your results\",\"hidden\":true,\"href\":\"/methodology/backstop\",\"hiddenSetByFrontmatter\":true}]},{\"group\":\"Supported Countries and Scenarios\",\"icon\":\"globe\",\"expanded\":true,\"pages\":[{\"group\":\"Calibrated Country Models\",\"icon\":\"book-open-lines\",\"pages\":[{\"title\":\"Calibrated country models\",\"description\":\"Browse the calibrated power system models available in Scenario Builder, by country and region.\",\"sidebarTitle\":\"Browse country models\",\"href\":\"/countries/overview\"},{\"title\":\"Indonesia\",\"description\":\"This section provides specific details about Scenario Builder's Indonesia model\",\"href\":\"/countries/indonesia\"},{\"title\":\"The Maldives\",\"description\":\"This section provides specific details about Scenario Builder's model of the Maldives.\",\"href\":\"/countries/maldives\"},{\"title\":\"Samoa\",\"description\":\"This section provides specific details about Scenario Builder's model of Samoa.\",\"href\":\"/countries/samoa\"},{\"title\":\"Singapore\",\"description\":\"This section provides specific details about Scenario Builder's model of Singapore.\",\"href\":\"/countries/singapore\"},{\"title\":\"Laos\",\"description\":\"This section provides specific details about Scenario Builder's model of Laos.\",\"href\":\"/countries/laos\"},{\"title\":\"Cambodia\",\"description\":\"This section provides specific details about Scenario Builder's model of Cambodia.\",\"href\":\"/countries/cambodia\"},{\"title\":\"Brunei\",\"description\":\"This section provides specific details about Scenario Builder's model of Brunei.\",\"href\":\"/countries/brunei\"},{\"title\":\"Myanmar\",\"description\":\"This section provides specific details about Scenario Builder's model of Myanmar.\",\"href\":\"/countries/myanmar\"},{\"title\":\"The Philippines\",\"description\":\"This section provides specific details about Scenario Builder's model of the Philippines.\",\"href\":\"/countries/philippines\"},{\"title\":\"Malaysia\",\"description\":\"This section provides specific details about Scenario Builder's model of Malaysia.\",\"href\":\"/countries/malaysia\"},{\"title\":\"Vietnam\",\"description\":\"This section provides specific details about Scenario Builder's model of Vietnam.\",\"href\":\"/countries/vietnam\"},{\"title\":\"Thailand\",\"description\":\"This section provides specific details about Scenario Builder's model of Thailand.\",\"href\":\"/countries/thailand\"},{\"title\":\"Japan\",\"description\":\"This section provides specific details about Scenario Builder's model of Japan.\",\"href\":\"/countries/japan\"},{\"description\":\"This section provides specific details about Scenario Builder's model of Pakistan.\",\"title\":\"Pakistan\",\"href\":\"/countries/pakistan\"},{\"title\":\"India\",\"description\":\" This section provides specific details about Scenario Builder's model of India.\",\"href\":\"/countries/india\"},{\"title\":\"Bangladesh\",\"description\":\"This section provides specific details about Scenario Builder's model of Bangladesh.\",\"href\":\"/countries/bangladesh\"},{\"title\":\"Southeast Asia: ASEAN Power Grid (APG)\",\"description\":\"This section provides specific details about Scenario Builder's model of ASEAN Power Grid, a multi-country model connecting the electricity systems of all ten ASEAN member states — Brunei, Cambodia, Indonesia, Laos, Malaysia, Myanmar, Philippines, Singapore, Thailand, and Vietnam — covering generation, dispatch, and cross-border trade flows.\",\"href\":\"/countries/asean-power-grid\"}]},{\"group\":\"Uncalibrated Country Models\",\"icon\":\"globe-asia\",\"pages\":[{\"title\":\"Global Data and Methodology\",\"description\":null,\"href\":\"/countries/global-data-and-methodology\"},{\"description\":\"This section provides specific details about Scenario Builder's model of Pakistan.\",\"title\":\"Pakistan\",\"href\":\"/countries/pakistan-2\"},{\"title\":\"South Africa\",\"description\":\"This section provides specific details about Scenario Builder's model of South Africa.\",\"href\":\"/countries/south-africa\"},{\"title\":\"Southern Europe: Western Balkans\",\"description\":\"This section provides specific details about Scenario Builder's model of the Western Balkans, a multi-country model covering Albania, Bosnia and Herzegovina, Kosovo, Montenegro, North Macedonia, and Serbia, including cross-border trade flows.\",\"href\":\"/countries/balkans\"},{\"title\":\"Barbados\",\"hidden\":true,\"description\":null,\"href\":\"/countries/barbados\",\"hiddenSetByFrontmatter\":true}]}]},{\"group\":\"Feedback\",\"icon\":\"comment-dots\",\"pages\":[{\"title\":\"Get in touch with TransitionZero\",\"description\":\"If you have any questions, please reach out to support@transitionzero.org\",\"href\":\"/getintouch\"}]}]},\"maps\":{\"firstHrefInVersion\":{},\"firstHrefInLanguage\":{}},\"children\":\"$L33\"}]\n"])</script><script>self.__next_f.push([1,"34:I[604804,[\"/mintlify-assets/_next/static/chunks/36c5362201361dc4.js?dpl=dpl_HYbBsVSaAAVERjMZ6KvWBG2Yupcm\",\"/mintlify-assets/_next/static/chunks/1e7a188add93a653.js?dpl=dpl_HYbBsVSaAAVERjMZ6KvWBG2Yupcm\",\"/mintlify-assets/_next/static/chunks/4ef84a5baa60d431.js?dpl=dpl_HYbBsVSaAAVERjMZ6KvWBG2Yupcm\",\"/mintlify-assets/_next/static/chunks/761250e423ee7acf.js?dpl=dpl_HYbBsVSaAAVERjMZ6KvWBG2Yupcm\",\"/mintlify-assets/_next/static/chunks/114447d6045ff422.js?dpl=dpl_HYbBsVSaAAVERjMZ6KvWBG2Yupcm\",\"/mintlify-assets/_next/static/chunks/3ce7caa00ebea73c.js?dpl=dpl_HYbBsVSaAAVERjMZ6KvWBG2Yupcm\",\"/mintlify-assets/_next/static/chunks/91103844efdcdc17.js?dpl=dpl_HYbBsVSaAAVERjMZ6KvWBG2Yupcm\",\"/mintlify-assets/_next/static/chunks/5311c7deca