 to decarbonise a country’s electricity grid?`}),`\n`,_jsx(_components.li,{children:`What infrastructure investments are needed to meet rising demand?`}),`\n`,_jsx(_components.li,{children:`What emissions reductions can we expect from current policies?`}),`\n`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"55:[\"$\",\"$L5b\",null,{\"slug\":\"platform/scenario-builder\",\"pageMetadata\":\"$33:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L5c\",null,{\"mdxSource\":{\"compiledSource\":\"$5d\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"title\":\"What is Scenario Builder?\",\"description\":\"A brief introduction to Scenario Builder, our free, no-code energy system modelling platform for the power sector.\",\"sidebarTitle\":\"What is Scenario Builder?\",\"href\":\"/platform/scenario-builder\"}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"docs.transitionzero.org\"}]}]\n"])</script></body></html>