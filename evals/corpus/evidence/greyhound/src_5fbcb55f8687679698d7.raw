</table>
</div>
<div style="padding-top: 10px;"></div>
<table border="0" cellspacing="5" cellpadding="5" style="width: 100%; border-collapse: collapse; margin-left: auto; margin-right: auto;">
<tbody>
<tr>
<td style="width: 30%; height: 25px; vertical-align: center;">
<p style="font-size: 16px; letter-spacing: normal; font-stretch: condensed; text-align: center;"><a style="color: #233250;" href="/travel-information/faq#making-a-booking" title="Making a Booking"><strong>Making a Booking</strong></a></p>
</td>
