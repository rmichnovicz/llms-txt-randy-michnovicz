<style id="wp-custom-css">
/* woocommerce-order-details */
.woocommerce-order-details table td,.woocommerce-order-details table th {
    border: 0 !important;
    border-bottom: 1px solid rgb(255 255 255 / 50%) !important;
    background: transparent !important;
	padding-left: 0;
}

.woocommerce-order-details table {
    max-width: 550px;
}

.woocommerce-order-details td:last-child {
    text-align: right;
    padding-right: 0;
}

.woocommerce-order-details th.woocommerce-table__product-table.product-total {
    text-align: right;
    padding-right: 0;
}

 h2.woocommerce-order-details__title {
    line-height: 20px;
    margin-bottom: 10px;
}
 h2.woocommerce-column__title {
    line-height: 20px;
    margin-bottom: 22px !important;
}
section.woocommerce-customer-details {
    margin-top: 50px;
}


div#acwp-toolbar-btn-wrap {
    top: auto !important;
    bottom: 50px !important;
    left: auto !important;
    right: 20px;
}
#acwp-toolbar-btn:hover, #acwp-toolbar-btn:focus {
    border-color: #5ae293 !important;
}


a.skip-link.screen-reader-text {
    display: block;
    position: absolute;
    left: -999px;
    top: -999px;
}
.screen-reader-text:focus {
    left: 5px !important;
    top: 5px !important;

}



.elementor-widget-woocommerce-menu-cart {
    display: block !important;
}


.lesson-navigation {
    display: flex;
    align-items: center;
    gap: 60px;
}

.nav-previous a, .nav-next a {
    display: flex;
    align-items: center;
    gap: 15px;
    font-family: 'Poppins';
    font-size: 16px;
    line-height: 24px;
    color: #34333B;
    font-weight: 600;
}
.border {
    /* border: 1px solid #34333B; */
    width: 1px;
    height: 66px;
    background: #34333B;
}

@media only screen and (max-width: 767px) {
	
	div#acwp-toolbar-btn-wrap {
   
    bottom: 20px !important;
  
}
	.nav-previous a img, .nav-next a img{
		width:51px;
		
	}
	.nav-previous a, .nav-next a {
    gap: 10px;
    
}
	.nav-next a {
		text-align:right
	}
	.lesson-navigation {
   
    gap: 30px;
    max-width: 262px;
    justify-content: center;
}
	
.border {
	display:none;
	}
	
}

/* woocommerce button styling - notice */

.return-to-shop>a {
    font-family: 'Poppins' !important;
    font-weight: 600 !important;
    padding: 15px 20px !important;
    border: 2px solid #5AE293 !important;
    border-radius: 0px !important;
    background: #5AE293 !important;
    color: #34333B !important;
}

.return-to-shop > a:hover {
    background: transparent !important;
    border: 2px solid #26BF6E !important;
    color: #26BF6E !important;
}

/* woocommerce button styling - notice code end */

/* Woocommerce notice box styling */

/* .woocommerce-message::before{
	top: 2em;
} */

/* .woocommerce-message{
	padding: 2em 2em 1em 3.5em;
} */

a.button.wc-forward{
	margin-top: -6px;
}

/* cookie popup */

.wcc-btn{
	margin: 0px !important;
}

.wcc-notice-btn-wrapper, .wcc-prefrence-btn-wrapper{
	gap: 5px;
}

button.wcc-accordion-btn:hover {
    border: none;
}

button.wcc-accordion-btn:focus {
    border: none;
}

button.wcc-show-desc-btn:not(:hover):not(:active) {
	color: #34333B !important;
	text-decoration: underline;
}

.wcc-show-desc-btn:hover{
	color: #5AE293 !important;
	text-decoration: underline !important;
	border: none !important;
}

.wcc-show-desc-btn:focus{
	color: #5AE293 !important;
	text-decoration: underline !important;
	border: none !important;
}

/* cookie policy bottom left icon */

.wcc-revisit-bottom-left {
    display: none !important;
}
/* cookie policy bottom left icon */

/* image caption color text editor */

figcaption{
	color: var(--e-global-color-6294c3e);;
}

/* form */
.partial_entry_warning{
	color: #fff;
}

/* general settings */

ul{
	margin-bottom: 16px;
}

strong{
	font-weight: 700;
}

/* gravity form */
.partial_entry_warning {
    display: none;
}
/* gravity form end */


</style>
</head>
