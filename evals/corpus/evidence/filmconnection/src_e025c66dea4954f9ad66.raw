<script>
document.addEventListener('DOMContentLoaded', function () {
    // Function to check if the viewport is desktop size
    function isDesktop() {
        return window.innerWidth >= 1024; // Adjust breakpoint as needed
    }

    // Select the carousel and its navigation arrows
    const carousel = document.querySelector('.custom-carousel .swiper-wrapper');
    const prevArrow = document.querySelector('.custom-carousel .elementor-swiper-button-prev');
    const nextArrow = document.querySelector('.custom-carousel .elementor-swiper-button-next');

    // Ensure the carousel and arrows exist
    if (isDesktop() && carousel && prevArrow && nextArrow) {
        // Count only valid slides (ignoring text nodes, empty elements, etc.)
        const slides = Array.from(carousel.children).filter(
            (slide) => slide.classList.contains('swiper-slide')
        );
        const totalSlides = slides.length;

        // Show or hide arrows based on the number of slides
        if (totalSlides <= 3) {
            prevArrow.style.display = 'none';
            nextArrow.style.display = 'none';
        } else {
            prevArrow.style.display = 'block';
            nextArrow.style.display = 'block';
        }
    }
});

</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  function checkForSlides(container) {
    if (!container) return;
    
    var wrapper = container.querySelector('.swiper-wrapper');
    if (!wrapper) {
      container.style.display = 'none';
      return;
    }
    var slides = wrapper.querySelectorAll('.swiper-slide');
    if (slides.length === 0) {
      container.style.display = 'none';
    } else {
      container.style.display = '';
    }
  }
  
  function observeContainer(container) {
    if (!container) return;
    
    var observer = new MutationObserver(function() {
      checkForSlides(container);
    });
    observer.observe(container, { childList: true, subtree: true });
    
    checkForSlides(container); // Initial check
  }
  
  var ssContainer = document.querySelector('.ss-container');
  var reviewContainer = document.querySelector('.review-container');
  
  observeContainer(ssContainer);
  observeContainer(reviewContainer);
});
</script>

<script id="wetware-privacy-link-js">
(function () {
	function openOptOut() {
		var b = document.querySelector('.wcc-btn-do-not-sell') || document.querySelector('.wt-cli-ccpa-opt-out') || document.querySelector('.cli_settings_button');
		if (b) { b.click(); return true; }
		return false;
	}
	document.addEventListener('click', function (e) {
		var a = e.target && e.target.closest ? e.target.closest('a[href$="#do-not-sell"]') : null;
		if (!a) { return; }
		e.preventDefault();
		if (!openOptOut()) { window.location.href = '/privacy-policy/'; }
	});
})();
</script>
	
