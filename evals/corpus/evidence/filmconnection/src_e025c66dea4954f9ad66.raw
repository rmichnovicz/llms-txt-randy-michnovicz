				<div class="elementor-element elementor-element-4291693 elementor-widget elementor-widget-text-editor" data-id="4291693" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
				<div class="elementor-widget-container">
									<h1><span style="color: #ffffff">FILM<br />CONNECTION<br />MENTORSHIP<br /><strong>Cost</strong></span></h1>								</div>
				</div>
				<div class="elementor-element elementor-element-0d5cb67 elementor-widget__width-initial elementor-widget-mobile__width-initial elementor-widget elementor-widget-text-editor" data-id="0d5cb67" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
				<div class="elementor-widget-container">
									<p>We keep costs low, and every plan is personal. Speak with a mentee advisor about a plan that fits your budget with your mentor. </p>								</div>
				</div>
		<div class="elementor-element elementor-element-352836e e-con-full e-flex e-con e-child" data-id="352836e" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="elementor-element elementor-element-d2ae4bb elementor-align-justify elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget elementor-widget-global elementor-global-30301 elementor-widget-button" data-id="d2ae4bb" data-element_type="widget" data-e-type="widget" data-widget_type="button.default">
				<div class="elementor-widget-container">
