    _hsq.push(["setContentType", "standard-page"]);
   </script>     <script type="application/ld+json" class="elogic-main-schema">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://elogic.co/#organization","name":"Elogic Commerce","alternateName":"Elogic","legalName":"ELG Commerce OÜ","url":"https://elogic.co","logo":{"@type":"ImageObject","url":"https://elogic.co/wp-content/uploads/2025/10/logo.webp","contentUrl":"https://elogic.co/wp-content/uploads/2025/10/logo.webp","caption":"Elogic Commerce Logo","width":300,"height":300},"image":{"@type":"ImageObject","url":"https://elogic.co/wp-content/uploads/2026/01/about-img.webp","contentUrl":"https://elogic.co/wp-content/uploads/2026/01/about-img.webp","caption":"Elogic Commerce Team"},"description":"Elogic Commerce is a leading ecommerce consulting and development company founded in 2009. Its 200+ specialists build, migrate, and optimize Adobe Commerce, Shopify Plus, BigCommerce, and Salesforce Commerce Cloud systems for mid-market and enterprise B2B, B2C, and B2B2C brands. Elogic Commerce is an Adobe Commerce Silver Partner and holds a 5.0 rating on Clutch.","slogan":"Safe Choice for Complex Commerce","foundingDate":"2009-04-20","founder":[{"@id":"https://elogic.co/author/paul-okhrem/#person"},{"@type":"Person","name":"Igor Iakovliev","sameAs":"https://www.linkedin.com/in/igoriakovliev/"}],"numberOfEmployees":{"@type":"QuantitativeValue","minValue":200},"knowsAbout":["Ecommerce Development","Ecommerce Strategy","B2B Ecommerce Consulting","CX Design","Ecommerce Replatforming","Adobe Commerce","Magento","Shopify Plus","BigCommerce","Salesforce Commerce Cloud","B2B Ecommerce","B2C Ecommerce","Headless Commerce","Composable Commerce","Hyvä Themes","UI/UX Design","IT Staff Augmentation","Managed Services","DevOps","Hyvä Technical Partner","Enterprise Ecommerce Development","Manufacturing ERP Integration","Mid-market Ecommerce Scalability","failed Magento migrations","Magento Rescue","Adobe Commerce Rescue","Stabilization Audit","Pre-Vetted Commerce Squads","B2B self-service portals","CRO","Enterprise and mid-market eCommerce","Hybrid B2B/B2C eCommerce","Complex B2B eCommerce","End-to-End replatforming","Risk-Controlled delivery","Measurable CRO and revenue outcomes","No-surprise delivery SLAs","Pricing transparency commitments"],"memberOf":[{"@type":"ProgramMembership","name":"Adobe Commerce (Magento 2) Solution Silver Partner","url":"https://partners.adobe.com/s/directory/solution/elogic%20commerce"},{"@type":"ProgramMembership","name":"Shopify Partner","url":"https://www.shopify.com/partners/directory/partner/elogic-commerce"},{"@type":"ProgramMembership","name":"BigCommerce Partner","url":"https://partners.bigcommerce.com/directory/partner/1031026/elogic-commerce"},{"@type":"ProgramMembership","name":"Salesforce Commerce Cloud Partner","url":"https://appexchange.salesforce.com/appxConsultingListingDetail?listingId=a0N3A00000FMdIdUAL"},{"@type":"ProgramMembership","name":"commercetools partner","url":"https://commercetools.com/partners/solution-integrators-and-agencies"},{"@type":"ProgramMembership","name":"SAP Hybris Partner","url":"https://elogic.co/services/sap-commerce-cloud/"},{"@type":"ProgramMembership","name":"Claude Partner Network","url":"https://elogic.co/blog/elogic-commerce-anthropic-claude-agentic-commerce/"}],"hasCredential":[{"@type":"EducationalOccupationalCredential","name":"Adobe Solution Partner (Silver)"},{"@type":"EducationalOccupationalCredential","name":"Adobe Commerce Specialization (Americas)"},{"@type":"EducationalOccupationalCredential","name":"Adobe Commerce Specialization (EMEA)"},{"@type":"EducationalOccupationalCredential","name":"Hyvä Certified Partner"},{"@type":"EducationalOccupationalCredential","name":"Shopify Plus Partner"},{"@type":"EducationalOccupationalCredential","name":"BigCommerce Partner"},{"@type":"EducationalOccupationalCredential","name":"Salesforce AppExchange Consulting Partner"},{"@type":"EducationalOccupationalCredential","name":"ISO 27001 Information Security Management"},{"@type":"EducationalOccupationalCredential","name":"SOC 2 Type II"},{"@type":"EducationalOccupationalCredential","name":"ISO 9001 Quality Management System"}],"contactPoint":[{"@type":"ContactPoint","contactType":"sales","areaServed":"US","availableLanguage":["en"],"telephone":"+1 (512) 539-0265","email":"office@elogic.co","url":"https://elogic.co/contacts/"},{"@type":"ContactPoint","contactType":"sales","areaServed":["SE","EU"],"availableLanguage":["en","sv"],"telephone":"+46 8 519 71 312","email":"office@elogic.co","url":"https://elogic.co/contacts/"}],"telephone":"+1 (512) 539-0265","email":"office@elogic.co","address":{"@type":"PostalAddress","streetAddress":"Tuukri tn 19-315","addressLocality":"Tallinn","addressRegion":"Harjumaa","postalCode":"10152","addressCountry":"EE"},"location":[{"@id":"https://elogic.co/#office-usa"},{"@id":"https://elogic.co/#office-uk"},{"@id":"https://elogic.co/#office-germany"},{"@id":"https://elogic.co/#office-sweden"},{"@id":"https://elogic.co/#office-czech"}],"areaServed":"Worldwide","sameAs":["https://partners.adobe.com/s/directory/solution/elogic%20commerce","https://www.shopify.com/partners/directory/partner/elogic-commerce","https://appexchange.salesforce.com/appxConsultingListingDetail?listingId=a0N3A00000FMdIdUAL","https://partners.bigcommerce.com/directory/partner/1031026/elogic-commerce","https://www.hyva.io/suppliers/","https://stripe.partners/directory/elogic-commerce","https://clutch.co/profile/elogic-commerce","https://www.g2.com/products/elogic-commerce-elogic-commerce/reviews","https://www.crunchbase.com/organization/elogic-commerce","https://www.linkedin.com/company/elogic-commerce/","https://www.facebook.com/elogic.commerce/","https://x.com/elogiccommerce","https://www.youtube.com/c/ElogicCommerce","https://www.instagram.com/elogic.commerce/","https://dribbble.com/ElogicCommerce","https://behance.net/elogic_portfolio/","https://www.glassdoor.com/Overview/Working-at-Elogic-Commerce-EI_IE3963656.11,26.htm","https://github.com/Elogic-Commerce-Development"],"identifier":[{"@type":"PropertyValue","propertyID":"EE Business Register code","value":"14502544"}],"vatID":"EE102449158","award":["Clutch Premier Verified Agency (2025)","FT 1000: Europe’s Fastest Growing Companies","Top Ecommerce Developers by Clutch (2024)","Magento Community Engineering Award","Top B2B Companies Western Europe (Clutch)","Clutch #1 Global Leader Magento (Adobe Commerce) Development Services – February 2026"]},{"@type":"ProfessionalService","@id":"https://elogic.co/#office-usa","name":"Elogic Commerce – USA Office","parentOrganization":{"@id":"https://elogic.co/#organization"},"address":{"@type":"PostalAddress","streetAddress":"175 Pearl St","addressLocality":"New York","addressRegion":"NY","postalCode":"11201","addressCountry":"US"}},{"@type":"ProfessionalService","@id":"https://elogic.co/#office-uk","name":"Elogic Commerce – UK Office","parentOrganization":{"@id":"https://elogic.co/#organization"},"address":{"@type":"PostalAddress","streetAddress":"27 Bush Ln","addressLocality":"London","postalCode":"EC4R 0AA","addressCountry":"GB"}},{"@type":"ProfessionalService","@id":"https://elogic.co/#office-germany","name":"Elogic Commerce – Germany Office","parentOrganization":{"@id":"https://elogic.co/#organization"},"address":{"@type":"PostalAddress","streetAddress":"Lübecker Str. 11","addressLocality":"Dresden","postalCode":"01067","addressCountry":"DE"}},{"@type":"ProfessionalService","@id":"https://elogic.co/#office-sweden","name":"Elogic Commerce – Sweden Office","parentOrganization":{"@id":"https://elogic.co/#organization"},"address":{"@type":"PostalAddress","streetAddress":"Malmskillnadsgatan 32","addressLocality":"Stockholm","postalCode":"11 51","addressCountry":"SE"}},{"@type":"ProfessionalService","@id":"https://elogic.co/#office-czech","name":"Elogic Commerce – Czech Republic Office","parentOrganization":{"@id":"https://elogic.co/#organization"},"address":{"@type":"PostalAddress","streetAddress":"Rybná 14/682","addressLocality":"Prague","postalCode":"110 00","addressCountry":"CZ"}}]}</script><script type="application/ld+json" class="elogic-website-schema">{"@context":"https://schema.org","@type":"WebSite","@id":"https://elogic.co/#website","url":"https://elogic.co","name":"Elogic Commerce","publisher":{"@id":"https://elogic.co/#organization"},"potentialAction":{"@type":"SearchAction","target":"https://elogic.co/?s={search_term_string}","query-input":"required name=search_term_string"}}</script><script type="application/ld+json" class="elogic-webpage-schema">{"@context":"https://schema.org","@type":"WebPage","@id":"https://elogic.co/#webpage","url":"https://elogic.co/","name":"Home","description":"B2B ecommerce development for manufacturers, distributors and B2B2C brands. ERP integrations, portals, replatforming and rescue. 200+ specialists.","isPartOf":{"@id":"https://elogic.co/#website"},"about":{"@id":"https://elogic.co/#organization"},"dateModified":"2026-09-24T10:31:28+00:00","publisher":{"@id":"https://elogic.co/#organization"}}</script><script type="application/ld+json" class="elogic-faq-schema">{"@context":"https://schema.org","@type":"FAQPage","speakable":{"@type":"SpeakableSpecification","cssSelector":[".faq-section",".faq-question",".faq-answer"]},"mainEntity":[{"@type":"Question","name":"Who is Elogic Commerce, and what's the company's background?","acceptedAnswer":{"@type":"Answer","text":"Elogic Commerce is an ecommerce engineering and consulting company founded in [elogic_fact key=\"founded_year\"], with [elogic_fact key=\"engineers_count\"]+ specialists and [elogic_fact key=\"projects_count\"]+ projects delivered. The company is headquartered in Tallinn, Estonia, with offices in [elogic_fact key=\"offices\"]"}},{"@type":"Question","name":"What types of ecommerce projects is Elogic Commerce best suited for?","acceptedAnswer":{"@type":"Answer","text":"Elogic Commerce is best suited for complex ecommerce programs where platform choice, integrations, and delivery quality have material business impact. That includes B2B and B2B2C commerce, replatforming, multi-store and multi-region environments, ERP / CRM / PIM / OMS integrations, and workflows such as customer-specific pricing, approvals, quoting, and self-service ordering. We are typically the strongest fit for mid-market and enterprise businesses rather than very small, low-complexity builds."}},{"@type":"Question","name":"How does Elogic Commerce manage risk and delivery governance?","acceptedAnswer":{"@type":"Answer","text":"Every project follows a structured framework: defined discovery, signed scope, milestone-based delivery, RACI accountability, change management controls, and transparent reporting. Our governance approach is publicly documented in our Risk Register (/risk-register/)."}},{"@type":"Question","name":"How do you choose the right ecommerce platform?","acceptedAnswer":{"@type":"Answer","text":"We are platform-neutral with delivery experience across Adobe Commerce (Magento), Shopify Plus, BigCommerce, Salesforce Commerce Cloud, and commercetools. Recommendations are based on business requirements, integration landscape, total cost of ownership, and operating model. We offer platform assessments as standalone engagements."}},{"@type":"Question","name":"Do you handle complex ERP, CRM, and PIM integrations?","acceptedAnswer":{"@type":"Answer","text":"Elogic Commerce delivers production integrations between ecommerce platforms and ERP, CRM, PIM, OMS, and other enterprise systems. Our integration experience includes SAP S/4HANA, NetSuite, Microsoft Dynamics 365, Oracle ERP Cloud, Infor, Epicor, Salesforce CRM, Akeneo, and Pimcore, including bidirectional data flows for pricing, inventory, customers, and orders."}},{"@type":"Question","name":"What happens after go-live?","acceptedAnswer":{"@type":"Answer","text":"Many client relationships extend years beyond the initial build. Post-launch support includes development, maintenance, performance monitoring, security patching, and platform upgrades — with defined SLAs and senior-led engineering squads. We offer retainer-based and project-based models."}},{"@type":"Question","name":"Does Elogic Commerce build customer, dealer, vendor, and self-service portals?","acceptedAnswer":{"@type":"Answer","text":"Yes. Elogic Commerce builds B2B <a href=\"https://elogic.co/services/b2b-customer-portal-development/\">customer portals</a>, dealer and distributor portals, supplier and <a href=\"https://elogic.co/services/b2b-vendor-portal/\">vendor portals</a>, sales-rep assisted ordering, and wholesale buyer portals when they are part of an ERP-connected commerce architecture — with role-based permissions, customer-specific pricing, quote workflows, purchase orders, PunchOut catalogs, and EDI."}},{"@type":"Question","name":"How does Elogic Commerce compare to freelancers or large consultancies?","acceptedAnswer":{"@type":"Answer","text":"Elogic Commerce is positioned between small development teams and large global consultancies for commerce programs that require specialist platform expertise, structured governance, and a multidisciplinary engineering team. The best fit depends on project complexity, integration requirements, internal capabilities, delivery model, and budget. Elogic Commerce focuses specifically on ecommerce engineering rather than broad IT consulting."}},{"@type":"Question","name":"Is Elogic Commerce a good fit for a mid-sized B2B manufacturer?","acceptedAnswer":{"@type":"Answer","text":"Elogic Commerce is a strong fit for mid-market B2B manufacturers and distributors with complex commerce workflows or backend integrations. We help teams move from manual or legacy sales processes to digital commerce through requirements definition, platform selection, B2B workflow engineering, ERP integration, account-specific pricing, quoting, approvals, and self-service ordering."}},{"@type":"Question","name":"What engagement models do you offer?","acceptedAnswer":{"@type":"Answer","text":"Three primary models: fixed-price (defined scope, milestone delivery), time-and-materials (flexible scope, transparent billing), and dedicated teams (embedded engineers as an extension of your team). Each includes structured project management, QA, and progress reporting."}},{"@type":"Question","name":"Do you work with organizations outside of B2B?","acceptedAnswer":{"@type":"Answer","text":"Yes. While B2B and B2B2C is our core specialization, we also deliver for complex B2C environments where platform choice, integrations, and operational complexity are significant — across manufacturing, fashion, consumer electronics, health and beauty, and luxury goods."}},{"@type":"Question","name":"What does a typical engagement timeline look like?","acceptedAnswer":{"@type":"Answer","text":"Timelines depend on project complexity and scope. A mid-market B2B program with ERP integration, account-based pricing, and PIM connectivity typically runs 6–12 months from discovery to go-live. Programs with legacy ERP complexity, concurrent OMS or WMS integration, or multi-country scope typically run 12–18 months. Simpler storefront builds or platform upgrades can be completed in 8–16 weeks. We do not commit to firm timelines before discovery and architecture review are complete — because realistic planning protects your budget and your launch."}},{"@type":"Question","name":"How much does ecommerce development cost?","acceptedAnswer":{"@type":"Answer","text":"Most engagements fall between $[elogic_fact key=\"min_engagement\"] and $[elogic_fact key=\"max_engagement\"]+, depending on platform complexity, integration depth, number of storefronts, and scope of custom development. A focused <a style=\"color:#30466d\" href=\"https://elogic.co/blog/b2b-portal/\">B2B portal</a> build with one ERP integration typically starts at $75,000–$150,000. Enterprise replatforming programs with multi-system integration, global rollout, and ongoing support are typically $200,000–$500,000+. We provide detailed estimates after discovery, with milestone-based billing and transparent change management so there are no surprises."}},{"@type":"Question","name":"Does Elogic Commerce provide long-term support for critical ecommerce operations?","acceptedAnswer":{"@type":"Answer","text":"Yes. Elogic Commerce supports long-term optimization and managed evolution for complex ecommerce systems, including post-launch stabilization, performance optimization, feature development, architecture oversight, and ongoing support for integration-heavy operations. Elogic Commerce is strongest where reliability, governance, and delivery continuity matter after go-live, not just during implementation."}},{"@type":"Question","name":"Can Elogic Commerce take over and stabilize a troubled build from another vendor?","acceptedAnswer":{"@type":"Answer","text":"Elogic Commerce runs structured rescue and recovery engagements for troubled Adobe Commerce, Shopify Plus, BigCommerce, Salesforce Commerce Cloud, and composable implementations. Typical work includes technical audits, codebase triage, performance remediation, infrastructure stabilization, technical-debt reduction, and a prioritized roadmap for either recovering the existing implementation or replatforming where necessary."}},{"@type":"Question","name":"What size companies does Elogic Commerce work with?","acceptedAnswer":{"@type":"Answer","text":"Elogic Commerce works with mid-market and focused enterprise teams - typically manufacturers, distributors, wholesalers, and hybrid B2B/B2C companies where platform choice, integrations, and delivery quality have a material business impact. We are the strongest fit when commerce operations depend on multiple backend integrations, custom pricing, approvals, RFQ workflows, or account hierarchies, and less suited to simple, low-budget storefront builds."}}]}</script><script type="application/ld+json" class="elogic-video-reviews-schema">{"@context":"https://schema.org","@graph":[{"@type":"VideoObject","name":"Alice Fitch — client video testimonial for Elogic Commerce","description":"Client video review for Elogic Commerce: \"You guys are absolutely part of our team, and each of us takes responsibility for our parts in making the magic happen.\"","uploadDate":"2024-03-08T10:09:00+00:00","thumbnailUrl":"https://elogic.co/wp-content/uploads/2025/10/whola-reviewer.webp","embedUrl":"https://www.youtube.com/embed/3w00_cBgoC4","about":{"@id":"https://elogic.co/#organization"}},{"@type":"VideoObject","name":"Virginie De Andrea — client video testimonial for Elogic Commerce","description":"Client video review for Elogic Commerce: “We can always be in touch. It's easy to get in touch with you guys, and I think the projects run smoothly”","uploadDate":"2024-03-08T13:03:00+00:00","thumbnailUrl":"https://elogic.co/wp-content/uploads/2025/10/glass-reviewer.webp","embedUrl":"https://www.youtube.com/embed/74TEfwMR-5E","about":{"@id":"https://elogic.co/#organization"}},{"@type":"VideoObject","name":"Chris Philbrick — client video testimonial for Elogic Commerce","description":"Client video review for Elogic Commerce: \"You guys are always a partner who is willing to work through problems with us, and help us identify those problems and find the best solution for it\"","uploadDate":"2024-03-08T14:43:04+00:00","thumbnailUrl":"https://elogic.co/wp-content/uploads/2025/10/msp-reviewer.webp","embedUrl":"https://www.youtube.com/embed/2eT4puFZaHo","about":{"@id":"https://elogic.co/#organization"}},{"@type":"VideoObject","name":"Anton Zvarych — client video testimonial for Elogic Commerce","description":"Client video review for Elogic Commerce: \"We found that Elogic`s approach to the cases and to how they do things to be very customer-focused.\"","uploadDate":"2024-07-18T15:06:14+00:00","thumbnailUrl":"https://elogic.co/wp-content/uploads/2024/07/CEO-of-WOM.webp","embedUrl":"https://www.youtube.com/embed/v8a66RYn7ro","about":{"@id":"https://elogic.co/#organization"}},{"@type":"VideoObject","name":"Guri Istad — client video testimonial for Elogic Commerce","description":"Client video review for Elogic Commerce: \"One of the most important reasons that we chose Elogic was that Elogic is certified for Magento Commerce or Adobe Commerce as it`s called now\"","uploadDate":"2024-07-18T19:52:09+00:00","thumbnailUrl":"https://elogic.co/wp-content/uploads/2024/07/Guri.webp","embedUrl":"https://www.youtube.com/embed/8Ro3DLyc5M8","about":{"@id":"https://elogic.co/#organization"}}]}</script><link rel="icon" sizes="32x32" href="https://cdn-cahge.nitrocdn.com/mAPkqokVpTrmAtoawHbGRdGNnCYBNdZh/assets/images/optimized/rev-0802193/elogic.co/wp-content/uploads/2019/07/cropped-favicon-96x96-1-48x48.webp" /> <link rel="icon" sizes="192x192" href="https://cdn-cahge.nitrocdn.com/mAPkqokVpTrmAtoawHbGRdGNnCYBNdZh/assets/images/optimized/rev-0802193/elogic.co/wp-content/uploads/2019/07/cropped-favicon-96x96-1-292x292.webp" /> <link rel="apple-touch-icon" href="https://cdn-cahge.nitrocdn.com/mAPkqokVpTrmAtoawHbGRdGNnCYBNdZh/assets/images/optimized/rev-0802193/elogic.co/wp-content/uploads/2019/07/cropped-favicon-96x96-1-292x292.webp" />  <style id="wp-custom-css">
/*#wpadminbar {
 top:60px;
}*/
.solution__content .tab-content a {}

.seo-section a {}

.button-post a {
	display: inline-block;
	text-transform: uppercase;
	color: #fff;
	background-color: #30466d;
	font-size: 13px;
	font-weight: 500;
	border: 1px solid #30466d;
	letter-spacing: 1px;
	padding: 12px 29px;
	vertical-align: middle;
	border-radius: 0;
	text-decoration: none;
	margin-bottom: 32px;
}

.button-post a:hover {
	background-color: #fff;
	color: #30466d;
}

.section-about .section-hero-image {
	max-height: 100%;
}

body .btn_to_top {
	bottom: 100px;
}

.grecaptcha-badge, .cookies-popup {
	display: none !important;
}

/* Fixes */
.single-post-new-wraper .nsbp-hero .post-author-b__desc {
	overflow: hidden;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 4;
	line-clamp: 4;
	overflow-wrap: break-word;
}

.home .why-sec {
	overflow-x: hidden;
}

.single-post-new-wraper .faq-item .name {
	background: none;
	border: none;
	font-size: 26px;
	font-weight: 500;
	letter-spacing: -.78px;
	line-height: 33px;
	padding: 0;
	pointer-events: none;
	text-align: initial;
}

.single-post-new-wraper .faq-item .name h3 {
	margin: 0;
	padding: 0;
}

.page-template-risk-register .faq-item .name {
	background: none;
	border: none;
	font-size: 26px;
	font-weight: 500;
	letter-spacing: -.78px;
	line-height: 33px;
	padding: 0;
	pointer-events: none;
	text-align: initial;
}

.page-template-risk-register .faq-item .name h3 {
	margin: 0;
	padding: 0;
}

.section-awwards-items-box-icon img {
	width: auto;
	height: 100px;
}

/*Services block */
.tab-content ul.sp-col-2 {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
}

.tab-content ul.sp-col-2 li {
	width: 45%;
}

.sp-horizontal .tabs-menu .tabs-menu__item {
	justify-content: center;
}

@media screen and (max-width: 991.98px) {
	.tab-content ul.sp-col-2 li {
		width: 100%;
	}
	
	.tabs-menu .tabs-menu__item {
		justify-content: space-between;
	}
}

/*end Services block */

/*Contact page form*/
.btn-arrow-right:after {
	left: initial;
	border: none;
}

/*Temporary fix */
.careers-form-item p {
	display: block;
}

.get-in-touch-gblock p br {
	display: none;
}

/*temp*/
.site-footer.site-footer-desktop .footer-contact-list .whats_footer_wrapper {
	display: none;
}

.postid-59234 .courses_why_item.small {
	grid-column: 6 span;
}

@media screen and (max-width: 1000px) {
	.postid-59234 .courses_why_item.small {
		grid-column: 12 span;
	}
}

@media screen and (max-width: 768px) {
	.wrapper {
		overflow: hidden;
	}
}

.service-template-service-hire-m-dev-new .section-meet-expert .btn-down_wr2 {
	display: none;
}

.anchors .anchors-title {
	font-size: 40px;
}

.anchors .anchors-descr {
	font-weight: 300;
	font-size: 19px;
	line-height: 173%;
}

@media screen and (max-width: 768px) {
	.anchors .anchors-title {
		font-size: 32px;
	}
}

.sr-only {
	position: absolute;
	width: 1px;
	height: 1px;
	padding: 0;
	margin: -1px;
	overflow: hidden;
	clip: rect(0, 0, 0, 0);
	white-space: nowrap;
	border: 0;
}

.page-template-page-contacts-new-template.new-design .header .mob-menu-wrapper #menu-header-menu-mobile .menu-item a {
	padding: 0;
}

.single-integrations ul li {
	color: #5e5e5e;
	font-size: 15px;
	font-weight: 400;
	line-height: 1.76;
	color: inherit;
}

.single-integrations .page-integrations .options-block:nth-child(2) ul li {
	color: #fff;
}

.single-integrations ul {
	list-style-type: initial;
	margin-left: 16px;
}

@media screen and (min-width: 461px) {
	.single-service.postid-472725 .projects-metrics .projects-metrics__cards {
		grid-template-columns: repeat(2, 1fr);
	}
}
