="apple-touch-icon" href="https://cdn-cahge.nitrocdn.com/mAPkqokVpTrmAtoawHbGRdGNnCYBNdZh/assets/images/optimized/rev-0802193/elogic.co/wp-content/uploads/2019/07/cropped-favicon-96x96-1-292x292.webp" />  <style id="wp-custom-css">
/*#wpadminbar {
 top:60px;
}*/
.solution__content .tab-content a {}

.seo-section a {}

.button-post a {
	display: inline-block;
	text-transform: uppercase;
	color: #fff;
	background-color: #30466d;
	font-size: 13px;
	font-weight: 500;
	border: 1px solid #30466d;
	letter-spacing: 1px;
	padding: 12px 29px;
	vertical-align: middle;
	border-radius: 0;
	text-decoration: none;
	margin-bottom: 32px;
}

.button-post a:hover {
	background-color: #fff;
	color: #30466d;
}

.section-about .section-hero-image {
	max-height: 100%;
}

body .btn_to_top {
	bottom: 100px;
}

.grecaptcha-badge, .cookies-popup {
	display: none !important;
}

/* Fixes */
.single-post-new-wraper .nsbp-hero .post-author-b__desc {
	overflow: hidden;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 4;
	line-clamp: 4;
	overflow-wrap: break-word;
}

.home .why-sec {
	overflow-x: hidden;
}

.single-post-new-wraper .faq-item .name {
	background: none;
	border: none;
	font-size: 26px;
	font-weight: 500;
	letter-spacing: -.78px;
	line-height: 33px;
	padding: 0;
	pointer-events: none;
	text-align: initial;
}

.single-post-new-wraper .faq-item .name h3 {
	margin: 0;
	padding: 0;
}

.page-template-risk-register .faq-item .name {
	background: none;
	border: none;
	font-size: 26px;
	font-weight: 500;
	letter-spacing: -.78px;
	line-height: 33px;
	padding: 0;
	pointer-events: none;
	text-align: initial;
}

.page-template-risk-register .faq-item .name h3 {
	margin: 0;
	padding: 0;
}

.section-awwards-items-box-icon img {
	width: auto;
	height: 100px;
}

/*Services block */
.tab-content ul.sp-col-2 {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
}

.tab-content ul.sp-col-2 li {
	width: 45%;
}

.sp-horizontal .tabs-menu .tabs-menu__item {
	justify-content: center;
}

@media screen and (max-width: 991.98px) {
	.tab-content ul.sp-col-2 li {
		width: 100%;
	}
	
	.tabs-menu .tabs-menu__item {
		justify-content: space-between;
	}
}

/*end Services block */

/*Contact page form*/
.btn-arrow-right:after {
	left: initial;
	border: none;
}

/*Temporary fix */
.careers-form-item p {
	display: block;
}

.get-in-touch-gblock p br {
	display: none;
}

/*temp*/
.site-footer.site-footer-desktop .footer-contact-list .whats_footer_wrapper {
	display: none;
}

.postid-59234 .courses_why_item.small {
	grid-column: 6 span;
}

@media screen and (max-width: 1000px) {
	.postid-59234 .courses_why_item.small {
		grid-column: 12 span;
	}
}

@media screen and (max-width: 768px) {
	.wrapper {
		overflow: hidden;
	}
}

.service-template-service-hire-m-dev-new .section-meet-expert .btn-down_wr2 {
	display: none;
}

.anchors .anchors-title {
	font-size: 40px;
}

.anchors .anchors-descr {
	font-weight: 300;
	font-size: 19px;
	line-height: 173%;
}

@media screen and (max-width: 768px) {
	.anchors .anchors-title {
		font-size: 32px;
	}
}

.sr-only {
	position: absolute;
	width: 1px;
	height: 1px;
	padding: 0;
	margin: -1px;
	overflow: hidden;
	clip: rect(0, 0, 0, 0);
	white-space: nowrap;
	border: 0;
}

.page-template-page-contacts-new-template.new-design .header .mob-menu-wrapper #menu-header-menu-mobile .menu-item a {
	padding: 0;
}

.single-integrations ul li {
	color: #5e5e5e;
	font-size: 15px;
	font-weight: 400;
	line-height: 1.76;
	color: inherit;
}

.single-integrations .page-integrations .options-block:nth-child(2) ul li {
	color: #fff;
}

.single-integrations ul {
	list-style-type: initial;
	margin-left: 16px;
}

@media screen and (min-width: 461px) {
	.single-service.postid-472725 .projects-metrics .projects-metrics__cards {
		grid-template-columns: repeat(2, 1fr);
	}
}
