      (function () {
        var KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
        var KEY = "tob_utm";
        function read() {
          try {
            return JSON.parse(sessionStorage.getItem(KEY) || "{}") || {};
          } catch (e) {
            return {};
          }
        }
        try {
          var params = new URLSearchParams(location.search);
          var incoming = {};
          KEYS.forEach(function (k) {
            var v = params.get(k);
            if (v) incoming[k] = v.slice(0, 200);
          });
          // Last-touch: overwrite when this visit carries UTM params. (For
          // first-touch within the session, also require !sessionStorage.getItem(KEY).)
          if (Object.keys(incoming).length) {
            sessionStorage.setItem(KEY, JSON.stringify(incoming));
          }
        } catch (e) {}
        window.tobUtm = read;
      })();
