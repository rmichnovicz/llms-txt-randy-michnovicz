<html>
    <head>
        <meta name="viewport" content="initial-scale=1.0, width=device-width">
        <meta charset="UTF-8">
        <meta name="description" content="Currently mostly AI because in 2026 of course it is. Grinding through the nuts and bolts of LLMs and trying to work out why this stuff works...">

        <link rel="canonical" href="/">

        <link rel="alternate" type="application/rss+xml" title="Giles Thomas" href="/feed/rss.xml" />
        <link rel="stylesheet" href="/styles/base.css">
        <link rel="stylesheet" href="/styles/monokai.css">

        <script src="/js/htmx.min.js"></script>

        <link rel="icon" type="image/png" href="/images/favicons/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/images/favicons/favicon.svg" />
        <link rel="shortcut icon" href="/images/favicons/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/images/favicons/apple-touch-icon.png" />
        <link rel="manifest" href="/images/favicons/site.webmanifest" />

        <title>Giles' blog</title>

        
    
        <script>
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has("page_id")) {
                window.location.href = "/query-redirect/?page_id=" + urlParams.get("page_id");
            } else if (urlParams.has("p")) {
                window.location.href = "/query-redirect/?p=" + urlParams.get("p");
            } else if (urlParams.has("feed")) {
                window.location.href = "/query-redirect/?feed=" + urlParams.get("feed");
            }
        </script>

        <link rel="alternate" type="text/markdown" title="LLM-friendly version" href="/llms.txt" />
    

    
        <link rel="next" href="/page/2">
    

    

    </head>

    <body hx-on="click:
        if (!event.target.closest('.dropdown-content')) {
            htmx.findAll('.links-bar').forEach(el => el.dataset.currentDropdown = '')
