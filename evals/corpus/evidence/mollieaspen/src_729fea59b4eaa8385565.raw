											<div class="hp-taste__hours a-up a-delay-1">
																 <p>BREAKFAST: 7:00AM - 11:00AM</p>
																		 <p>LUNCH: 11:30AM - 2:00PM</p>
																		 <p>DINNER: 5:00PM - 9:00PM</p>
																		 <p>BRUNCH (SAT+SUN): 7:00AM - 2:00PM</p>
															</div>
																<div class="hp-taste__menus a-up a-delay-2">
							<p class="text-lg">Menus</p>
							<div class="hp-taste__links">
																		<a href="https://mollieaspen.com/wp-content/uploads/2026/09/PT-Aspen-Breakfast-Menu-9.11.26.pdf" class="hp-taste__link" target="_blank">
