    <style>
        #mollie-video {
            width: 100%;
            height: auto;
        }

        .video-js .vjs-control-bar {
            visibility: hidden; /* Set to visible if you want controls */
        }

        .vjs-fullscreen {
            width: 100% !important;
            height: 100% !important;
        }

        .video-js.vjs-fullscreen .vjs-tech {
            width: 100%;
            height: 100%;
        }

        .video-js .vjs-control-bar {
            opacity: 0;
            transition: opacity 0.5s ease-in-out;
        }
        #background-image {
            width: 100%;
            height: 100vh; /* Full viewport height */
            background-size: cover;
            background-position: center;
        }

        /* Style adjustments for the video player, if needed */
        #mollie-video {
            display: block; /* Ensure it's displayed by default */
        }
    </style>

    <video id="mollie-video" class="video-js vjs-fullscreen" preload="auto" width="100%" height="auto"
    data-setup="{}" autoplay loop muted>
    <source src="https://mollieaspen.sfo2.cdn.digitaloceanspaces.com/websitebannerfinal1080p.mp4" type="video/mp4" />
