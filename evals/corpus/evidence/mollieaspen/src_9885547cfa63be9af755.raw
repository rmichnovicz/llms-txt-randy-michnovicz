        <img width="1900" height="1267" src="https://mollieaspen.com/wp-content/uploads/2023/12/Mollie_Common-Areas_Lobby-Lounge_034.jpg" class="attachment-full size-full" alt="MOLLIE Lobby Lounge" decoding="async" fetchpriority="high" srcset="https://mollieaspen.com/wp-content/uploads/2023/12/Mollie_Common-Areas_Lobby-Lounge_034.jpg 1900w, https://mollieaspen.com/wp-content/uploads/2023/12/Mollie_Common-Areas_Lobby-Lounge_034-300x200.jpg 300w, https://mollieaspen.com/wp-content/uploads/2023/12/Mollie_Common-Areas_Lobby-Lounge_034-1024x683.jpg 1024w, https://mollieaspen.com/wp-content/uploads/2023/12/Mollie_Common-Areas_Lobby-Lounge_034-768x512.jpg 768w, https://mollieaspen.com/wp-content/uploads/2023/12/Mollie_Common-Areas_Lobby-Lounge_034-1536x1024.jpg 1536w" sizes="(max-width: 1900px) 100vw, 1900px" />    </div>
    <script>
        function isMobileDevice() {
            return /Mobi|Android/i.test(navigator.userAgent);
        }

        var player = videojs('mollie-video');

        // Disable default pause on click
        player.on('click', function(event) {
        event.preventDefault();
        });

        document.addEventListener('DOMContentLoaded', function() {
            if (isMobileDevice()) {
            // Hide the video player
            document.getElementById('mollie-video').style.display = 'none';
            // Show the background image
            document.getElementById('background-image').style.display = 'block';
        }
  });
