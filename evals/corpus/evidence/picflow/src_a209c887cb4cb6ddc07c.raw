idth="16" height="16" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M3.93353 5.93451C4.24595 5.62209 4.75248 5.62209 5.0649 5.93451L7.99922 8.86882L10.9335 5.93451C11.246 5.62209 11.7525 5.62209 12.0649 5.93451C12.3773 6.24693 12.3773 6.75346 12.0649 7.06588L8.5649 10.5659C8.25249 10.8783 7.74595 10.8783 7.43353 10.5659L3.93353 7.06588C3.62111 6.75346 3.62111 6.24693 3.93353 5.93451Z" fill="currentColor"></path></svg></div></div><div data-testid="toc-body" class="jsx-27f84a20f81f6ce9 hidden my-2"><section data-testid="toc-section-0" class="jsx-27f84a20f81f6ce9 flex border-y-0 border-e-0 border-s-2 border-solid py-1.5 max-lg:border-none border-body-toc-active-border px-7"><a id="#h_dcfd7894de" href="#h_dcfd7894de" data-testid="toc-link-0" class="jsx-27f84a20f81f6ce9 w-full no-underline hover:text-body-primary-color max-lg:inline-block max-lg:text-body-primary-color max-lg:hover:text-primary lg:text-base font-toc-active text-body-primary-color"></a></section><section data-testid="toc-section-1" class="jsx-27f84a20f81f6ce9 flex border-y-0 border-e-0 border-s-2 border-solid py-1.5 max-lg:border-none px-4"><a id="#h_01b4e34c37" href="#h_01b4e34c37" data-testid="toc-link-1" class="jsx-27f84a20f81f6ce9 w-full no-underline hover:text-body-primary-color max-lg:inline-block max-lg:text-body-primary-color max-lg:hover:text-primary lg:text-base text-body-toc-inactive-color"></a></section><section data-testid="toc-section-2" class="jsx-27f84a20f81f6ce9 flex border-y-0 border-e-0 border-s-2 border-solid py-1.5 max-lg:border-none px-4"><a id="#h_e54f0e2642" href="#h_e54f0e2642" data-testid="toc-link-2" class="jsx-27f84a20f81f6ce9 w-full no-underline hover:text-body-primary-color max-lg:inline-block max-lg:text-body-primary-color max-lg:hover:text-primary lg:text-base text-body-toc-inactive-color"></a></section><section data-testid="toc-section-3" class="jsx-27f84a20f81f6ce9 flex border-y-0 border-e-0 border-s-2 border-solid py-1.5 max-lg:border-none px-4"><a id="#h_e202a9d670" href="#h_e202a9d670" data-testid="toc-link-3" class="jsx-27f84a20f81f6ce9 w-full no-underline hover:text-body-primary-color max-lg:inline-block max-lg:text-body-primary-color max-lg:hover:text-primary lg:text-base text-body-toc-inactive-color"></a></section><section data-testid="toc-section-4" class="jsx-27f84a20f81f6ce9 flex border-y-0 border-e-0 border-s-2 border-solid py-1.5 max-lg:border-none px-4"><a id="#h_2651924492" href="#h_2651924492" data-testid="toc-link-4" class="jsx-27f84a20f81f6ce9 w-full no-underline hover:text-body-primary-color max-lg:inline-block max-lg:text-body-primary-color max-lg:hover:text-primary lg:text-base text-body-toc-inactive-color"></a></section><section data-testid="toc-section-5" class="jsx-27f84a20f81f6ce9 flex border-y-0 border-e-0 border-s-2 border-solid py-1.5 max-lg:border-none px-4"><a id="#h_8f8f19059e" href="#h_8f8f19059e" data-testid="toc-link-5" class="jsx-27f84a20f81f6ce9 w-full no-underline hover:text-body-primary-color max-lg:inline-block max-lg:text-body-primary-color max-lg:hover:text-primary lg:text-base text-body-toc-inactive-color"></a></section><section data-testid="toc-section-6" class="jsx-27f84a20f81f6ce9 flex border-y-0 border-e-0 border-s-2 border-solid py-1.5 max-lg:border-none px-4"><a id="#h_3e368811ae" href="#h_3e368811ae" data-testid="toc-link-6" class="jsx-27f84a20f81f6ce9 w-full no-underline hover:text-body-primary-color max-lg:inline-block max-lg:text-body-primary-color max-lg:hover:text-primary lg:text-base text-body-toc-inactive-color"></a></section><section data-testid="toc-section-7" class="jsx-27f84a20f81f6ce9 flex border-y-0 border-e-0 border-s-2 border-solid py-1.5 max-lg:border-none px-4"><a id="#h_152016cf3a" href="#h_152016cf3a" data-testid="toc-link-7" class="jsx-27f84a20f81f6ce9 w-full no-underline hover:text-body-primary-color max-lg:inline-block max-lg:text-body-primary-color max-lg:hover:text-primary lg:text-base text-body-toc-inactive-color"></a></section></div></div></div><div class="jsx-7b3ac4f8d5337043 article_body"><article class="jsx-7b3ac4f8d5337043 "><div class="intercom-interblocks-subheading intercom-interblocks-align-left"><h2 id="h_dcfd7894de">The Lightroom Plugin allows you to upload your photos and videos directly from Lightroom Classic to Picflow. Keep your work in sync by managing your media inside Lightroom and simply Publish any updates to Picflow.</h2></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-horizontal-rule"><hr/></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-center"><p>Already installed? Click here: <b><a href="https://help.picflow.com/en/articles/8630456-how-to-use-the-lightroom-plugin">How to Use the Lightroom Plugin</a></b></p></div><div class="intercom-interblocks-horizontal-rule"><hr/></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-heading intercom-interblocks-align-left"><h1 id="h_01b4e34c37">1. Download &amp; Preparation</h1></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Download the latest version of the plugin and move the &quot;<b>Picflow.lrplugin&quot; </b>file to a safe location. We recommend saving it somewhere close to your Lightroom Catalog.</p></div><div class="intercom-interblocks-callout" style="background-color:#feedaf80;border-color:#fbc91633"><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>ℹ️ Make sure the <b>Picflow.lrplugin</b> file won&#x27;t get moved or deleted later!</p></div></div><div class="intercom-interblocks-button intercom-interblocks-align-left"><a href="https://picflow.com/a/settings/integrations" target="_blank" rel="noreferrer nofollow noopener" class="intercom-h2b-button">Download Plugin</a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>  </p></div><div class="intercom-interblocks-heading intercom-interblocks-align-left"><h1 id="h_e54f0e2642">2. Installing the Plug-in</h1></div><div class="intercom-interblocks-image intercom-interblocks-align-left"><a href="https://downloads.intercomcdn.com/i/o/892388044/5602953fa829ad9e9801d120/image.png?expires=1790291700&amp;signature=d92def6e1abd166771a4d870de7ead954b288a382b6b1c66735dfdbca3bd1a3c&amp;req=fCklFcF2nYVbFb4f3HP0gK79rfSUEz8fK%2BECG7Cw%2F9NVi%2BGhj30zjQG2rR7k%0A5DO0ZP42yI%2FV8NHTMw%3D%3D%0A" target="_blank" rel="noreferrer nofollow noopener"><img src="https://downloads.intercomcdn.com/i/o/892388044/5602953fa829ad9e9801d120/image.png?expires=1790291700&amp;signature=d92def6e1abd166771a4d870de7ead954b288a382b6b1c66735dfdbca3bd1a3c&amp;req=fCklFcF2nYVbFb4f3HP0gK79rfSUEz8fK%2BECG7Cw%2F9NVi%2BGhj30zjQG2rR7k%0A5DO0ZP42yI%2FV8NHTMw%3D%3D%0A" alt="Open file menu in Lightroom with the highlighted &quot;Plug-in Manager&quot; highlighted." width="1280" height="640"/></a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>To install the plugin we need to launch the Plug-in Manager. To do this, open <b>Lightroom Classic</b> and then select &quot;<b>File → Plug-in Manager...&quot;</b>.</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-image intercom-interblocks-align-left"><a href="https://downloads.intercomcdn.com/i/o/892388299/27e735c96020eb43dc73d368/image.png?expires=1790291700&amp;signature=becdc619e01c9b9dc8c95f6df3e7c282983dd5c394e3a2cfe7b8be30a216c4d2&amp;req=fCklFcF2n4hWFb4f3HP0gPlqnDzSRdd883VXz6m7dzMRkXsAgKqm%2FqB7bFV8%0A%2BF%2B%2B9ALfNj8apJCyvA%3D%3D%0A" target="_blank" rel="noreferrer nofollow noopener"><img src="https://downloads.intercomcdn.com/i/o/892388299/27e735c96020eb43dc73d368/image.png?expires=1790291700&amp;signature=becdc619e01c9b9dc8c95f6df3e7c282983dd5c394e3a2cfe7b8be30a216c4d2&amp;req=fCklFcF2n4hWFb4f3HP0gPlqnDzSRdd883VXz6m7dzMRkXsAgKqm%2FqB7bFV8%0A%2BF%2B%2B9ALfNj8apJCyvA%3D%3D%0A" alt="Highlighted &quot;Add&quot; option in the Lightroom Plug-in Manager." width="1280" height="640"/></a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Click <b>&quot;Add&quot;</b> on the bottom left of the Plug-in Manager and select the &quot;<b>Picflow.lrplugin&quot; </b>file in the location you saved it. Click &quot;<b>Done&quot;</b> to complete the installation.</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-heading intercom-interblocks-align-left"><h1 id="h_e202a9d670">3. Plug-in Setup &amp; Connection</h1></div><div class="intercom-interblocks-image intercom-interblocks-align-left"><a href="https://downloads.intercomcdn.com/i/o/892395618/bf59d5c626c1e4ced04078c3/image.png?expires=1790291700&amp;signature=ea1174f61fa1663755950c339155f9333cab0ff481541842775a9d7a4b0dff80&amp;req=fCklFcB7m4BXFb4f3HP0gP6Dwb53tjGMzfkY7LdEosnY65Su%2BcaogiSW75Q%2B%0A9ykPJHKPMkzBnHBShQ%3D%3D%0A" target="_blank" rel="noreferrer nofollow noopener"><img src="https://downloads.intercomcdn.com/i/o/892395618/bf59d5c626c1e4ced04078c3/image.png?expires=1790291700&amp;signature=ea1174f61fa1663755950c339155f9333cab0ff481541842775a9d7a4b0dff80&amp;req=fCklFcB7m4BXFb4f3HP0gP6Dwb53tjGMzfkY7LdEosnY65Su%2BcaogiSW75Q%2B%0A9ykPJHKPMkzBnHBShQ%3D%3D%0A" alt="Highlighted Publish Services in Lightroom with the mouse pointing at &quot;Set up...&quot;" width="1280" height="640"/></a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>In your Lightroom Classic Library, there should be a new Publish Service called &quot;Picflow&quot;. Click the <b>&quot;Set Up...&quot;</b> button to open the Publishing Manager.</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-image intercom-interblocks-align-left"><a href="https://downloads.intercomcdn.com/i/o/893866797/ccc41fbb98e2756031b92c6b/image.png?expires=1790291700&amp;signature=65edf77e1df603a34d6146c9b0eac0ac65a7f2256aef8b37431113bc40a9c358&amp;req=fCkkHs94mohYFb4f3HP0gGgELOyRy1gPPmoC5eSMan37XAWIDXiKEhvB7oJM%0AOJa50j3GEIpUPco2eQ%3D%3D%0A" target="_blank" rel="noreferrer nofollow noopener"><img src="https://downloads.intercomcdn.com/i/o/893866797/ccc41fbb98e2756031b92c6b/image.png?expires=1790291700&amp;signature=65edf77e1df603a34d6146c9b0eac0ac65a7f2256aef8b37431113bc40a9c358&amp;req=fCkkHs94mohYFb4f3HP0gGgELOyRy1gPPmoC5eSMan37XAWIDXiKEhvB7oJM%0AOJa50j3GEIpUPco2eQ%3D%3D%0A" alt="Lightroom Publish Manager with the &quot;Authorize Picflow&quot; button highlighted" width="1280" height="640"/></a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>In the Publishing Manager, click the <b>&quot;Authorize&quot;</b> button. This will open your browser and ask you to log in to Picflow, if you&#x27;re not logged in already.</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-image intercom-interblocks-align-left"><a href="https://downloads.intercomcdn.com/i/o/892401961/6ae1348bdd19c700431ac2f4/image.png?expires=1790291700&amp;signature=d18c2976e758aad8503c4ff95b2cc553e40e23e5c19008c245e252a77c8ba078&amp;req=fCklEsl%2FlIdeFb4f3HP0gAfO1yw36a6Rtvgvcnk%2FYQ9EQ5Wb6FmQWgG5a%2BMq%0AVVRttpBvznHbV4p4zw%3D%3D%0A" target="_blank" rel="noreferrer nofollow noopener"><img src="https://downloads.intercomcdn.com/i/o/892401961/6ae1348bdd19c700431ac2f4/image.png?expires=1790291700&amp;signature=d18c2976e758aad8503c4ff95b2cc553e40e23e5c19008c245e252a77c8ba078&amp;req=fCklEsl%2FlIdeFb4f3HP0gAfO1yw36a6Rtvgvcnk%2FYQ9EQ5Wb6FmQWgG5a%2BMq%0AVVRttpBvznHbV4p4zw%3D%3D%0A" alt="Picflow Integration UI with the &quot;Connect Lightroom&quot; button highlighted." width="1280" height="640"/></a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Select the workspace you want to connect and click &quot;<b>Connect Lightroom</b>&quot;. You will be taken back to Lightroom. Press <b>&quot;Ok&quot;</b> in the popup to confirm the connection. Finally, press <b>&quot;Save&quot;</b> to finish the setup and close the Publishing Manager.</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-heading intercom-interblocks-align-left"><h1 id="h_2651924492">4. You&#x27;re Done!</h1></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>The Lightroom Plug-in is now successfully installed and you can create galleries within Lightroom and upload your media to Picflow. To learn more about this, visit:</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p><b><a href="https://help.picflow.com/en/articles/8630456-how-to-use-the-lightroom-plugin">How to Upload Media from Lightroom</a></b></p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-horizontal-rule"><hr/></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-heading intercom-interblocks-align-left"><h1 id="h_8f8f19059e">Updating the Lightroom Plugin</h1></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>We regularly release new versions of the plugin to improve reliability, fix bugs, and add new features. Please make sure you use the latest version:</p></div><div class="intercom-interblocks-ordered-nested-list"><ol><li><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Download the latest version from our <a href="https://picflow.com/a/settings/integrations" target="_blank" rel="nofollow noopener noreferrer">Integrations Page</a>.</p></div></li><li><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Replace the old &quot;<b>Picflow.lrplugin&quot;</b> file with the new one.</p></div></li><li><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Restart Lightroom Classic.</p></div></li></ol></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-horizontal-rule"><hr/></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-heading intercom-interblocks-align-left"><h1 id="h_3e368811ae">Plugin Settings</h1></div><div class="intercom-interblocks-image intercom-interblocks-align-left"><a href="https://downloads.intercomcdn.com/i/o/892535116/be2d07bcc93134cd11b6a88c/image.png?expires=1790291700&amp;signature=50e7dd8229c6a4efcf1874389e2d99c0e8a7ae416c9dade6ca30279ef322b9a8&amp;req=fCklE8p7nIBZFb4f3HP0gOjbiqBd85W5xTFoySmRIn4ckGFg%2BjAaU2m1Y%2F8m%0AXah8Mk%2BHhcv18fYVeQ%3D%3D%0A" target="_blank" rel="noreferrer nofollow noopener"><img src="https://downloads.intercomcdn.com/i/o/892535116/be2d07bcc93134cd11b6a88c/image.png?expires=1790291700&amp;signature=50e7dd8229c6a4efcf1874389e2d99c0e8a7ae416c9dade6ca30279ef322b9a8&amp;req=fCklE8p7nIBZFb4f3HP0gOjbiqBd85W5xTFoySmRIn4ckGFg%2BjAaU2m1Y%2F8m%0AXah8Mk%2BHhcv18fYVeQ%3D%3D%0A" alt="Lightroom Publish Manager UI with different Picflow Settings." width="1280" height="640"/></a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>You can always update the plug-in settings by right-clicking on the Picflow Publish Services and choose &quot;<b>Edit Settings&quot;</b>. There are a couple of settings that you can configure in the Lightroom Plugin:</p></div><div class="intercom-interblocks-unordered-nested-list"><ul><li><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p><b>File Settings</b><br/>Define the output quality or limit the maximum file size.</p></div></li><li><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p><b>Image Sizing</b><br/>Choose from various resizing options before exporting images to Picflow.</p></div></li><li><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p><b>Output Sharpening</b><br/>You can enable sharpening options on your images.</p></div></li><li><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p><b>Metadata</b><br/>Include or exclude certain metadata before exporting to Picflow.</p></div></li></ul></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-horizontal-rule"><hr/></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-heading intercom-interblocks-align-left"><h1 id="h_152016cf3a">Multi-Workspace Setup</h1></div><div class="intercom-interblocks-image intercom-interblocks-align-left"><a href="https://downloads.intercomcdn.com/i/o/892540700/b741a139b02f08c2b6ab9951/image.png?expires=1790291700&amp;signature=711eb2506815ab6517dba44842aa6a4c2f26b2d33fc0e6ac32cf88a30568a9d0&amp;req=fCklE81%2BmoFfFb4f3HP0gCsPbHUVWDDqdYIfaMNc95cBC%2BAMCBLCa9ImF0wM%0ACfGX2d8OxgPH3MaUdg%3D%3D%0A" target="_blank" rel="noreferrer nofollow noopener"><img src="https://downloads.intercomcdn.com/i/o/892540700/b741a139b02f08c2b6ab9951/image.png?expires=1790291700&amp;signature=711eb2506815ab6517dba44842aa6a4c2f26b2d33fc0e6ac32cf88a30568a9d0&amp;req=fCklE81%2BmoFfFb4f3HP0gCsPbHUVWDDqdYIfaMNc95cBC%2BAMCBLCa9ImF0wM%0ACfGX2d8OxgPH3MaUdg%3D%3D%0A" alt="Publish Services dropdown with the option highlighted to create another Picflow connection." width="1280" height="640"/></a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>The Lightroom Plugin supports connections to multiple Picflow workspaces. To connect to a new workspace, simply &quot;<b>Right-Click&quot;</b> on an existing Picflow connection and then choose <b>&quot;Create Another Publish Service via &quot;Picflow&quot;...&quot;</b>. You then have to go through the authorization steps again, where you can choose your new workspace.</p></div><div class="intercom-interblocks-callout" style="background-color:#feedaf80;border-color:#fbc91633"><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p><b>Note: </b><i>You can&#x27;t reconnect to another workspace. To switch to a different workspace, add a new connection and remove the old one.</i></p></div></div><div class="intercom-interblocks-horizontal-rule"><hr/></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-center"><p> <b>Questions or suggestions? Get in touch!</b></p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-button intercom-interblocks-align-center"><a href="mailto:help@picflow.com" target="_blank" rel="noreferrer nofollow noopener" class="intercom-h2b-button">Contact us</a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><section class="jsx-62724fba150252e0 related_articles my-6"><hr class="jsx-62724fba150252e0 my-6 sm:my-8"/><div class="jsx-62724fba150252e0 mb-3 text-xl font-bold">Related Articles</div><section class="flex flex-col rounded-card border border-solid border-card-border bg-card-bg p-2 sm:p-3"><ul role="list" class="!m-0 list-none !p-0"><li class="!m-0 !list-none"><a class="duration-250 group/article flex flex-row justify-between gap-2 py-2 no-underline transition ease-linear hover:bg-primary-alpha-10 hover:text-primary sm:rounded-card-inner sm:py-3 rounded-card-inner px-3" href="https://help.picflow.com/en/articles/7260633-invite-members" data-testid="article-link"><div class="flex flex-col p-0"><span class="m-0 text-md text-body-primary-color group-hover/article:text-primary">Invit