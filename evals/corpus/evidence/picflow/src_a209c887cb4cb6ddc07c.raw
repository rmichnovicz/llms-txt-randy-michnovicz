atic.intercomassets.com/ember/@intercom/composer-ember/placeholder_circle_upload-134b4324e0ef3d2d4ebbdfc71b7d7672.svg\" width=\"70\" alt=\"\"\u003e    \u003cimg src=\"https://static.intercomassets.com/ember/@intercom/composer-ember/placeholder_circle_upload-134b4324e0ef3d2d4ebbdfc71b7d7672.svg\" width=\"70\" alt=\"\"\u003e    \u003cimg src=\"https://static.intercomassets.com/ember/@intercom/composer-ember/placeholder_circle_upload-134b4324e0ef3d2d4ebbdfc71b7d7672.svg\" width=\"70\" alt=\"\"\u003e","align":"center","class":"no-margin"}],"consentBannerConfig":null,"canInjectCustomScripts":false,"showTableOfContents":true,"showArticleDescriptions":false,"scriptSection":1,"customScriptFilesExist":false},"localeLinks":[{"id":"en","absoluteUrl":"https://help.picflow.com/en/articles/8587606-lightroom-plugin-installation-guide","available":true,"hreflang":"en","name":"English","selected":true,"url":"/en/articles/8587606-lightroom-plugin-installation-guide"}],"requestContext":{"articleSource":null,"academy":false,"canonicalUrl":"https://help.picflow.com/en/articles/8587606-lightroom-plugin-installation-guide","experience":"legacy","headerless":false,"isDefaultDomainRequest":false,"nonce":"iIXrEzO66noQATmzkwG6b9omLR0nN_L4bKWk13ISW3A","rootUrl":"/en/","sheetUserCipher":null,"type":"help-center"},"theme":{"color":"4353FF","siteName":"Picflow Knowledge Base","headline":"Welcome to our Knowledge Base","headerFontColor":"ffffff","logo":"https://downloads.intercomcdn.com/i/o/545514/63eb5a0b2195eb733a6d8fee/17937d6c6b788e304939dc04a3aa91c8","logoHeight":"800","header":"https://downloads.intercomcdn.com/i/o/333310/528c7c7bb8d35e77d3fc7950/d81eb104a102eaba2b4ab969ea04ac8e.png","favicon":"https://intercom.help/picflow/assets/favicon","locale":"en","homeUrl":"https://picflow.com","social":"https://downloads.intercomcdn.com/i/o/333311/db89be57d1ce16bc4921a592/deef86657adfaf4c9b46e43ae8e8593e.png","urlPrefixForDefaultDomain":"https://intercom.help/picflow","customDomain":"help.picflow.com","customDomainUsesSsl":true,"customizationOptions":{"customizationType":1,"header":{"backgroundColor":"#4353FF","fontColor":"#ffffff","fadeToEdge":false,"backgroundGradient":null,"backgroundImageId":null,"backgroundImageUrl":null},"body":{"backgroundColor":"#ffffff","fontColor":null,"fadeToEdge":null,"backgroundGradient":null,"backgroundImageId":null},"footer":{"backgroundColor":"#ffffff","fontColor":"#909aa5","fadeToEdge":null,"backgroundGradient":null,"backgroundImageId":null,"showRichTextField":false},"layout":{"homePage":{"blocks":[{"type":"tickets-portal-link","enabled":false},{"type":"collection-list","columns":3,"template":0},{"type":"article-list","columns":2,"enabled":false,"localizedContent":[{"title":"","locale":"en","links":[{"articleId":"empty_article_slot","type":"article-link"},{"articleId":"empty_article_slot","type":"article-link"},{"articleId":"empty_article_slot","type":"article-link"},{"articleId":"empty_article_slot","type":"article-link"},{"articleId":"empty_article_slot","type":"article-link"},{"articleId":"empty_article_slot","type":"article-link"}]}]},{"type":"content-block","enabled":false,"columns":1}]},"collectionsPage":{"showArticleDescriptions":false},"articlePage":{},"searchPage":{}},"collectionCard":{"global":{"backgroundColor":null,"fontColor":"4353FF","fadeToEdge":null,"backgroundGradient":null,"backgroundImageId":null,"showIcons":true,"backgroundImageUrl":null},"collections":[]},"global":{"font":{"customFontFaces":[],"primary":"System Default","secondary":"System Default"},"componentStyle":{"card":{"type":"bordered","borderRadius":16}},"namedComponents":{"header":{"subheader":{"enabled":false,"style":{"backgroundColor":"#000000","fontColor":"#FFFFFF"}},"style":{"height":"245px","align":"center","justify":"end"}},"searchBar":{"style":{"width":"640px","borderRadius":16}},"footer":{"type":0}},"brand":{"colors":[],"websiteUrl":""},"secondaryColor":null,"accentRoles":{"link":"primary","button":"primary"},"showDotTexture":true,"heroBrandView":false,"showCopyForLlm":true,"copyForLlmItems":null},"contentBlock":{"blockStyle":{"backgroundColor":"#ffffff","fontColor":"#1a1a1a","fadeToEdge":null,"backgroundGradient":null,"backgroundImageId":null,"backgroundImageUrl":null},"buttonOptions":{"backgroundColor":"#334BFA","fontColor":"#ffffff","borderRadius":6},"isFullWidth":false,"align":"center"}},"helpCenterName":"Picflow Knowledge Base","footerLogo":null,"footerLogoHeight":null,"localisedInformation":{"contentBlock":{"locale":"en","title":"Content section title","withButton":false,"description":"","buttonTitle":"Button title","buttonUrl":""}}},"articleContent":{"articleId":"8587606","author":null,"blocks":[{"type":"subheading","text":"The Lightroom Plugin allows you to upload your photos and videos directly from Lightroom Classic to Picflow. Keep your work in sync by managing your media inside Lightroom and simply Publish any updates to Picflow.","idAttribute":"h_dcfd7894de"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"horizontalRule","text":"___________________________________________________________"},{"type":"paragraph","text":"Already installed? Click here: \u003cb\u003e\u003ca href=\"https://help.picflow.com/en/articles/8630456-how-to-use-the-lightroom-plugin\"\u003eHow to Use the Lightroom Plugin\u003c/a\u003e\u003c/b\u003e","align":"center","class":"no-margin"},{"type":"horizontalRule","text":"___________________________________________________________"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"heading","text":"1. Download \u0026amp; Preparation","idAttribute":"h_01b4e34c37"},{"type":"paragraph","text":"Download the latest version of the plugin and move the \"\u003cb\u003ePicflow.lrplugin\" \u003c/b\u003efile to a safe location. We recommend saving it somewhere close to your Lightroom Catalog.","class":"no-margin"},{"type":"callout","content":[{"type":"paragraph","text":"ℹ️ Make sure the \u003cb\u003ePicflow.lrplugin\u003c/b\u003e file won't get moved or deleted later!","class":"no-margin"}],"style":{"backgroundColor":"#feedaf80","borderColor":"#fbc91633"}},{"type":"button","text":"Download Plugin","linkUrl":"https://picflow.com/a/settings/integrations","buttonStyle":"solid"},{"type":"paragraph","text":"  ","class":"no-margin"},{"type":"heading","text":"2. Installing the Plug-in","idAttribute":"h_e54f0e2642"},{"type":"image","url":"https://downloads.intercomcdn.com/i/o/892388044/5602953fa829ad9e9801d120/image.png?expires=1790291700\u0026signature=d92def6e1abd166771a4d870de7ead954b288a382b6b1c66735dfdbca3bd1a3c\u0026req=fCklFcF2nYVbFb4f3HP0gK79rfSUEz8fK%2BECG7Cw%2F9NVi%2BGhj30zjQG2rR7k%0A5DO0ZP42yI%2FV8NHTMw%3D%3D%0A","width":1280,"height":640,"text":"Open file menu in Lightroom with the highlighted \"Plug-in Manager\" highlighted."},{"type":"paragraph","text":"To install the plugin we need to launch the Plug-in Manager. To do this, open \u003cb\u003eLightroom Classic\u003c/b\u003e and then select \"\u003cb\u003eFile → Plug-in Manager...\"\u003c/b\u003e.","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"image","url":"https://downloads.intercomcdn.com/i/o/892388299/27e735c96020eb43dc73d368/image.png?expires=1790291700\u0026signature=becdc619e01c9b9dc8c95f6df3e7c282983dd5c394e3a2cfe7b8be30a216c4d2\u0026req=fCklFcF2n4hWFb4f3HP0gPlqnDzSRdd883VXz6m7dzMRkXsAgKqm%2FqB7bFV8%0A%2BF%2B%2B9ALfNj8apJCyvA%3D%3D%0A","width":1280,"height":640,"text":"Highlighted \"Add\" option in the Lightroom Plug-in Manager."},{"type":"paragraph","text":"Click \u003cb\u003e\"Add\"\u003c/b\u003e on the bottom left of the Plug-in Manager and select the \"\u003cb\u003ePicflow.lrplugin\" \u003c/b\u003efile in the location you saved it. Click \"\u003cb\u003eDone\"\u003c/b\u003e to complete the installation.","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"heading","text":"3. Plug-in Setup \u0026amp; Connection","idAttribute":"h_e202a9d670"},{"type":"image","url":"https://downloads.intercomcdn.com/i/o/892395618/bf59d5c626c1e4ced04078c3/image.png?expires=1790291700\u0026signature=ea1174f61fa1663755950c339155f9333cab0ff481541842775a9d7a4b0dff80\u0026req=fCklFcB7m4BXFb4f3HP0gP6Dwb53tjGMzfkY7LdEosnY65Su%2BcaogiSW75Q%2B%0A9ykPJHKPMkzBnHBShQ%3D%3D%0A","width":1280,"height":640,"text":"Highlighted Publish Services in Lightroom with the mouse pointing at \"Set up...\""},{"type":"paragraph","text":"In your Lightroom Classic Library, there should be a new Publish Service called \"Picflow\". Click the \u003cb\u003e\"Set Up...\"\u003c/b\u003e button to open the Publishing Manager.","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"image","url":"https://downloads.intercomcdn.com/i/o/893866797/ccc41fbb98e2756031b92c6b/image.png?expires=1790291700\u0026signature=65edf77e1df603a34d6146c9b0eac0ac65a7f2256aef8b37431113bc40a9c358\u0026req=fCkkHs94mohYFb4f3HP0gGgELOyRy1gPPmoC5eSMan37XAWIDXiKEhvB7oJM%0AOJa50j3GEIpUPco2eQ%3D%3D%0A","width":1280,"height":640,"text":"Lightroom Publish Manager with the \"Authorize Picflow\" button highlighted"},{"type":"paragraph","text":"In the Publishing Manager, click the \u003cb\u003e\"Authorize\"\u003c/b\u003e button. This will open your browser and ask you to log in to Picflow, if you're not logged in already.","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"image","url":"https://downloads.intercomcdn.com/i/o/892401961/6ae1348bdd19c700431ac2f4/image.png?expires=1790291700\u0026signature=d18c2976e758aad8503c4ff95b2cc553e40e23e5c19008c245e252a77c8ba078\u0026req=fCklEsl%2FlIdeFb4f3HP0gAfO1yw36a6Rtvgvcnk%2FYQ9EQ5Wb6FmQWgG5a%2BMq%0AVVRttpBvznHbV4p4zw%3D%3D%0A","width":1280,"height":640,"text":"Picflow Integration UI with the \"Connect Lightroom\" button highlighted."},{"type":"paragraph","text":"Select the workspace you want to connect and click \"\u003cb\u003eConnect Lightroom\u003c/b\u003e\". You will be taken back to Lightroom. Press \u003cb\u003e\"Ok\"\u003c/b\u003e in the popup to confirm the connection. Finally, press \u003cb\u003e\"Save\"\u003c/b\u003e to finish the setup and close the Publishing Manager.","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"heading","text":"4. You're Done!","idAttribute":"h_2651924492"},{"type":"paragraph","text":"The Lightroom Plug-in is now successfully installed and you can create galleries within Lightroom and upload your media to Picflow. To learn more about this, visit:","class":"no-margin"},{"type":"paragraph","text":"\u003cb\u003e\u003ca href=\"https://help.picflow.com/en/articles/8630456-how-to-use-the-lightroom-plugin\"\u003eHow to Upload Media from Lightroom\u003c/a\u003e\u003c/b\u003e","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"horizontalRule","text":"___________________________________________________________"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"heading","text":"Updating the Lightroom Plugin","idAttribute":"h_8f8f19059e"},{"type":"paragraph","text":"We regularly release new versions of the plugin to improve reliability, fix bugs, and add new features. Please make sure you use the latest version:","class":"no-margin"},{"type":"orderedNestedList","text":"1. Download the latest version from our \u003ca href=\"https://picflow.com/a/settings/integrations\" target=\"_blank\" rel=\"nofollow noopener noreferrer\"\u003eIntegrations Page\u003c/a\u003e.\n2. Replace the old \"\u003cb\u003ePicflow.lrplugin\"\u003c/b\u003e file with the new one.\n3. Restart Lightroom Classic.","items":[{"content":[{"type":"paragraph","text":"Download the latest version from our \u003ca href=\"https://picflow.com/a/settings/integrations\" target=\"_blank\" rel=\"nofollow noopener noreferrer\"\u003eIntegrations Page\u003c/a\u003e.","class":"no-margin"}]},{"content":[{"type":"paragraph","text":"Replace the old \"\u003cb\u003ePicflow.lrplugin\"\u003c/b\u003e file with the new one.","class":"no-margin"}]},{"content":[{"type":"paragraph","text":"Restart Lightroom Classic.","class":"no-margin"}]}]},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"horizontalRule","text":"___________________________________________________________"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"heading","text":"Plugin Settings","idAttribute":"h_3e368811ae"},{"type":"image","url":"https://downloads.intercomcdn.com/i/o/892535116/be2d07bcc93134cd11b6a88c/image.png?expires=1790291700\u0026signature=50e7dd8229c6a4efcf1874389e2d99c0e8a7ae416c9dade6ca30279ef322b9a8\u0026req=fCklE8p7nIBZFb4f3HP0gOjbiqBd85W5xTFoySmRIn4ckGFg%2BjAaU2m1Y%2F8m%0AXah8Mk%2BHhcv18fYVeQ%3D%3D%0A","width":1280,"height":640,"text":"Lightroom Publish Manager UI with different Picflow Settings."},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":"You can always update the plug-in settings by right-clicking on the Picflow Publish Services and choose \"\u003cb\u003eEdit Settings\"\u003c/b\u003e. There are a couple of settings that you can configure in the Lightroom Plugin:","class":"no-margin"},{"type":"unorderedNestedList","text":"- \u003cb\u003eFile Settings\u003c/b\u003e\u003cbr\u003eDefine the output quality or limit the maximum file size.\n- \u003cb\u003eImage Sizing\u003c/b\u003e\u003cbr\u003eChoose from various resizing options before exporting images to Picflow.\n- \u003cb\u003eOutput Sharpening\u003c/b\u003e\u003cbr\u003eYou can enable sharpening options on your images.\n- \u003cb\u003eMetadata\u003c/b\u003e\u003cbr\u003eInclude or exclude certain metadata before exporting to Picflow.","items":[{"content":[{"type":"paragraph","text":"\u003cb\u003eFile Settings\u003c/b\u003e\u003cbr\u003eDefine the output quality or limit the maximum file size.","class":"no-margin"}]},{"content":[{"type":"paragraph","text":"\u003cb\u003eImage Sizing\u003c/b\u003e\u003cbr\u003eChoose from various resizing options before exporting images to Picflow.","class":"no-margin"}]},{"content":[{"type":"paragraph","text":"\u003cb\u003eOutput Sharpening\u003c/b\u003e\u003cbr\u003eYou can enable sharpening options on your images.","class":"no-margin"}]},{"content":[{"type":"paragraph","text":"\u003cb\u003eMetadata\u003c/b\u003e\u003cbr\u003eInclude or exclude certain metadata before exporting to Picflow.","class":"no-margin"}]}]},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"horizontalRule","text":"___________________________________________________________"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"heading","text":"Multi-Workspace Setup","idAttribute":"h_152016cf3a"},{"type":"image","url":"https://downloads.intercomcdn.com/i/o/892540700/b741a139b02f08c2b6ab9951/image.png?expires=1790291700\u0026signature=711eb2506815ab6517dba44842aa6a4c2f26b2d33fc0e6ac32cf88a30568a9d0\u0026req=fCklE81%2BmoFfFb4f3HP0gCsPbHUVWDDqdYIfaMNc95cBC%2BAMCBLCa9ImF0wM%0ACfGX2d8OxgPH3MaUdg%3D%3D%0A","width":1280,"height":640,"text":"Publish Services dropdown with the option highlighted to create another Picflow connection."},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":"The Lightroom Plugin supports connections to multiple Picflow workspaces. To connect to a new workspace, simply \"\u003cb\u003eRight-Click\"\u003c/b\u003e on an existing Picflow connection and then choose \u003cb\u003e\"Create Another Publish Service via \"Picflow\"...\"\u003c/b\u003e. You then have to go through the authorization steps again, where you can choose your new workspace.","class":"no-margin"},{"type":"callout","content":[{"type":"paragraph","text":"\u003cb\u003eNote: \u003c/b\u003e\u003ci\u003eYou can't reconnect to another workspace. To switch to a different workspace, add a new connection and remove the old one.\u003c/i\u003e","class":"no-margin"}],"style":{"backgroundColor":"#feedaf80","borderColor":"#fbc91633"}},{"type":"horizontalRule","text":"___________________________________________________________"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" \u003cb\u003eQuestions or suggestions? Get in touch!\u003c/b\u003e","align":"center","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"button","text":"Contact us","linkUrl":"mailto:help@picflow.com","buttonStyle":"solid","align":"center"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"}],"collectionId":"16617950","description":"Learn how to download, install and set up the Picflow LRC plugin.","id":"8647529","lastUpdated":"Updated over 10 months ago","lastUpdatedDate":"2025-11-14T12:24:08Z","markdown":null,"relatedArticles":[{"title":"Invite Members","url":"https://help.picflow.com/en/articles/7260633-invite-members"},{"title":"How to Use the Lightroom Plugin","url":"https://help.picflow.com/en/articles/8630456-how-to-use-the-lightroom-plugin"},{"title":"Viewing Selections in Lightroom","url":"https://help.picflow.com/en/articles/9862944-viewing-selections-in-lightroom"},{"title":"Workflow Credits","url":"https://help.picflow.com/en/articles/11593246-workflow-credits"},{"title":"Picflow Desktop App for macOS (Beta)","url":"https://help.picflow.com/en/articles/12818325-picflow-desktop-app-for-macos-beta"}],"targetUserType":"everyone","title":"Lightroom Plugin Installation Guide","showTable