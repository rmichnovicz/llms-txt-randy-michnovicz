ns/minus.svg" class="faded" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg><!----><!----><!----></div><div _ngcontent-picflow-c2860758453 class="table-field feature-result style-text-strong"><!----><app-svg _ngcontent-picflow-c2860758453 src="/assets/icons/minus.svg" class="faded" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg><!----><!----><!----></div><div _ngcontent-picflow-c2860758453 class="table-field feature-result style-text-strong"><!----><!----><div _ngcontent-picflow-c2860758453 class="check-wrapper"><app-svg _ngcontent-picflow-c2860758453 src="/assets/icons/check-tiny.svg" class="list-item-icon" style="mask-image: url(/assets/icons/check-tiny.svg); -webkit-mask-image: url(/assets/icons/check-tiny.svg);" ngh="0"></app-svg></div><!----><!----></div><!----></div><!----></div><!----></div></div></div></div><!----><!----></app-product-comparison-list><!----><ndc-dynamic ngh="0"></ndc-dynamic><app-review-list _nghost-picflow-c3794530452 ngh="19"><app-block-wrapper _ngcontent-picflow-c3794530452 class="section undefined" ngh="3"><div class="mobile-spacing-bottom- mobile-spacing-top- page spacing-bottom-4 spacing-top-4 standard-spacing" style="--max-page-width: 1180px; --max-page-width-mobile: 1180px;"><div _ngcontent-picflow-c3794530452 class="reviews"><div _ngcontent-picflow-c3794530452 class="review"><div _ngcontent-picflow-c3794530452 class="stars"><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><!----></div><div _ngcontent-picflow-c3794530452 class="text style-text-default"><p>Really enjoying Picflow! It's the <mark>best online image management and sharing tool</mark> I've used yet. You guys are doing a wonderful job! </p></div><div _ngcontent-picflow-c3794530452 class="reviewer"><img _ngcontent-picflow-c3794530452 width="40" height="40" loading="lazy" src="https://cdn.picflow.com/web/384x384/c0d8d372f1/justin-vanalstyne.webp/m/80x0/filters:format(webp):quality(85)" alt="Portrait of Justin VanAlstyne"><!----><div _ngcontent-picflow-c3794530452 class="reviewer-info"><div _ngcontent-picflow-c3794530452 class="name style-text-strong">Justin VanAlstyne</div><!----><div _ngcontent-picflow-c3794530452 class="role style-text-muted">Creative Director</div><!----></div></div></div><div _ngcontent-picflow-c3794530452 class="review"><div _ngcontent-picflow-c3794530452 class="stars"><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><!----></div><div _ngcontent-picflow-c3794530452 class="text style-text-default"><p>It’s a seriously awesome tool – I checked out all of them, and <mark>Picflow is literally the best</mark>!</p></div><div _ngcontent-picflow-c3794530452 class="reviewer"><img _ngcontent-picflow-c3794530452 width="40" height="40" loading="lazy" src="https://cdn.picflow.com/web/384x384/4939524c84/dominic-de-souza.webp/m/80x0/filters:format(webp):quality(85)" alt="Portrait of Dominic de Souza"><!----><div _ngcontent-picflow-c3794530452 class="reviewer-info"><div _ngcontent-picflow-c3794530452 class="name style-text-strong">Dominic de Souza</div><!----><div _ngcontent-picflow-c3794530452 class="role style-text-muted">Marketing Director</div><!----></div></div></div><div _ngcontent-picflow-c3794530452 class="review"><div _ngcontent-picflow-c3794530452 class="stars"><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><div _ngcontent-picflow-c3794530452 class="star-filled"></div><!----></div><div _ngcontent-picflow-c3794530452 class="text style-text-default"><p>My <mark>clients love the ease and smooth process</mark> for selecting and approving their images in Picflow.</p></div><div _ngcontent-picflow-c3794530452 class="reviewer"><img _ngcontent-picflow-c3794530452 width="40" height="40" loading="lazy" src="https://cdn.picflow.com/web/384x384/70faa0f84d/rashun-hayez.webp/m/80x0/filters:format(webp):quality(85)" alt="Portrait of Rashun Hayez"><!----><div _ngcontent-picflow-c3794530452 class="reviewer-info"><div _ngcontent-picflow-c3794530452 class="name style-text-strong">Rashun Hayes</div><!----><div _ngcontent-picflow-c3794530452 class="role style-text-muted">Photographer</div><!----></div></div></div><!----></div></div><!----><!----></app-block-wrapper></app-review-list><!----><ndc-dynamic ngh="0"></ndc-dynamic><app-title _nghost-picflow-c877933956 ngh="20"><app-block-wrapper _ngcontent-picflow-c877933956 class="section undefined" ngh="3"><div class="mobile-spacing-bottom- mobile-spacing-top- page spacing-bottom-2 spacing-top-4 standard-spacing" style="--max-page-width: 880px; --max-page-width-mobile: 880px;"><!----><!----><!----><h2 _ngcontent-picflow-c877933956 class="a-d- a-m- a-t- center size-display-sm style-text-strong" id="faq">FAQ</h2><!----></div><!----><!----></app-block-wrapper></app-title><!----><ndc-dynamic ngh="0"></ndc-dynamic><app-faq-list _nghost-picflow-c473108249 ngh="21"><app-block-wrapper _ngcontent-picflow-c473108249 class="section undefined" ngh="3"><div class="mobile-spacing-bottom- mobile-spacing-top- page spacing-bottom-0 spacing-top-0 standard-spacing headless bottomless" style="--max-page-width: 780px; --max-page-width-mobile: 780px;"><!----><div _ngcontent-picflow-c473108249 class="accordion-faqs"><app-faq-list-item _ngcontent-picflow-c473108249 _nghost-picflow-c1146618272 class ngh="0"><button _ngcontent-picflow-c1146618272 aria-expanded="false" aria-controls="faq-4mbvyen7ey" jsaction="click:;" ngb="d0"><span _ngcontent-picflow-c1146618272 class="style-text-strong">What is Picflow?</span><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg></button><div _ngcontent-picflow-c1146618272 role="region" class="toggler-body" style="max-height: 0;" id="faq-4mbvyen7ey"><div _ngcontent-picflow-c1146618272 class="toggler-body-content style-text-default"><div _ngcontent-picflow-c473108249 class="style-text-default"><p>Picflow is the simplest way to share beautiful galleries and collaborate on images and videos. Our visual commenting platform enables professionals and teams to proof and review creatives by leaving contextual feedback.</p></div></div></div></app-faq-list-item><app-faq-list-item _ngcontent-picflow-c473108249 _nghost-picflow-c1146618272 class ngh="0"><button _ngcontent-picflow-c1146618272 aria-expanded="false" aria-controls="faq-19cjo2zvuz" jsaction="click:;" ngb="d0"><span _ngcontent-picflow-c1146618272 class="style-text-strong">Can I cancel or switch at any time?</span><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg></button><div _ngcontent-picflow-c1146618272 role="region" class="toggler-body" style="max-height: 0;" id="faq-19cjo2zvuz"><div _ngcontent-picflow-c1146618272 class="toggler-body-content style-text-default"><div _ngcontent-picflow-c473108249 class="style-text-default"><p>Yes! You can always change your plan in your billing settings. If you cancel, you can still use your plan until the end of your current billing period.</p></div></div></div></app-faq-list-item><app-faq-list-item _ngcontent-picflow-c473108249 _nghost-picflow-c1146618272 class ngh="0"><button _ngcontent-picflow-c1146618272 aria-expanded="false" aria-controls="faq-6ld0xvsvzj" jsaction="click:;" ngb="d0"><span _ngcontent-picflow-c1146618272 class="style-text-strong">Does Picflow have any time-limits or trials?</span><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg></button><div _ngcontent-picflow-c1146618272 role="region" class="toggler-body" style="max-height: 0;" id="faq-6ld0xvsvzj"><div _ngcontent-picflow-c1146618272 class="toggler-body-content style-text-default"><div _ngcontent-picflow-c473108249 class="style-text-default"><p>Our free plan has no time limit, so you can use Picflow for as long as you need before deciding to upgrade. Paid plans include a 7-day free trial so you can test the full power of Picflow. We can also extend the trial period for you upon request.</p></div></div></div></app-faq-list-item><app-faq-list-item _ngcontent-picflow-c473108249 _nghost-picflow-c1146618272 class ngh="0"><button _ngcontent-picflow-c1146618272 aria-expanded="false" aria-controls="faq-6qyqx1lfc0" jsaction="click:;" ngb="d0"><span _ngcontent-picflow-c1146618272 class="style-text-strong">Can I upload unlimited assets?</span><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg></button><div _ngcontent-picflow-c1146618272 role="region" class="toggler-body" style="max-height: 0;" id="faq-6qyqx1lfc0"><div _ngcontent-picflow-c1146618272 class="toggler-body-content style-text-default"><div _ngcontent-picflow-c473108249 class="style-text-default"><p>You can upload as many images as you want, as long as it doesn't exceed your plan's storage limit. You can check the plans above to see how much storage each one comes with.</p></div></div></div></app-faq-list-item><app-faq-list-item _ngcontent-picflow-c473108249 _nghost-picflow-c1146618272 class ngh="0"><button _ngcontent-picflow-c1146618272 aria-expanded="false" aria-controls="faq-q6cvkja7lg" jsaction="click:;" ngb="d0"><span _ngcontent-picflow-c1146618272 class="style-text-strong">Do reviewers or guests need a license?</span><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg></button><div _ngcontent-picflow-c1146618272 role="region" class="toggler-body" style="max-height: 0;" id="faq-q6cvkja7lg"><div _ngcontent-picflow-c1146618272 class="toggler-body-content style-text-default"><div _ngcontent-picflow-c473108249 class="style-text-default"><p>No. You can have unlimited reviewers on any plan. A user license is only required to create and manage projects. This is ideal for clients, external partners, and third-party agencies.</p></div></div></div></app-faq-list-item><app-faq-list-item _ngcontent-picflow-c473108249 _nghost-picflow-c1146618272 class ngh="0"><button _ngcontent-picflow-c1146618272 aria-expanded="false" aria-controls="faq-41ooig32w1" jsaction="click:;" ngb="d0"><span _ngcontent-picflow-c1146618272 class="style-text-strong">Do you offer discounts?</span><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg><app-svg _ngcontent-picflow-c1146618272 src="/assets/icons/minus.svg" style="mask-image: url(/assets/icons/minus.svg); -webkit-mask-image: url(/assets/icons/minus.svg);" ngh="0"></app-svg></button><div _ngcontent-picflow-c1146618272 role="region" class="toggler-body" style="max-height: 0;" id="faq-41ooig32w1"><div _ngcontent-picflow-c1146618272 class="toggler-body-content style-text-default"><div _ngcontent-picflow-c473108249 class="style-text-default"><p>Yes, we always offer a discount on all annually paid plans, and we also offer special pricing for education and non-profit organizations. </p></div></div></div></app-faq-list-item><!----><!----><!----></div><!----></div><!----><!----></app-block-wrapper></app-faq-list><!----><!----></main><app-pre-footer _nghost-picflow-c3850658612 ngh="23"><aside _ngcontent-picflow-c3850658612 aria-labelledby="pre-footer-heading" class="section pre-footer-section theme-light bg-base"><div _ngcontent-picflow-c3850658612 class="pre-footer-blur"></div><div _ngcontent-picflow-c3850658612 class="pre-footer"><h2 _ngcontent-picflow-c3850658612 id="pre-footer-heading" class="pre-footer-title size-display-md style-text-strong"><!----> Experience Picflow with a Free Trial <!----></h2><div _ngcontent-picflow-c3850658612 class="cta"><a appbutton name="signup-cta" location="pre-footer" color="primary" height="4" spacing="4" size="3" weight="default" shape="round" href="/auth/signup" class="bc-primary bh-4 bs-4 bw-default center-button custom-button shape-round size-3" jsaction="click:;"