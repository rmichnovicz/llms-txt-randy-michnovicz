"}],"iconSize":"small","component":"icon_with_text_list"}],"style":[{"_uid":"071c2609-5404-4ed0-9f07-e4f5f8ca7f10","style":"","component":"block_style","pageWidth":"9col","fullHeight":false,"topSpacing":"2","bottomBorder":"","hideOnMobile":true,"hideOnTablet":false,"bottomSpacing":"4","hideOnDesktop":false,"customPageWidth":"","mobileTopSpacing":"","mobileBottomSpacing":"","noHorizontalPadding":false,"customPageWidthMobile":"","customTemplateCondition":""}],"breakOn":"mobile","component":"two_column","alignLeftBlocks":"center","alignRightBlocks":"center"},{"_uid":"6510f29b-a490-45f3-b6bf-1e490044d732","style":[{"_uid":"dc0f11eb-02f5-45b0-b128-32d39efea35b","style":"","theme":"light","component":"block_style","pageWidth":"12col","topSpacing":"4","bottomBorder":"","hideOnMobile":false,"hideOnTablet":false,"bottomSpacing":"6","hideOnDesktop":false,"customPageWidth":"","mobileTopSpacing":"6","mobileBottomSpacing":"","noHorizontalPadding":false}],"title":"Compare Features","component":"product_comparison_list"},{"_uid":"db7f9f80-e49a-44aa-a447-abac29f4046b","style":[{"_uid":"c228981d-902f-4a4f-a80e-13cd9c4a01af","component":"block_style","pageWidth":"12col","topSpacing":"4","bottomBorder":"","hideOnMobile":false,"hideOnTablet":false,"bottomSpacing":"4","hideOnDesktop":false,"customPageWidth":"","mobileTopSpacing":"","mobileBottomSpacing":"","noHorizontalPadding":false,"customPageWidthMobile":"","customTemplateCondition":""}],"reviews":[{"_uid":"366a450e-1c9a-469e-899a-e83d5b791ff8","review":"fc4ba8be-a5aa-4c3c-85c6-1d91797570bb","component":"review_item"},{"_uid":"f8769e88-5631-4409-ad4f-ee5b85508183","review":"3b680e24-edb0-4627-a72b-ffbe226b40a3","component":"review_item"},{"_uid":"6d9216ea-143e-4234-b7fc-d6b1a26660ee","review":"621f2ec8-1097-4278-b29c-fc815457fffa","component":"review_item"}],"component":"review_list","reviewStyle":"simple"},{"_uid":"cbc19485-4a95-49bb-a765-048349e1b939","style":[{"_uid":"9fa7a15e-0dc7-42c1-89d1-a15477c58af0","component":"block_style","pageWidth":"9col","fullHeight":false,"topSpacing":"4","bottomBorder":"","hideOnMobile":false,"hideOnTablet":false,"bottomSpacing":"2","hideOnDesktop":false,"customPageWidth":"","mobileTopSpacing":"","mobileBottomSpacing":"","noHorizontalPadding":false,"customPageWidthMobile":"","customTemplateCondition":""}],"textSize":"display-sm","component":"title","textStyle":"","titleText":{"type":"doc","content":[{"type":"heading","attrs":{"level":2,"textAlign":"center"},"content":[{"text":"FAQ","type":"text"}]}]},"mobileAlignment":"","tabletAlignment":"","desktopAlignment":""},{"_uid":"86e0c8f1-634c-4a25-b9dd-eb550753000b","faqs":[{"_uid":"de687319-2e88-42c0-ac88-fa362c50285c","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Picflow is the simplest way to share beautiful galleries and collaborate on images and videos. Our visual commenting platform enables professionals and teams to proof and review creatives by leaving contextual feedback.","type":"text"}]}]},"question":"What is Picflow?","component":"faq"},{"_uid":"cf0b3e19-15ab-47ad-b1a1-7f638635702f","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Yes! You can always change your plan in your billing settings. If you cancel, you can still use your plan until the end of your current billing period.","type":"text"}]}]},"question":"Can I cancel or switch at any time?","component":"faq"},{"_uid":"0fab2d49-3591-41d6-a335-c7c3db19fecb","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Our free plan has no time limit, so you can use Picflow for as long as you need before deciding to upgrade. Paid plans include a 7-day free trial so you can test the full power of Picflow. We can also extend the trial period for you upon request.","type":"text"}]}]},"question":"Does Picflow have any time-limits or trials?","component":"faq"},{"_uid":"605a23b7-a67f-419e-ae30-aeaf7cabbb2d","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"You can upload as many images as you want, as long as it doesn't exceed your plan's storage limit. You can check the plans above to see how much storage each one comes with.","type":"text"}]}]},"question":"Can I upload unlimited assets?","component":"faq"},{"_uid":"e516f118-08fa-4f3a-a6ca-2c9118f47396","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"No. You can have unlimited reviewers on any plan. A user license is only required to create and manage projects. This is ideal for clients, external partners, and third-party agencies.","type":"text"}]}]},"question":"Do reviewers or guests need a license?","component":"faq"},{"_uid":"b628c736-8f41-4a6e-aea8-50331251da89","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Yes, we always offer a discount on all annually paid plans, and we also offer special pricing for education and non-profit organizations. ","type":"text"}]}]},"question":"Do you offer discounts?","component":"faq"}],"style":[{"_uid":"860ba44f-fa9c-4d0e-af5d-3051a51f6a2b","style":"","component":"block_style","pageWidth":"8col","topSpacing":"0","bottomBorder":"","hideOnMobile":false,"hideOnTablet":false,"bottomSpacing":"0","hideOnDesktop":false,"mobileTopSpacing":"","mobileBottomSpacing":"","noHorizontalPadding":false}],"faqStyle":"accordion","component":"faq_list","dynamicFrom":""}],"alias":[],"style":"","theme":"light","abTest":"","noIndex":false,"navTheme":"dark","affiliate":"","component":"root","keyVisual":{"id":null,"alt":null,"name":"","focus":"","title":null,"source":null,"filename":"https:\u002F\u002Fpicflow.com\u002Fassets\u002Fsharing\u002Fdefault.jpg","copyright":null,"fieldtype":"asset","meta_data":{},"is_external_url":true},"metaTitle":"Simple Pricing: Create Professional Client Galleries with Picflow","preFooter":[{"cta":[{"_uid":"8800c304-d333-4fd1-9fb0-8c999efdc5bb","link":"\u002Fauth\u002Fsignup","text":"Try Picflow for Free","component":"cta"}],"_uid":"fb2390f5-cf61-4fdb-960d-984a0b43197a","image":{"i