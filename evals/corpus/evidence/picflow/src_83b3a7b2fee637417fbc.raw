/*# sourceMappingURL=faq-list.component-IHC422R7.css.map */</style><script type="application/ld+json" id="json-ld-faq">{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Picflow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Picflow is the simplest way to share beautiful galleries and collaborate on images and videos. Our visual commenting platform enables professionals and teams to proof and review creatives by leaving contextual feedback."
      }
    },
    {
      "@type": "Question",
      "name": "Can I cancel or switch at any time?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! You can always change your plan in your billing settings. If you cancel, you can still use your plan until the end of your current billing period."
      }
    },
    {
      "@type": "Question",
      "name": "Does Picflow have any time-limits or trials?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our free plan has no time limit, so you can use Picflow for as long as you need before deciding to upgrade. Paid plans include a 7-day free trial so you can test the full power of Picflow. We can also extend the trial period for you upon request."
      }
    },
    {
      "@type": "Question",
      "name": "Can I upload unlimited assets?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can upload as many images as you want, as long as it doesn&#039;t exceed your plan&#039;s storage limit. You can check the plans above to see how much storage each one comes with."
      }
    },
    {
      "@type": "Question",
      "name": "Do reviewers or guests need a license?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. You can have unlimited reviewers on any plan. A user license is only required to create and manage projects. This is ideal for clients, external partners, and third-party agencies."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer discounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we always offer a discount on all annually paid plans, and we also offer special pricing for education and non-profit organizations. "
      }
    }
  ]
}</script><style ng-app-id="picflow">[_nghost-picflow-c1146618272]{border-radius:16px;border:1px solid var(--layout-separator);transition:all .2s ease;display:block}[_nghost-picflow-c1146618272]:hover:not(.open){border-color:var(--layout-separator-strong);background-color:var(--layout-surface-secondary)}[_nghost-picflow-c1146618272]:hover:not(.open)   button[_ngcontent-picflow-c1146618272]   app-svg[_ngcontent-picflow-c1146618272]{color:var(--icon-strong)}.open[_nghost-picflow-c1146618272]{border-color:transparent;box-shadow:var(--shadow-small);background-color:var(--layout-surface)}[_nghost-picflow-c1146618272]   button[_ngcontent-picflow-c1146618272]{padding:22px 60px 22px 20px;cursor:pointer;font-size:16px;line-height:1.2;font-weight:700;position:relative;background:transparent;border:none;display:block;width:100%;text-align:left}@media(min-width:600px){[_nghost-picflow-c1146618272]   button[_ngcontent-picflow-c1146618272]{font-size:18px}}[_nghost-picflow-c1146618272]   button[_ngcontent-picflow-c1146618272]   app-svg[_ngcontent-picflow-c1146618272]{position:absolute;right:20px;top:50%;transform:translateY(-50%);transition:all .2s ease,color .2s ease;color:var(--icon-muted)}[_nghost-picflow-c1146618272]   button[_ngcontent-picflow-c1146618272]   app-svg[_ngcontent-picflow-c1146618272]:last-child{transform:translateY(-50%) rotate(90deg)}.open[_nghost-picflow-c1146618272]   button[_ngcontent-picflow-c1146618272]   app-svg[_ngcontent-picflow-c1146618272]{color:var(--icon-strong)}.open[_nghost-picflow-c1146618272]   button[_ngcontent-picflow-c1146618272]   app-svg[_ngcontent-picflow-c1146618272]:last-child{transform:translateY(-50%) rotate(0)}[_nghost-picflow-c1146618272] > div[_ngcontent-picflow-c1146618272]{overflow:hidden}[_nghost-picflow-c1146618272]   .toggler-body[_ngcontent-picflow-c1146618272]{transition:max-height .2s ease}[_nghost-picflow-c1146618272]   .toggler-body-content[_ngcontent-picflow-c1146618272]{padding:0 20px 30px}
