,55.7833955 C17.776717,54.8729055 17.7214969,53.3414895 18.6319869,52.362882 C19.0208618,51.9449139 19.5449702,51.6778673 20.1116885,51.6089364 L53.7193134,47.5211875 L53.7193134,47.5211875 L67.992321,16.8216207 C68.5558421,15.6095528 69.9952413,15.0838018 71.2073092,15.6473229 C71.7249895,15.8880056 72.1409243,16.3039404 72.381607,16.8216207 L86.6546145,47.5211875 L86.6546145,47.5211875 L120.26224,51.6089364 C121.589122,51.7703273 122.53394,52.9768113 122.372549,54.303694 C122.303618,54.8704122 122.036572,55.3945207 121.618603,55.7833955 L96.8321823,78.8445202 L96.8321823,78.8445202 L103.329829,112.070455 C103.586367,113.382268 102.730897,114.653667 101.419084,114.910204 C100.858802,115.019773 100.277824,114.927755 99.7788223,114.650412 L70.186964,98.2034045 L70.186964,98.2034045 Z"></path></svg><svg viewBox="0 0 140 140" width="24" height="24" class="text-orange-400"><path stroke="currentColor" fill="currentColor" fill-rule="evenodd" d="M70.186964,98.2034045 L40.5951057,114.650412 C39.4267719,115.299767 37.9532448,114.87905 37.3038906,113.710717 C37.0265482,113.211715 36.9345303,112.630737 37.0440987,112.070455 L43.5417457,78.8445202 L43.5417457,78.8445202 L18.7553245,55.7833955 C17.776717,54.8729055 17.7214969,53.3414895 18.6319869,52.362882 C19.0208618,51.9449139 19.5449702,51.6778673 20.1116885,51.6089364 L53.7193134,47.5211875 L53.7193134,47.5211875 L67.992321,16.8216207 C68.5558421,15.6095528 69.9952413,15.0838018 71.2073092,15.6473229 C71.7249895,15.8880056 72.1409243,16.3039404 72.381607,16.8216207 L86.6546145,47.5211875 L86.6546145,47.5211875 L120.26224,51.6089364 C121.589122,51.7703273 122.53394,52.9768113 122.372549,54.303694 C122.303618,54.8704122 122.036572,55.3945207 121.618603,55.7833955 L96.8321823,78.8445202 L96.8321823,78.8445202 L103.329829,112.070455 C103.586367,113.382268 102.730897,114.653667 101.419084,114.910204 C100.858802,115.019773 100.277824,114.927755 99.7788223,114.650412 L70.186964,98.2034045 L70.186964,98.2034045 Z"></path></svg></span></p></div></div><div class="text-left"><div class="h-full rounded-2xl p-6 bg-white border border-gray-200 flex flex-col justify-between"><p class="uppercase pt-6 pb-6"><b>Beams Collective</b></p><div class="pb-4 flex-1 leading-loose mb-4 dynamic-content"><p>You guys rocked! You made it super simple for us to get started and the results look amazing! Thank you to Wendy who gave us valuable advice on all the different options which would best suit our business and brand when it came to our packaging. We were able to reach our launch timeline and had great feedback from our customers!</p>
</div><p class="rounded pb-6"><span class="inline-flex"><svg viewBox="0 0 140 140" width="24" height="24" class="text-orange-400"><path stroke="currentColor" fill="currentColor" fill-rule="evenodd" d="M70.186964,98.2034045 L40.5951057,114.650412 C39.4267719,115.299767 37.9532448,114.87905 37.3038906,113.710717 C37.0265482,113.211715 36.9345303,112.630737 37.0440987,112.070455 L43.5417457,78.8445202 L43.5417457,78.8445202 L18.7553245,55.7833955 C17.776717,54.8729055 17.7214969,53.3414895 18.6319869,52.362882 C19.0208618,51.9449139 19.5449702,51.6778673 20.1116885,51.6089364 L53.7193134,47.5211875 L53.7193134,47.5211875 L67.992321,16.8216207 C68.5558421,15.6095528 69.9952413,15.0838018 71.2073092,15.6473229 C71.7249895,15.8880056 72.1409243,16.3039404 72.381607,16.8216207 L86.6546145,47.5211875 L86.6546145,47.5211875 L120.26224,51.6089364 C121.589122,51.7703273 122.53394,52.9768113 122.372549,54.303694 C122.303618,54.8704122 122.036572,55.3945207 121.618603,55.7833955 L96.8321823,78.8445202 L96.8321823,78.8445202 L103.329829,112.070455 C103.586367,113.382268 102.730897,114.653667 101.419084,114.910204 C100.858802,115.019773 100.277824,114.927755 99.7788223,114.650412 L70.186964,98.2034045 L70.186964,98.2034045 Z"></path></svg><svg viewBox="0 0 140 140" width="24" height="24" class="text-orange-400"><path stroke="currentColor" fill="currentColor" fill-rule="evenodd" d="M70.186964,98.2034045 L40.5951057,114.650412 C39.4267719,115.299767 37.9532448,114.87905 37.3038906,113.710717 C37.0265482,113.211715 36.9345303,112.630737 37.0440987,112.070455 L43.5417457,78.8445202 L43.5417457,78.8445202 L18.7553245,55.7833955 C17.776717,54.8729055 17.7214969,53.3414895 18.6319869,52.362882 C19.0208618,51.9449139 19.5449702,51.6778673 20.1116885,51.6089364 L53.7193134,47.5211875 L53.7193134,47.5211875 L67.992321,16.8216207 C68.5558421,15.6095528 69.9952413,15.0838018 71.2073092,15.6473229 C71.7249895,15.8880056 72.1409243,16.3039404 72.381607,16.8216207 L86.6546145,47.5211875 L86.6546