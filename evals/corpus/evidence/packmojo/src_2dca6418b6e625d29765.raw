gnetic Rigid Boxes","url":"/custom-packaging/magnetic-closure-boxes/"},{"id":9,"name":"Cardboard Tubes","url":"/custom-packaging/cardboard-tubes/"},{"id":4,"name":"Display Boxes","url":"/custom-packaging/display-boxes/"},{"id":6,"name":"Packaging Sleeves","url":"/custom-packaging/packaging-sleeves/"},{"id":7,"name":"Rigid Drawer Boxes","url":"/custom-packaging/rigid-drawer-boxes/"}]},{"id":8,"name":"Samples \u0026 Services","url":"/samples/","type":"default","footerLinks":[],"links":[{"id":37,"name":"Sample Kit","url":"/samples/sample-kit/"},{"id":33,"name":"Custom Samples","url":"/samples/"},{"id":34,"name":"Structural design service","url":"/services/structural-design/"}]},{"id":2,"name":"Resources","url":"/help/","type":"default","footerLinks":[],"links":[{"id":46,"name":"Help \u0026 Support","url":"/help/"},{"id":45,"name":"Packaging purchase guide","url":"/how-to-purchase-packaging/"},{"id":48,"name":"Customer Stories","url":"/showcase/"},{"id":47,"name":"Blog","url":"/blog/"}]},{"id":9,"name":"Company","url":"/about/","type":"default","footerLinks":[],"links":[{"id":42,"name":"Why we exist","url":"/about/"},{"id":43,"name":"Sustainability","url":"/sustainability/"},{"id":44,"name":"Contact us","url":"/contact/"}]},{"id":12,"name":"Getting started","url":"/platform/","type":"default","footerLinks":[],"links":[{"id":50,"name":"Compare products","url":"/compare/"},{"id":51,"name":"Packaging cost estimator","url":"/estimator/"},{"id":52,"name":"Packaging timeline planner","url":"/planner/"}]},{"id":11,"name":"Explore Our Products","url":"/custom-packaging/","type":"cta","footerLinks":[],"links":[]},{"id":10,"name":"Explore PackMojo Platform","url":"/platform/","type":"cta","footerLinks":[],"links":[]}],"seo":{"siteName":"PackMojo","metaTitle":"Custom Mailer Boxes | Printed Mailers \u0026 Logo","metaDescription":"Explore our wide range of custom mailer boxes for your brand. From printed mailer boxes to custom mailer boxes with logo, we've got you covered! Learn more.","metaLocale":"en","ogImage":"https://packmojo.com/cms_assets/talon_esports_custom_mailer_boxes_events_51fc9eeca8.jpeg","ogTitle":"Custom Mailer Boxes | Printed Mailers \u0026 Logo","ogDescription":"Explore our wide range of custom mailer boxes for your brand. From printed mailer boxes to custom mailer boxes with logo, we've got you covered! Learn more.","articlePublishedTime":null,"articleModifiedTime":null,"articleTags":[],"articleAuthor":null,"articleReadingTimeMinutes":null,"twitterCard":"summary_large_image","twitterImage":"https://packmojo.com/cms_assets/talon_esports_custom_mailer_boxes_events_51fc9eeca8.jpeg","twitterTitle":"Custom Mailer Boxes | Printed Mailers \u0026 Logo","twitterDescription":"Explore our wide range of custom mailer boxes for your brand. From printed mailer boxes to custom mailer boxes with logo, we've got you covered! Learn more.","twitterSite":"@packmojo","canonicalBaseUrl":"https://packmojo.com","canonicalUrl":"/custom-packaging/mailer-boxes/","url":"/custom-packaging/mailer-boxes/","absoluteUrl":"https://packmojo.com/custom-packaging/mailer-boxes/","type":"website"},"previewMode":false,"jsonSchema":{"@context":"https://schema.org","@graph":[{"@type":"Product","sku":"mailer-box","mpn":"mailer-box","name":"Mailer Box","url":"https://packmojo.com/custom-packaging/mailer-boxes/","description":"Get custom printed mailer boxes for your brand. Perfect for eCommerce shipping and subscription box packaging. Custom sizes available, MOQ from 100 units.","image":["https://packmojo.com/cms_assets/talon_esports_custom_mailer_boxes_events_51fc9eeca8.jpeg"],"brand":{"@type":"Brand","name":"PackMojo"},"offers":{"@type":"AggregateOffer","url":"https://packmojo.com/custom-packaging/mailer-boxes/","priceCurrency":"USD","lowPrice":"0.28","highPrice":"7.75","offerCount":"1000000","availability":"https://schema.org/InStock","description":"E-Flute or B-Flute corrugated cardboard with white or kraft paper and full color printing.","eligibleQuantity":{"@type":"QuantitativeValue","minValue":"100"},"seller":{"@type":"Organization","name":"PackMojo"}},"aggregateRating":{"@type":"AggregateRating","ratingValue":"5","reviewCount":"20"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5","worstRating":"1"},"author":{"@type":"Person","name":"Daniel"},"datePublished":"2020-05-08","reviewBody":"We care about the look and feel of our products and it is clear from our experience that PackMojo also doesn’t cut any corners; as we received high-quality packaging at an affordable price. Any questions were quickly resolved by customer support and we look forward to continuing to work with PackMojo in the future."}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the minimum order quantity for custom mailer boxes?","acceptedAnswer":{"@type":"Answer","text":"The minimum order quantity for custom mailer boxes is 100 units. This MOQ applies to each unique box variation, meaning any change in size, material, or printed artwork counts as a separate production run of 100 boxes."}},{"@type":"Question","name":"Where is your packaging produced?","acceptedAnswer":{"@type":"Answer","text":"We manufacture all of our packaging through a vetted network of trusted production partners in China, and ship everything directly from the factory to your doorstep."}},{"@type":"Question","name":"What are your lead times?","acceptedAnswer":{"@type":"Answer","text":"Our standard production lead times typically take 12-16 days, though larger bulk orders can take 3-4 weeks depending on the overall volume and complexity of your packaging. Total delivery timelines will vary based on the shipping method you select."}},{"@type":"Question","name":"How long does shipping take?","acceptedAnswer":{"@type":"Answer","text":"Shipping times depend entirely on the transport method you choose for your packaging. Air freight generally takes 1-3 weeks, while ocean freight ranges from 4-8 weeks. If you are on a tight deadline, you can split your shipment to send an initial batch via air and the remainder by sea."}},{"@type":"Question","name":"How does PackMojo support high volume and scaling eCommerce brands?","acceptedAnswer":{"@type":"Answer","text":"Our platform is built to handle the logistics of growing brands seamlessly. While our MOQs vary by product, any brand can configure custom box specs, set up split shipments to multiple locations, and access dedicated account support. For large-scale or recurring monthly orders, you can submit your specifications directly through our platform to receive a tailored, volume-based quote custom to your project."}},{"@type":"Question","name":"Can I purchase a sample before placing an order?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. We offer several different sample types depending on what you need to test. Whether you just want to verify the physical size and fit of your packaging or need to check final colors and printed artwork, we've got you covered. You can explore all of our sample options here."}},{"@type":"Question","name":"Can you provide me with a dieline template?","acceptedAnswer":{"@type":"Answer","text":"Yes, we provide custom dieline templates after you place an order for either a custom sample or a full production run."}},{"@type":"Question","name":"What format should I provide my artwork to you in?","acceptedAnswer":{"@type":"Answer","text":"Please submit your artwork using the custom dieline template we provide, ideally in an editable PDF or Adobe Illustrator (AI) format. To ensure your file is production ready, keep the design on a separate artwork layer and review our dieline design guide before uploading."}}]}]},"page":{"id":778,"navigationTitle":"Mailer Boxes","slug":"mailer-boxes","jsonSchema":{"@context":"https://schema.org","@graph":[{"@type":"Product","sku":"mailer-box","mpn":"mailer-box","name":"Mailer Box","url":"https://packmojo.com/custom-packaging/mailer-boxes/","description":"Get custom printed mailer boxes for your brand. Perfect for eCommerce shipping and subscription box packaging. Custom sizes available, MOQ from 100 units.","image":["https://packmojo.com/cms_assets/talon_esports_custom_mailer_boxes_events_51fc9eeca8.jpeg"],"brand":{"@type":"Brand","name":"PackMojo"},"offers":{"@type":"AggregateOffer","url":"https://packmojo.com/custom-packaging/mailer-boxes/","priceCurrency":"USD","lowPrice":"0.28","highPrice":"7.75","offerCount":"1000000","availability":"https://schema.org/InStock","description":"E-Flute or B-Flute corrugated cardboard with white or kraft paper and full color printing.","eligibleQuantity":{"@type":"QuantitativeValue","minValue":"100"},"seller":{"@type":"Organization","name":"PackMojo"}},"aggregateRating":{"@type":"AggregateRating","ratingValue":"5","reviewCount":"20"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5","worstRating":"1"},"author":{"@type":"Person","name":"Daniel"},"datePublished":"2020-05-08","reviewBody":"We care about the look and feel of our products and it is clear from our experience that PackMojo also doesn’t cut any corners; as we received high-quality packaging at an affordable price. Any questions were quickly resolved by customer support and we look forward to continuing to work with PackMojo in the future."}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the minimum order quantity for custom mailer boxes?","acceptedAnswer":{"@type":"Answer","text":"The minimum order quantity for custom mailer boxes is 100 units. This MOQ applies to each unique box variation, meaning any change in size, material, or printed artwork counts as a separate production run of 100 boxes."}},{"@type":"Question","name":"Where is your packaging produced?","acceptedAnswer":{"@type":"Answer","text":"We manufacture all of our packaging through a vetted network of trusted production partners in China, and ship everything directly from the factory to your doorstep."}},{"@type":"Question","name":"What are your lead times?","acceptedAnswer":{"@type":"Answer","text":"Our standard production lead times typically take 12-16 days, though larger bulk orders can take 3-4 weeks depending on the overall volume and complexity of your packaging. Total delivery timelines will vary based on the shipping method you select."}},{"@type":"Question","name":"How long does shipping take?","acceptedAnswer":{"@type":"Answer","text":"Shipping times depend entirely on the transport method you choose for your packaging. Air freight generally takes 1-3 weeks, while ocean freight ranges from 4-8 weeks. If you are on a tight deadline, you can split your shipment to send an initial batch via air and the remainder by sea."}},{"@type":"Question","name":"How does PackMojo support high volume and scaling eCommerce brands?","acceptedAnswer":{"@type":"Answer","text":"Our platform is built to handle the logistics of growing brands seamlessly. While our MOQs vary by product, any brand can configure custom box specs, set up split shipments to multiple locations, and access dedicated account support. For large-scale or recurring monthly orders, you can submit your specifications directly through our platform to receive a tailored, volume-based quote custom to your project."}},{"@type":"Question","name":"Can I purchase a sample before placing an order?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. We offer several different sample types depending on what you need to test. Whether you just want to verify the physical size and fit of your packaging or need to check final colors and printed artwork, we've got you covered. You can explore all of our sample options here."}},{"@type":"Question","name":"Can you provide me with a dieline template?","acceptedAnswer":{"@type":"Answer","text":"Yes, we provide custom dieline templates after you place an order for either a custom sample or a full production run."}},{"@type":"Question","name":"What format should I provide my artwork to you in?","acceptedAnswer":{"@type":"Answer","text":"Please submit your artwork using the custom dieline template we provide, ideally in an editable PDF or Adobe Illustrator (AI) format. To ensure your file is production ready, keep the design on a separate artwork layer and review our dieline design guide before uploading."}}]}]},"viewPageEventPayload":null,"createdAt":"2021-06-03T06:38:27.000Z","updatedAt":"2026-07-02T07:15:26.564Z","onPageNavigation":"scrollToReveal","locale":"en","parent":{"id":835,"navigationTitle":"Customizable Packaging Solutions","slug":"custom-packaging","jsonSchema":{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://packmojo.com/#organization","name":"PackMojo","url":"https://packmojo.com/","logo":{"@type":"ImageObject","@id":"https://packmojo.com/#logo","url":"https://packmojo.com/cms_assets/Pack_Mojo_logo_default_819f5d5d14.png","width":"3608","height":"800","caption":"PackMojo Logo"}},{"@type":"CollectionPage","@id":"https://packmojo.com/custom-packaging/#webpage","url":"https://packmojo.com/custom-packaging/","name":"Customizable Packaging Boxes | Shop All Types | PackMojo","description":"Explore PackMojo's complete selection of custom packaging options. Customize your own custom mailer boxes, folding carton boxes, rigid boxes, magnetic rigid boxes, rigid drawer boxes, and more to create a premium unboxing experience.","isPartOf":{"@type":"WebSite","@id":"https://packmojo.com/#website","name":"PackMojo","url":"https://packmojo.com/"},"mainEntity":{"@type":"ItemList","numberOfItems":"22","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"WebPage","name":"Mailer Boxes","description":"Corrugated mailer boxes ideal for eCommerce packaging and retail subscription fulfillment.","url":"https://packmojo.com/custom-packaging/mailer-boxes/"}},{"@type":"ListItem","position":2,"item":{"@type":"WebPage","name":"Folding Cartons","description":"Lightweight paperboard product packaging ideal for cosmetics, candles, and smaller retail items.","url":"https://packmojo.com/custom-packaging/folding-carton-boxes/"}},{"@type":"ListItem","position":3,"item":{"@type":"WebPage","name":"Rigid Boxes","description":"Premium two-piece gift setups built from heavy chipboard to provide premium structural defense.","url":"https://packmojo.com/custom-packaging/rigid-boxes/"}},{"@type":"ListItem","position":4,"item":{"@type":"WebPage","name":"Rigid Drawer Boxes","description":"Sophisticated slider packaging featuring a structural protective shell and sliding matchbox drawer tray.","url":"https://packmojo.com/custom-packaging/rigid-drawer-boxes/"}},{"@type":"ListItem","position":5,"item":{"@type":"WebPage","name":"Magnetic Rigid Boxes","description":"Luxury rigid boxes engineered with hidden flip-top magnetic closures for premium presentations.","url":"https://packmojo.com/custom-packaging/magnetic-closure-boxes/"}},{"@type":"ListItem","position":6,"item":{"@type":"WebPage","name":"Custom Box Inserts","description":"Precision molded inner protective structures customized to securely cushion and display specific components.","url":"https://packmojo.com/custom-packaging/custom-box-inserts/"}},{"@type":"ListItem","position":7,"item":{"@type":"WebPage","name":"Custom Foam Inserts","description":"Premium protective foam cushioning layouts precision-cut to safeguard fragile goods and luxury items.","url":"https://packmojo.com/custom-packaging/custom-foam-inserts/"}},{"@type":"ListItem","position":8,"item":{"@type":"WebPage","name":"Molded Pulp Inserts","description":"Biodegradable contoured interior cushioning layers crafted from recycled paper fibers.","url":"https://packmojo.com/custom-packaging/molded-pulp-inserts/"}},{"@type":"ListItem","position":9,"item":{"@type":"WebPage","name":"Custom Box Dividers","description":"Interlocking grid packaging layout structures designed to sort and isolate individual components safely.","url":"https://packmojo.com/custom-packaging/custom-box-dividers/"}},{"@type":"ListItem","position":10,"item":{"@type":"WebPage","name":"Display Boxes","description":"Countertop retail display boxes built to transform from shipping flats into point-of-sale display trays.","url":"https://packmojo.com/custom-packaging/display-boxes/"}},{"@type":"ListItem","position":11,"item":{"@type":"WebPage","name":"Cardboard Tubes","description":"Rigid cylinder canister packaging solutions built for premium protection of bottles, jars, or candles.","url":"https://packmojo.com/custom-packaging/cardboard-tubes/"}},{"@type":"ListItem","position":12,"item":{"@type":"WebPage","name":"Tray and Sleeve Boxes","description":"Two-piece folding structures featuring a foldable base drawer and custom slide-to-reveal branded cover sleeve.","url":"https://packmojo.com/custom-packaging/tray-and-sleeve-boxes/"}},{"@type":"ListItem","position":13,"item":{"@type":"WebPage","name":"Cake Boxes","description":"Lightweight foldable structural containers designed specifically for bakeries and catering handling requirements.","url":"https://packmojo.com/custom-packaging/cake-boxes/"}},{"@type":"ListItem","position":14,"item":{"@type":"WebPage","name":"Pillow Boxes","description":"Unique side-curved pillow-shaped small paperboard carriers with swift push-into-place end flaps.","url":"https://packmojo.com/custom-packaging/pillow-boxes/"}},{"@type":"ListItem","position":15,"item":{"@type":"WebPage","name":"Custom Pouches","description":"Resealable flexible packaging layouts designed for cosmetics, dry food goods, or supplements.","url":"https://packmojo.com/custom-packaging/custom-pouches/"}},{"@type":"ListItem","position":16,"item":{"@type":"WebPage","name":"Foldable Lid and Base Boxes","description":"Two-piece product boxes designed to mimic rigid designs while shipping flat to optimize space logistics.","url":"https://packmojo.com/custom-packaging/foldable-lid-and-base-boxes/"}},{"@type":"ListItem","position":17,"item":{"@type":"WebPage","name":"Packaging Sleeves","description":"Custom printed brand bands designed to wrap around bare products or unprinted baseline boxes seamlessly.","url":"https://packmojo.com/custom-packaging/packaging-sleeves/"}},{"@type":"ListItem","position":18,"item":{"@type":"WebPage","name":"Paper Bags","description":"Custom luxury printed paper shopping bags equipped with options for twisted paper, ribbon, or rope handles.","url":"https://packmojo.com/custom-packaging/paper-bags/"}},{"@type":"ListItem","position":19,"item":{"@type":"WebPage","name":"Stickers \u0026 Labels","description":"High-fidelity custom adhesives designed to execute container closures or accent secondary packaging steps.","url":"https://packmojo.com/custom-packaging/custom-stickers/"}},{"@type":"ListItem","position":20,"item":{"@type":"WebPage","name":"Tissue Paper","description":"Customizable lightweight protective layout sheet inserts designed to elevate high-intent internal presentations.","url":"https://packmojo.com/custom-packaging/tissue-paper/"}},{"@type":"ListItem","position":21,"item":{"@type":"WebPage","name":"Hang Tags","description":"Custom printed brand tags and apparel product labels tailored with unique cutting styles and paper elements.","url":"https://packmojo.com/custom-packaging/hang-tags/"}},{"@type":"ListItem","position":22,"item":{"@type":"WebPage","name":"Custom Playing Cards","description":"Premium printed game playing card decks and customized matching structural tuck-end packaging boxes.","url":"https://packmojo.com/custom-packaging/custom-playing-cards/"}}]}}]},"viewPageEventPayload":null,"createdAt":"2021-05-18T03:48:10.000Z","updatedAt":"2026-09-11T02:57:56.217Z","onPageNavigation":"none","locale":"en"},"meta":{"id":1249,"title":"Custom Mailer Boxes | Printed Mailers \u0026 Logo","description":"Explore our wide range of custom mailer boxes for your brand. From printed mailer boxes to custom mailer boxes with logo, we've got you covered! Learn more.","canonicalUrl":"/custom-packaging/mailer-boxes/"},"twitter":null,"hreflangAlternatives":[{"id":123,"locale":"de","url":"/de/produkte/versandboxen/"}],"og":{"id":1250,"title":"Custom Mailer Boxes | Printed Mailers \u0026 Logo","description":"Explore our wide range of custom mailer boxes for your brand. From printed mailer boxes to custom mailer boxes with logo, we've got you covered! Learn more.","image":{"id":64,"name":"talon-esports-custom-mailer-boxes-events.jpeg","alternativeText":"Talon Esports Mailer Box","caption":"","width":1000,"height":600,"formats":{"thumbnail":{"name":"thumbnail_talon-esports-custom-mailer-boxes-events.jpeg","hash":"thumbnail_talon_esports_custom_mailer_boxes_events_51fc9eeca8","ext":".jpeg","mime":"image/jpeg","width":245,"height":147,"size":5.44,"path":null,"url":"https://packmojo.com/cms_assets/thumbnail_talon_esports_custom_mailer_boxes_events_51fc9eeca8.jpeg"},"medium":{"name":"medium_talon-esports-custom-mailer-boxes-events.jpeg","hash":"medium_talon_esports_custom_mailer_boxes_events_51fc9eeca8","ext":".jpeg","mime":"image/jpeg","width":750,"height":450,"size":36.15,"path":null,"url":"https://packmojo.com/cms_assets/medium_talon_esports_custom_mailer_boxes_events_51fc9eeca8.jpeg"},"small":{"name":"small_talon-esports-custom-mailer-boxes-events.jpeg","hash":"small_talon_esports_custom_mailer_boxes_events_51fc9eeca8","ext":".jpeg","mime":"image/jpeg","width":500,"height":300,"size":18.07,"path":null,"url":"https://packmojo.com/cms_assets/small_talon_esports_custom_mailer_boxes_events_51fc9eeca8.jpeg"}},"hash":"talon_esports_custom_mailer_boxes_events_51fc9eeca8","ext":".jpeg","mime":"image/jpeg","size":37.67,"url":"https://packmojo.com/cms_assets/talon_esports_custom_mailer_boxes_events_51fc9eeca8.jpeg","previewUrl":null,"provider":"aws-s3","provider_metadata":null,"createdAt":"2021-04-14T20:10:08.000Z","updatedAt":"2021-04-14T20:10:08.000Z","focalPoint":null}},"headerSection":{"id":109,"title":"Mailer Boxes","subTitle":"Eco-friendly. Versatile. Low minimums.","textColor":"default","backgroundColor":"white","ctaDescription":"Continue on our platform to customize your packaging, compare products, get samples and much more.","actions":[{"id":2768,"title":"Get started","link":"https://app.packmojo.com/","type":"continue_to_platform_modal_extended","external":false}],"products":[{"id":1,"title":"Standard Mailer Box","description":"Corrugated boxes with cherry locks on the front and dust flaps on the side.","slug":"standard-mailer-box","productId":"mb-s","moqStandard":null,"moqCustom":100,"label":"Most popular","jsonSchema":null,"additionalNotes":"optional","sortOrder":10,"internalUseOnly":false,"priceControl":"A","extendedDescription":"The standard mailer box, also known as an ear lock mailer box, is a versatile option for businesses of all sizes. Made with protective corrugated cardboard and completed with ear locks to ensure a secure closure, they are a suitable option for those looking for a packaging solution that can be shipped directly.\n\nShipped flat and easily assembled for use, they do not require a lot of storage space. They are a versatile, reliable, and cost-effective solution that can be used to ship a wide range of products, making them an excellent starting point for those who are new to custom packaging.","essentials":true,"dimensionSizeTypeOptions":"innerOuter","createdAt":"2021-05-25T04:16:20.000Z","updatedAt":"2025-08-05T06:03:29.103Z","image":{"id":924,"name":"packmojo--mb-s--standard-mailer-box--product-catalogue-01.png","alternativeText":"PackMojo Standard Mailer Box","caption":"","width":1080,"height":1080,"formats":{"thumbnail":{"name":"thumbnail_packmojo--mb-s--standard-mailer-box--product-catalogue-01.png","hash":"thumbnail_packmojo_mb_s_standard_mailer_box_product_catalogue_01_21608f7745","ext":".png","mime":"image/png","width":156,"height":156,"size":23.23,"path":null,"url":"https://packmojo.com/cms_assets/thumbnail_packmojo_mb_s_standard_mailer_box_product_catalogue_01_21608f7745.png"},"large":{"name":"large