png"}},"hash":"packmojo_mb_ad_mailer_box_with_adhesive_sizing_guide_01_7b92b6620b","ext":".png","mime":"image/png","size":245.48,"url":"https://packmojo.com/cms_assets/packmojo_mb_ad_mailer_box_with_adhesive_sizing_guide_01_7b92b6620b.png","previewUrl":null,"provider":"aws-s3","provider_metadata":null,"createdAt":"2023-03-08T13:43:12.000Z","updatedAt":"2023-03-08T13:43:12.000Z","focalPoint":null}},{"id":4,"title":"Mailer Box without Flaps","description":"Corrugated boxes with a lid that tucks inside the box to close and does not include dust flaps on the side.","slug":"mailer-box-without-flaps","productId":"mb-nw","moqStandard":null,"moqCustom":100,"label":"","jsonSchema":null,"additionalNotes":"optional","sortOrder":30,"internalUseOnly":false,"priceControl":"A","extendedDescription":"The mailer box without flaps takes our standard mailer box and simplifies the design of the box. With the tuck top lid, the need for dust flaps and ear locks is eliminated, therefore streamlining the design and making it easy for packing and shipping.\n\nShipped flat and made of the same protective corrugated materials as our other mailer boxes, it makes a great space-saving shipping option that allows you to save on delivery costs. However, with the simplified design, it is better suited for lightweight products that require less protection such as stationary, accessories, or apparel.","essentials":false,"dimensionSizeTypeOptions":"innerOuter","createdAt":"2021-06-11T06:51:27.000Z","updatedAt":"2025-08-05T06:03:57.766Z","image":{"id":942,"name":"packmojo--mb-nw--mailer-box-without-flaps--product-catalogue-01.png","alternativeText":"PackMojo Mailer Box without Flaps","caption":"","width":1080,"height":1080,"formats":{"thumbnail":{"name":"thumbnail_packmojo--mb-nw--mailer-box-without-flaps--product-catalogue-01.png","hash":"thumbnail_packmojo_mb_nw_mailer_box_without_flaps_product_catalogue_01_d867169abb","ext":".png","mime":"image/png","width":156,"height":156,"size":20.97,"path":null,