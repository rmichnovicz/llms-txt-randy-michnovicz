":"https://packmojo.com/cms_assets/medium_packmojo_mb_nw_mailer_box_without_flaps_sizing_guide_01_39d2dd2c2a.png"},"small":{"name":"small_packmojo--mb-nw--mailer-box-without-flaps--sizing-guide-01.png","hash":"small_packmojo_mb_nw_mailer_box_without_flaps_sizing_guide_01_39d2dd2c2a","ext":".png","mime":"image/png","width":500,"height":500,"size":128.17,"path":null,"url":"https://packmojo.com/cms_assets/small_packmojo_mb_nw_mailer_box_without_flaps_sizing_guide_01_39d2dd2c2a.png"}},"hash":"packmojo_mb_nw_mailer_box_without_flaps_sizing_guide_01_39d2dd2c2a","ext":".png","mime":"image/png","size":193.37,"url":"https://packmojo.com/cms_assets/packmojo_mb_nw_mailer_box_without_flaps_sizing_guide_01_39d2dd2c2a.png","previewUrl":null,"provider":"aws-s3","provider_metadata":null,"createdAt":"2023-03-08T13:43:12.000Z","updatedAt":"2023-03-08T13:43:12.000Z","focalPoint":null}},{"id":33,"title":"Mailer Box without Dust Flaps","description":"Corrugated boxes with cherry locks on the front and and no dust flaps on the side.","slug":"mailer-box-without-dust-flaps","productId":"mb-ndf","moqStandard":null,"moqCustom":100,"label":"","jsonSchema":null,"additionalNotes":"optional","sortOrder":20,"internalUseOnly":false,"priceControl":"A","extendedDescription":"The mailer box without dust flaps is made with protective corrugated cardboard, making it a shipping-suitable packaging solution similar to our standard mailer box. The absence of dust flaps allows for efficient packing and more available space in the box, making this box suitable for products that may require more room. \n\nWith ear locks to keep the box securely closed, the mailer box without dust flaps stands to be a reliable, cost-effective shipping and packaging solution for a wide variety of products. Shipped flat, it allows you to also save on storage and delivery costs.","essentials":false,"dimensionSizeTypeOptions":"innerOuter","createdAt":"2021-08-18T08:06:09.000Z","updatedAt":"2025-08-05T06:03:45.871Z","image":{"id":9