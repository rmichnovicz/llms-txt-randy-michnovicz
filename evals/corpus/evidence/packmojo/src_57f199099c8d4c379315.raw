er:title" content="Packaging Samples | Sample Boxes | PackMojo" data-next-head=""/><meta name="twitter:description" content="Get a sample of your packaging before mass production. Explore the different types of packaging samples available and choose one that meets your needs." data-next-head=""/><meta name="twitter:url" content="https://packmojo.com/samples/" data-next-head=""/><meta name="twitter:image" content="https://packmojo.com/cms_assets/packmojo_sample_kit_23b3791d17.jpg" data-next-head=""/><meta name="twitter:site" content="@packmojo" data-next-head=""/><meta name="twitter:label2" content="Filed under" data-next-head=""/><meta name="twitter:data2" content="" data-next-head=""/><link href="https://packmojo.com/samples/" rel="canonical" data-next-head=""/><link rel="alternate" href="https://packmojo.com/samples/" hrefLang="en" data-next-head=""/><link rel="preconnect" href="https://cms.packmojo.com"/><link rel="preload" href="/_next/static/chunks/438_1br1bet8n.css" as="style"/><link rel="preload" href="/_next/static/chunks/37xdr3y8q_kxi.css" as="style"/><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"CollectionPage","@id":"https://packmojo.com/samples/#webpage","url":"https://packmojo.com/samples/","name":"Packaging Samples | Sample Boxes | PackMojo","description":"Explore our range of sampling options and choose a sample type that best meets your needs. Test the size of your packaging, check artwork alignment, or see exact production colors.","isPartOf":{"@type":"WebSite","@id":"https://packmojo.com/#website","name":"PackMojo","url":"https://packmojo.com/"},"mainEntity":{"@type":"ItemList","numberOfItems":"7","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"WebPage","name":"PackMojo Sample Kit","description":"Experience a selection of our most popular boxes and printed packaging solutions to get a feel for our production quality, materials, and finishes.","url":"https://packmojo.com/samples/sample-kit/"}},{"@type":"ListItem","position":2,"item":{"@type":"WebPage","name":"Structural Sample","description":"Blank, unprinted sample with custom size and material. Ideal for verifying size and structure with your physical products.","url":"https://packmojo.com/samples/structural-sample/"}},{"@type":"ListItem","position":3,"item":{"@type":"WebPage","name":"Simplified Sample","description":"Low-fidelity printed sample featuring custom size, material, and CMYK print with digital printers. No finishes or add-ons.","url":"https://packmojo.com/samples/simplified-sample/"}},{"@type":"ListItem","position":4,"item":{"@type":"WebPage","name":"Pre-production Sample","description":"A 1:1 production sample ideal for seeing the exact outcome of your packaging with no limitations on print, finishes, and add-ons.","url":"https://packmojo.com/samples/pre-production-sample/"}},{"@type":"ListItem","position":5,"item":{"@type":"WebPage","name":"Print Proof","description":"Flat color proof in CMYK printed with digital printers on proofing paper. Ideal for checking colors and artwork alignment.","url":"https://packmojo.com/samples/digital-print-proof/"}},{"@type":"ListItem","position":6,"item":{"@type":"WebPage","name":"Press Proof","description":"Flat color proof with finishes and add-ons printed with the actual production print facilities. Ideal for seeing exact colors.","url":"https://packmojo.com/samples/press-proof/"}},{"@type":"ListItem","position":7,"item":{"@type":"WebPage","name":"Pantone Color Chip","description":"Flat Pantone color reference printed on the exact material used in production to preview and confirm colors before a bulk production run.","url":"https://packmojo.com/samples/pantone-color-chip/"}}]}},{"@type":"Organization","@id":"https://packmojo.com/#organization","name":"PackMojo","url":"https://packmojo.com/","logo":{"@type":"ImageObject","@id":"https://packmojo.com/#logo","url":"https://packmojo.com/cms_assets/Pack_Mojo_logo_default_819f5d5d14.png","width":"3608"