  {
    "id": "conflict-undated",
    "kind": "authored-conflict",
    "category": "conflict-resolution",
    "split": "development",
    "description": "Equal-authority undated terms differ. Preserve uncertainty and ask; do not blend them.",
    "input": {
      "siteUrl": "https://parcel.example/",
      "sources": [
        {
          "id": "home",
          "url": "https://parcel.example/",
          "title": "Parcel Shop",
          "description": "",
          "content": "Home delivery is free over €300. No date supplied."
        },
        {
          "id": "policy",
          "url": "https://parcel.example/shipping",
          "title": "Shipping policy",
          "description": "",
          "content": "Home delivery is free over €600. No date supplied."
        }
      ],
      "decisions": [],
      "dismissedTopics": [],
      "mode": "generate",
      "maxQuestions": 2
    },
    "expected": {
      "include": [
        "home",
        "policy"
      ],
      "exclude": [],
      "forbidden": [],
      "documentPattern": "conflict|differ|inconsisten|unconfirm|uncertain|300.*600",
      "forbiddenDocument": [
        "€450"
      ],
      "minQuestions": 1,
      "questionPattern": "threshold|deliver|shipping|300|450|600|750|conflict|instruction|link"
    }
  },
