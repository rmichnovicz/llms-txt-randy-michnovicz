DATABASE_URL=postgresql://brief:brief-local-only@localhost:55432/brief
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174
# Set a private creation key before exposing this development API publicly.
# BRIEF_CREATION_KEY=replace-with-a-random-secret

# Optional: enables automatic generation after successful crawling.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol

# Local HTTP only. Use true with HTTPS in deployment.
BRIEF_SECURE_COOKIES=false

# Single-process demo: worker has its own thread; progress uses memory queues.
# Run one Uvicorn process and do not also start `brief worker` in this mode.
BRIEF_EMBEDDED_WORKER=false
